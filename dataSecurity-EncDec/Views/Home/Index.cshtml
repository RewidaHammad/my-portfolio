@{
    ViewData["Title"] = "Home";
}

<style>
    .hero {
        padding: 80px 2rem 60px;
        text-align: center;
        border-bottom: 1px solid #2d3448;
    }

    .hero-badge {
        display: inline-block;
        background: #0c2a3d;
        color: #38bdf8;
        border: 1px solid #0ea5e9;
        border-radius: 20px;
        font-size: 0.75rem;
        padding: 4px 14px;
        margin-bottom: 24px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .hero h1 {
        font-size: 3rem;
        font-weight: 600;
        color: #f1f5f9;
        line-height: 1.2;
        margin-bottom: 16px;
    }

    .hero h1 em {
        font-style: normal;
        color: #38bdf8;
    }

    .hero p {
        color: #64748b;
        font-size: 1.1rem;
        max-width: 500px;
        margin: 0 auto 36px;
    }

    .hero-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary-lg {
        background: #0ea5e9;
        color: white;
        padding: 12px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        transition: background 0.15s;
    }

    .btn-primary-lg:hover { background: #0284c7; }

    .btn-outline-lg {
        background: transparent;
        color: #94a3b8;
        padding: 12px 28px;
        border-radius: 8px;
        border: 1px solid #2d3448;
        text-decoration: none;
        font-size: 0.95rem;
        transition: all 0.15s;
    }

    .btn-outline-lg:hover { border-color: #38bdf8; color: #38bdf8; }

    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1px;
        background: #2d3448;
        border-top: 1px solid #2d3448;
    }

    .feature-card {
        background: #0f1117;
        padding: 40px 32px;
    }

    .feature-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.2rem;
    }

    .icon-blue  { background: #0c2a3d; color: #38bdf8; }
    .icon-green { background: #052e16; color: #4ade80; }
    .icon-amber { background: #2d1a00; color: #fbbf24; }

    .feature-card h3 {
        font-size: 1rem;
        font-weight: 500;
        color: #e2e8f0;
        margin-bottom: 10px;
    }

    .feature-card p {
        font-size: 0.875rem;
        color: #64748b;
        line-height: 1.6;
    }
</style>

<section class="hero">
    <div class="hero-badge">Secure Authentication System</div>
    <div class="hero-actions">
        @if (Context.Session.GetString("UserEmail") != null)
        {
            <a asp-controller="Crypto" asp-action="Index" class="btn-primary-lg">Open Encrypt / Decrypt</a>
            <a asp-controller="Account" asp-action="ChangePassword" class="btn-outline-lg">Change password</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Register" class="btn-primary-lg">Create account</a>
            <a asp-controller="Account" asp-action="Login" class="btn-outline-lg">Sign in</a>
        }
    </div>
</section>

