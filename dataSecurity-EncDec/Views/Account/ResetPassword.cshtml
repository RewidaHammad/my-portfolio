@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }

<style>
    .auth-wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .auth-box {
        width: 100%;
        max-width: 440px;
        background: #161b27;
        border: 1px solid #2d3448;
        border-radius: 12px;
        padding: 2.5rem;
    }

    .auth-box h2 { font-size: 1.4rem; font-weight: 600; color: #f1f5f9; margin-bottom: 6px; }
    .auth-box .sub { font-size: 0.85rem; color: #64748b; margin-bottom: 2rem; }

    .field { margin-bottom: 1.25rem; }

    .field label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: #94a3b8;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .field input {
        width: 100%;
        background: #0f1117;
        border: 1px solid #2d3448;
        border-radius: 7px;
        padding: 10px 14px;
        color: #e2e8f0;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.15s;
    }

    .field input:focus { border-color: #0ea5e9; }
    .field-error { font-size: 0.78rem; color: #f87171; margin-top: 4px; }

    .captcha-display {
        background: #0f1117;
        border: 1px dashed #334155;
        border-radius: 8px;
        padding: 18px;
        text-align: center;
        font-family: 'Courier New', monospace;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 14px;
        color: #38bdf8;
        margin-bottom: 10px;
        user-select: none;
    }

    .captcha-hint {
        font-size: 0.75rem;
        color: #475569;
        margin-bottom: 8px;
    }

    .error-box {
        background: #2d0a0a;
        border: 1px solid #7f1d1d;
        border-radius: 7px;
        padding: 10px 14px;
        font-size: 0.85rem;
        color: #f87171;
        margin-bottom: 1.25rem;
    }

    .btn-submit {
        width: 100%;
        background: #0ea5e9;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 11px;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-submit:hover { background: #0284c7; }

    .auth-footer { margin-top: 1.5rem; text-align: center; font-size: 0.82rem; }
    .auth-footer a { color: #38bdf8; text-decoration: none; }
</style>

<div class="auth-wrap">
    <div class="auth-box">
        <h2>Reset password</h2>
        <p class="sub">Verify the CAPTCHA code below then enter your new password.</p>

        <form asp-action="ResetPassword" method="post">
            @* <input type="hidden" asp-for="CaptchaCode" /> *@

            <div class="field">
                <label>Email address</label>
                <input asp-for="Email" placeholder="your@email.com" />
                <div class="field-error"><span asp-validation-for="Email"></span></div>
            </div>

            <div class="field">
                <label>CAPTCHA verification</label>
                <div class="captcha-display">@ViewBag.CaptchaCode</div>
                <p class="captcha-hint">Type the code exactly as shown above</p>
                <input asp-for="CaptchaInput" placeholder="Enter CAPTCHA" autocomplete="off" />
                <div class="field-error"><span asp-validation-for="CaptchaInput"></span></div>
            </div>

            <div class="field">
                <label>New password</label>
                <input asp-for="NewPassword" type="password" placeholder="Minimum 6 characters" />
                <div class="field-error"><span asp-validation-for="NewPassword"></span></div>
            </div>

            <div asp-validation-summary="ModelOnly" class="error-box"></div>

            <button type="submit" class="btn-submit">Reset password</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login">Back to sign in</a>
        </div>
    </div>
</div>