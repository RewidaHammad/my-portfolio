@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<style>
    .auth-wrap {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .auth-box {
        width: 100%;
        max-width: 420px;
        background: #161b27;
        border: 1px solid #2d3448;
        border-radius: 12px;
        padding: 2.5rem;
    }

    .auth-box h2 { font-size: 1.4rem; font-weight: 600; color: #f1f5f9; margin-bottom: 6px; }
    .auth-box .sub { font-size: 0.85rem; color: #64748b; margin-bottom: 2rem; }

    .field { margin-bottom: 1.25rem; }

    .field label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: #94a3b8;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .field input {
        width: 100%;
        background: #0f1117;
        border: 1px solid #2d3448;
        border-radius: 7px;
        padding: 10px 14px;
        color: #e2e8f0;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.15s;
    }

    .field input:focus { border-color: #0ea5e9; }
    .field-error { font-size: 0.78rem; color: #f87171; margin-top: 4px; }

    .error-box {
        background: #2d0a0a;
        border: 1px solid #7f1d1d;
        border-radius: 7px;
        padding: 10px 14px;
        font-size: 0.85rem;
        color: #f87171;
        margin-bottom: 1.25rem;
    }

    .btn-submit {
        width: 100%;
        background: #0ea5e9;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 11px;
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-submit:hover { background: #0284c7; }
</style>

<div class="auth-wrap">
    <div class="auth-box">
        <h2>Change password</h2>
        <p class="sub">Enter your current password to set a new one.</p>

        <form asp-action="ChangePassword" method="post">
            <div class="field">
                <label>Current password</label>
                <input asp-for="CurrentPassword" type="password" placeholder="Your current password" />
                <div class="field-error"><span asp-validation-for="CurrentPassword"></span></div>
            </div>
            <div class="field">
                <label>New password</label>
                <input asp-for="NewPassword" type="password" placeholder="Minimum 6 characters" />
                <div class="field-error"><span asp-validation-for="NewPassword"></span></div>
            </div>

            <div asp-validation-summary="ModelOnly" class="error-box"></div>

            <button type="submit" class="btn-submit">Update password</button>
        </form>
    </div>
</div>