
@using Scalaverse.Entitys.Models
@model IEnumerable<Project>
@{
    ViewData["Title"] = "My Projects";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-soft: rgba(124,58,237,0.07);
        --white: #FFFFFF;
        --off: #F8F9FB;
        --border: #E5E7EB;
        --border-2: #F0F0F4;
        --text: #0D0F1A;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --green-dark: #065F46;
        --amber: #B45309;
        --amber-bg: #FFFBEB;
        --amber-dark: #92400E;
        --blue: #1D4ED8;
        --blue-bg: #EFF6FF;
        --red: #DC2626;
        --red-bg: #FEF2F2;
        --red-dark: #991B1B;
        --f: 'Geist', system-ui, sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 12px;
        --radius-sm: 8px;
        --shadow: 0 1px 2px rgba(0,0,0,0.05), 0 4px 16px rgba(0,0,0,0.04);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.09);
    }

    .pw * {
        font-family: var(--f);
        box-sizing: border-box;
    }

    /* ── Hero ── */
    .proj-hero {
        background: linear-gradient(140deg, #080C18 0%, #130D2E 55%, #0A1628 100%);
        border-radius: var(--radius);
        padding: 32px 38px;
        margin-bottom: 22px;
        position: relative;
        overflow: hidden;
        animation: up 0.45s var(--ease) both;
    }

    .ph-orb-1 {
        position: absolute;
        pointer-events: none;
        top: -90px;
        right: -70px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(124,58,237,0.18) 0%, transparent 65%);
    }

    .ph-orb-2 {
        position: absolute;
        pointer-events: none;
        bottom: -60px;
        left: 30%;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(29,78,216,0.10) 0%, transparent 65%);
    }

    .ph-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: 44px 44px;
    }

    .ph-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .ph-label {
        font-size: 0.63rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--purple-4);
        margin-bottom: 8px;
    }

    .ph-title {
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin-bottom: 6px;
        background: linear-gradient(90deg, #fff, #C4B5FD);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .ph-sub {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.38);
        font-weight: 400;
    }

    .ph-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .hbtn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.18s var(--ease);
        border: 1px solid transparent;
        font-family: var(--f);
    }

        .hbtn i {
            font-size: 13px;
        }

    Shahd, [5/9/2026 8:49 AM]
    .hbtn-primary {
        background: var(--purple);
        color: #fff;
        border-color: var(--purple);
        box-shadow: 0 4px 16px rgba(124,58,237,0.35);
    }

    .hbtn-primary:hover {
        background: var(--purple-2);
        color: #fff;
        transform: translateY(-1px);
    }

    .hbtn-ghost {
        background: rgba(255,255,255,0.07);
        color: rgba(255,255,255,0.75);
        border-color: rgba(255,255,255,0.12);
    }

        .hbtn-ghost:hover {
            background: rgba(255,255,255,0.13);
            color: #fff;
        }

    /* ── Projects Grid ── */
    .proj-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 14px;
    }

    /* ── Project Card ── */
    .pcard {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.22s var(--ease);
        animation: up 0.45s var(--ease) both;
    }

        .pcard:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: #C4B5FD;
        }

    /* Color bar */
    .pcard-bar {
        height: 3px;
    }

    .bar-active {
        background: linear-gradient(90deg, #059669, #34D399);
    }

    .bar-completed {
        background: linear-gradient(90deg, #7C3AED, #A78BFA);
    }

    .bar-onhold {
        background: linear-gradient(90deg, #B45309, #FCD34D);
    }

    .bar-cancelled {
        background: linear-gradient(90deg, #DC2626, #F87171);
    }

    .bar-default {
        background: linear-gradient(90deg, #9CA3AF, #D1D5DB);
    }

    .pcard-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* Head */
    .pcard-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
    }

    .pcard-name {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin: 0;
    }

    .pcard-cat {
        font-size: 0.72rem;
        color: var(--muted);
        margin-top: 3px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .pcard-cat i {
            font-size: 11px;
            color: var(--purple-3);
        }

    .badges-col {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

    /* Badges */
    .bdg {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.68rem;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .bdg-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .bdg-active {
        background: var(--green-bg);
        color: var(--green-dark);
    }

        .bdg-active .bdg-dot {
            background: var(--green);
        }

    .bdg-completed {
        background: var(--purple-soft);
        color: #5B21B6;
    }

        .bdg-completed .bdg-dot {
            background: var(--purple);
        }

    .bdg-onhold {
        background: var(--amber-bg);
        color: var(--amber-dark);
    }

        .bdg-onhold .bdg-dot {
            background: #D97706;
        }

    .bdg-cancelled {
        background: var(--red-bg);
        color: var(--red-dark);
    }

        .bdg-cancelled .bdg-dot {
            background: var(--red);
        }

    .bdg-default {
        background: #F3F4F6;
        color: var(--muted);
    }

        .bdg-default .bdg-dot {
            background: #9CA3AF;
        }

    Shahd, [5/9/2026 8:49 AM]
    .bdg-priority {
        background: var(--red-bg);
        color: var(--red-dark);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.65rem;
        font-weight: 700;
    }

    /* Progress */
    .prog-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .prog-label {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--muted);
    }

    .prog-pct {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--purple);
    }

    .prog-track {
        height: 5px;
        background: #F0EEFF;
        border-radius: 99px;
        overflow: hidden;
    }

    .prog-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--purple), var(--purple-3));
        transition: width 0.8s var(--ease);
    }

    /* Provider */
    .provider-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 9px;
        background: var(--off);
        border: 1px solid var(--border-2);
    }

    .prov-avatar {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 800;
        color: #fff;
    }

    .prov-av-team {
        background: linear-gradient(135deg, var(--purple), var(--purple-3));
    }

    .prov-av-company {
        background: linear-gradient(135deg, var(--blue), #60A5FA);
    }

    .prov-name {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-2);
    }

    .prov-role {
        font-size: 0.7rem;
        color: var(--muted);
    }

    /* Stats */
    .pcard-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 6px;
    }

    .mini-stat {
        background: var(--off);
        border: 1px solid var(--border-2);
        border-radius: 8px;
        padding: 8px 6px;
        text-align: center;
    }

        .mini-stat i {
            font-size: 13px;
            display: block;
            margin-bottom: 3px;
        }

    .mini-stat-val {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
    }

    .mini-stat-lbl {
        font-size: 0.6rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 2px;
    }

    /* Dates */
    .pcard-dates {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .date-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .date-lbl {
        font-size: 0.72rem;
        color: var(--muted);
    }

    .date-val {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-2);
    }

    /* Footer */
    .pcard-foot {
        padding: 12px 20px;
        border-top: 1px solid var(--border-2);
    }

    .vbtn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 9px;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--purple);
        background: var(--purple-soft);
        border: 1px solid rgba(124,58,237,0.15);
        transition: all 0.15s;
        font-family: var(--f);
    }

        .vbtn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    /* Empty */
    .empty-state {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 64px 20px;
        text-align: center;
        box-shadow: var(--shadow);
        animation: up 0.45s var(--ease) 0.1s both;
    }

   
    .empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 18px;
        background: var(--purple-soft);
        border: 1px solid rgba(124,58,237,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
    }

    .empty-icon i {
        font-size: 30px;
        color: var(--purple-3);
    }

    .empty-state h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 7px;
    }

    .empty-state p {
        font-size: 0.84rem;
        color: var(--muted);
        margin: 0 0 22px;
    }

    @@keyframes up {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1024px) {
        .proj-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }
    }

    @@media (max-width: 640px) {
        .proj-grid {
            grid-template-columns: 1fr;
        }

        .proj-hero {
            padding: 24px 20px;
        }

        .ph-title {
            font-size: 1.5rem;
        }
    }
</style>

<div class="pw">

    <!-- Hero -->
    <div class="proj-hero">
        <div class="ph-orb-1"></div>
        <div class="ph-orb-2"></div>
        <div class="ph-grid"></div>
        <div class="ph-inner">
            <div>
                <div class="ph-label">Projects</div>
                <div class="ph-title">My Projects</div>
                <div class="ph-sub">Manage and track all your projects in one place</div>
            </div>
            <div class="ph-actions">
                <a href="@Url.Action("Index", "TeamRooms", new { area = "TeamRooms" })" class="hbtn hbtn-primary">
                    <i class="bi bi-plus-circle-fill"></i> Start New Project
                </a>
                <a href="@Url.Action("Index", "ClientDashboard", new { area = "Identity" })" class="hbtn hbtn-ghost">
                    <i class="bi bi-grid-fill"></i> Dashboard
                </a>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="proj-grid">
            @{
                int i = 0;
            }
            @foreach (var project in Model)
            {
                i++;
                var completedMilestones = project.Milestones?.Count(m => m.Status == "Approved") ?? 0;
                var totalMilestones = project.Milestones?.Count ?? 0;
                var daysLeft = project.EstimatedEndDate.HasValue
                ? Math.Max(0, (project.EstimatedEndDate.Value - DateTime.UtcNow).Days)
                : (int?)null;

                var barCls = project.Status switch
                {
                    "Active" => "bar-active",
                    "Completed" => "bar-completed",
                    "OnHold" => "bar-onhold",
                    "Cancelled" => "bar-cancelled",
                    _ => "bar-default"
                };
                var bdgCls = project.Status switch
                {
                    "Active" => "bdg-active",
                    "Completed" => "bdg-completed",
                    "OnHold" => "bdg-onhold",
                    "Cancelled" => "bdg-cancelled",
                    _ => "bdg-default"
                };

                <div class="pcard" style="animation-delay:@(i * 0.05)s">
                    <div class="pcard-bar @barCls"></div>
                    <div class="pcard-body">

                        
                        <!-- Head -->
                        <div class="pcard-head">
                            <div>
                                <div class="pcard-name">@project.ProjectName</div>
                                @if (!string.IsNullOrEmpty(project.Category))
                                {
                                    <div class="pcard-cat"><i class="bi bi-tag"></i> @project.Category</div>
                                }
                            </div>
                            <div class="badges-col">
                                <span class="bdg @bdgCls"><span class="bdg-dot"></span> @project.Status</span>
                                @if (project.Priority == "High" || project.Priority == "Urgent")
                                {
                                    <span class="bdg-priority"><i class="bi bi-exclamation-circle-fill"></i> @project.Priority</span>
                                }
                            </div>
                        </div>

                        <!-- Progress -->
                        <div>
                            <div class="prog-top">
                                <span class="prog-label">Progress</span>
                                <span class="prog-pct">@project.ProgressPercentage%</span>
                            </div>
                            <div class="prog-track">
                                <div class="prog-fill" style="width:@project.ProgressPercentage%"></div>
                            </div>
                        </div>

                        <!-- Provider -->
                        @if (project.TeamRoom != null)
                        {
                            <div class="provider-row">
                                <div class="prov-avatar prov-av-team">@project.TeamRoom.TeamName.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <div class="prov-name">@project.TeamRoom.TeamName</div>
                                    <div class="prov-role">@project.TeamRoom.TeamLeader.User.FullName</div>
                                </div>
                            </div>
                        }
                        else if (project.Company != null)
                        {
                            <div class="provider-row">
                                <div class="prov-avatar prov-av-company">@project.Company.CompanyName.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <div class="prov-name">@project.Company.CompanyName</div>
                                    <div class="prov-role">Registered Company</div>
                                </div>
                            </div>
                        }

                        <!-- Stats -->
                        <div class="pcard-stats">
                            <div class="mini-stat">
                                <i class="bi bi-currency-dollar" style="color:var(--green)"></i>
                                <div class="mini-stat-val">$@project.Budget.ToString("N0")</div>
                                <div class="mini-stat-lbl">Budget</div>
                            </div>
                            <div class="mini-stat">
                                <i class="bi bi-flag-fill" style="color:var(--purple)"></i>
                                <div class="mini-stat-val">@completedMilestones/@totalMilestones</div>
                                <div class="mini-stat-lbl">Milestones</div>
                            </div>
                            <div class="mini-stat">
                                <i class="bi bi-calendar3" style="color:var(--amber)"></i>
                                <div class="mini-stat-val">@(daysLeft.HasValue? daysLeft.Value.ToString() : "—")</div>
                                <div class="mini-stat-lbl">Days Left</div>
                            </div>
                        </div>

                        <!-- Dates -->
                        <div class="pcard-dates">
                            <div class="date-row">
                                <span class="date-lbl">Started</span>
                                <span class="date-val">@project.StartDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            @if (project.EstimatedEndDate.HasValue)
                            {
                                <div class="date-row">
                                    <span class="date-lbl">Due</span>
                                    <span class="date-val">@project.EstimatedEndDate.Value.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="pcard-foot">
                        <a href="@Url.Action("Details", new { id = project.ProjectId })" class="vbtn">
                            <i class="bi bi-eye"></i> View Project
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-folder-x"></i></div>
            <h3>No projects yet</h3>
            <p>Start your first project by browsing available teams</p>
            <a href="@Url.Action("Index", "TeamRooms", new { area = "TeamRooms" })" class="hbtn hbtn-primary" style="display:inline-flex">
                <i class="bi bi-plus-circle-fill"></i> Browse Teams
            </a>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.prog-fill').forEach(b => {
            const w = b.style.width;
            b.style.width = '0';
            setTimeout(() => { b.style.width = w; }, 150);
        });
    </script>
}