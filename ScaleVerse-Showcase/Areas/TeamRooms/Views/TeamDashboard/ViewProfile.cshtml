
@model ScalaVerse.ViewModel.TeamLeader_Dashboard_VM.TeamLeaderProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    :root {
      --navy:#0A0E1A;--purple:#7C3AED;--purple-2:#6D28D9;--purple-3:#8B5CF6;
      --purple-4:#A78BFA;--purple-5:#EDE9FE;--white:#FFFFFF;--off:#F9FAFB;
      --border:#E5E7EB;--border-2:#F3F4F6;--text:#0F172A;--text-2:#374151;
      --muted:#6B7280;--green:#059669;--green-bg:#ECFDF5;--red:#DC2626;--red-bg:#FEF2F2;
      --f-display:'Plus Jakarta Sans',sans-serif;--f-body:'Inter',sans-serif;
      --ease:cubic-bezier(0.16,1,0.3,1);--radius:12px;--radius-lg:16px;
      --shadow:0 1px 3px rgba(0,0,0,0.07),0 4px 12px rgba(0,0,0,0.04);
    }
    *{box-sizing:border-box;margin:0;padding:0;}

    .vp-hero {
      background:var(--navy);border-radius:var(--radius-lg);
      padding:28px 32px;margin-bottom:20px;position:relative;overflow:hidden;
    }
    .vp-hero::before {
      content:'';position:absolute;inset:0;pointer-events:none;
      background:radial-gradient(ellipse 70% 80% at 100% 0%,rgba(124,58,237,0.18) 0%,transparent 60%);
    }
    .vp-hero-grid {
      position:absolute;inset:0;pointer-events:none;
      background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);
      background-size:44px 44px;
    }
    .vp-hero-inner {position:relative;z-index:2;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}
    .vp-av {
      width:68px;height:68px;border-radius:16px;flex-shrink:0;
      background:linear-gradient(135deg,var(--purple),var(--purple-3));
      display:flex;align-items:center;justify-content:center;
      font-family:var(--f-display);font-size:1.6rem;font-weight:800;color:#fff;
      box-shadow:0 4px 16px rgba(124,58,237,0.4);
    }
    .vp-name {font-family:var(--f-display);font-size:1.5rem;font-weight:800;color:#fff;letter-spacing:-0.03em;margin-bottom:4px;}
    .vp-role {font-size:0.82rem;color:rgba(255,255,255,0.45);margin-bottom:8px;}
    .badge-verified {display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;font-weight:700;color:#34D399;background:rgba(5,150,105,0.15);border:1px solid rgba(5,150,105,0.25);padding:3px 10px;border-radius:100px;}
    .badge-pending  {display:inline-flex;align-items:center;gap:4px;font-size:0.68rem;font-weight:700;color:#FCD34D;background:rgba(217,119,6,0.15);border:1px solid rgba(217,119,6,0.25);padding:3px 10px;border-radius:100px;}
    .vp-actions {margin-left:auto;display:flex;gap:8px;flex-shrink:0;}
    .btn-p {display:inline-flex;align-items:center;gap:7px;font-family:var(--f-body);font-size:0.82rem;font-weight:600;padding:9px 18px;border-radius:10px;text-decoration:none;transition:all 0.2s var(--ease);border:1px solid transparent;cursor:pointer;}
    .btn-primary {background:var(--purple);color:#fff;box-shadow:0 4px 12px rgba(124,58,237,0.35);}
    .btn-primary:hover {background:var(--purple-2);transform:translateY(-1px);color:#fff;}
    .btn-ghost {background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border-color:rgba(255,255,255,0.12);}
    .btn-ghost:hover {background:rgba(255,255,255,0.14);color:#fff;}

    .vp-grid {display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    .vp-full {grid-column:1/-1;}

    .vp-card {background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow);overflow:hidden;margin-bottom:16px;}
    .vp-card:last-child {margin-bottom:0;}
    .vp-card-head {display:flex;align-items:center;gap:8px;padding:14px 20px;border-bottom:1px solid var(--border-2);font-family:var(--f-display);font-size:0.88rem;font-weight:700;color:var(--text);}
    .vp-card-head i {color:var(--purple);font-size:15px;}
    .vp-card-body {padding:20px;}

    .info-row {display:flex;align-items:flex-start;gap:16px;padding:11px 0;border-bottom:1px solid var(--border-2);}
    .info-row:first-child {padding-top:0;}
    .info-row:last-child {border-bottom:none;padding-bottom:0;}
    .info-label {font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted);min-width:140px;padding-top:2px;flex-shrink:0;}
    .info-val {font-size:0.88rem;color:var(--text-2);font-weight:500;flex:1;line-height:1.5;}
    .info-val a {color:var(--purple);text-decoration:none;}
    .info-val a:hover {text-decoration:underline;}

    .success-banner {display:flex;align-items:center;gap:10px;background:var(--green-bg);border:1px solid rgba(5,150,105,0.2);border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:0.85rem;font-weight:600;color:var(--green);}

    @@media (max-width:900px) {
      .vp-grid {grid-template-columns:1fr;}
      .vp-full {grid-column:1;}
      .vp-actions {margin-left:0;width:100%;}
      .btn-p {flex:1;justify-content:center;}
      .vp-hero {padding:20px;}
    }
    @@media (max-width:600px) {
      .info-row {flex-direction:column;gap:4px;}
      .info-label {min-width:auto;}
      .vp-name {font-size:1.2rem;}
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-banner"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
}

<!-- Hero -->
<div class="vp-hero">
    <div class="vp-hero-grid"></div>
    <div class="vp-hero-inner">
        <div class="vp-av">@(Model.FullName?.Substring(0, 1).ToUpper() ?? "T")</div>
        <div style="flex:1;min-width:0">
            <div class="vp-name">@Model.FullName</div>
            <div class="vp-role">Team Leader · @Model.YearsOfExperience years experience</div>
            @if (Model.IsVerified)
            {
                <span class="badge-verified"><i class="bi bi-patch-check-fill"></i> Verified</span>
            }
            else
            {

                <span class="badge-pending"><i class="bi bi-clock-fill"></i> Pending Verification</span>
            }
        </div>
        <div class="vp-actions">
            <a href="@Url.Action("EditProfile")" class="btn-p btn-primary"><i class="bi bi-pencil-square"></i> Edit Profile</a>
            <a href="@Url.Action("Index")" class="btn-p btn-ghost"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
    </div>
</div>

<!-- Cards Grid -->
<div class="vp-grid">

    <!-- Personal Info -->
    <div class="vp-card">
        <div class="vp-card-head"><i class="bi bi-person-fill"></i> Personal Information</div>
        <div class="vp-card-body">
            <div class="info-row">
                <div class="info-label">Full Name</div>
                <div class="info-val">@Model.FullName</div>
            </div>
            <div class="info-row">
                <div class="info-label">Email</div>
                <div class="info-val">@Model.Email</div>
            </div>
            <div class="info-row">
                <div class="info-label">Phone</div>
                <div class="info-val">@(Model.PhoneNumber ?? "Not provided")</div>
            </div>
            <div class="info-row">
                <div class="info-label">Status</div>
                <div class="info-val">
                    @if (Model.IsVerified)
                    {
                        <span class="badge-verified"><i class="bi bi-patch-check-fill"></i> Verified</span>
                    }
                    else
                    {

                        <span class="badge-pending"><i class="bi bi-clock-fill"></i> Pending</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Professional Info -->
    <div class="vp-card">
        <div class="vp-card-head"><i class="bi bi-briefcase-fill"></i> Professional Information</div>
        <div class="vp-card-body">
            <div class="info-row">
                <div class="info-label">Experience</div>
                <div class="info-val">@Model.YearsOfExperience years</div>
            </div>
            <div class="info-row">
                <div class="info-label">Expertise</div>
                <div class="info-val">@(Model.ExpertiseAreas ?? "Not provided")</div>
            </div>
            <div class="info-row">
                <div class="info-label">Portfolio</div>
                <div class="info-val">
                    @if (!string.IsNullOrEmpty(Model.PortfolioUrl))
                    {
                        <a href="@Model.PortfolioUrl" target="_blank"><i class="bi bi-link-45deg"></i> @Model.PortfolioUrl</a>
                    }
                    else
                    {

                        <span>Not provided</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bio -->
    <div class="vp-card vp-full">
        <div class="vp-card-head"><i class="bi bi-file-person-fill"></i> Bio</div>
        <div class="vp-card-body">
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p style="font-size:0.88rem;color:var(--text-2);line-height:1.7;">@Model.Bio</p>
            }
            else
            {

                <p style="font-size:0.85rem;color:var(--muted);font-style:italic;">No bio provided yet. <a href="@Url.Action("EditProfile")" style="color:var(--purple)">Add one now →</a></p>
            }
        </div>
    </div>

</div>
