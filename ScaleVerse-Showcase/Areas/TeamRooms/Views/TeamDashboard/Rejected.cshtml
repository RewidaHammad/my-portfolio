

@model Scalaverse.Entitys.Models.TeamLeader
@{
    ViewData["Title"] = "Registration Status";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var daysUntilReapply = Model.ReapplicationAllowedDate.HasValue
        ? (Model.ReapplicationAllowedDate.Value - DateTime.UtcNow).Days
        : -1;
    var canReapply = Model.ReapplicationAllowedDate.HasValue && daysUntilReapply <= 0;
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-5: #EDE9FE;
        --white: #FFFFFF;
        --off: #F9FAFB;
        --border: #E5E7EB;
        --border-2: #F3F4F6;
        --text: #0F172A;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --red: #DC2626;
        --red-bg: #FEF2F2;
        --f-display: 'Plus Jakarta Sans',sans-serif;
        --f-body: 'Inter',sans-serif;
        --ease: cubic-bezier(0.16,1,0.3,1);
        --radius: 12px;
        --radius-lg: 16px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07),0 4px 12px rgba(0,0,0,0.04);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .rs-wrap {
        max-width: 680px;
        margin: 0 auto;
    }

    /* Status Hero */
    .rs-hero {
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .rs-hero.rejected {
            background: linear-gradient(135deg,#1a0a0a,#2d0f0f);
        }

        .rs-hero.can-reapply {
            background: linear-gradient(135deg,#0a1a0f,#0f2d1a);
        }

        .rs-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(ellipse 60% 80% at 100% 0%,rgba(220,38,38,0.15) 0%,transparent 60%);
        }

        .rs-hero.can-reapply::before {
            background: radial-gradient(ellipse 60% 80% at 100% 0%,rgba(5,150,105,0.15) 0%,transparent 60%);
        }

    .rs-hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .rs-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

        .rs-icon.red {
            background: rgba(220,38,38,0.15);
            color: #FCA5A5;
        }

        .rs-icon.green {
            background: rgba(5,150,105,0.15);
            color: #6EE7B7;
        }

    .rs-hero-title {
        font-family: var(--f-display);
        font-size: 1.3rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
        margin-bottom: 4px;
    }

    .rs-hero-sub {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.45);
    }

    /* Cards */
    .rs-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 16px;
    }

        .rs-card:last-child {
            margin-bottom: 0;
        }

    .rs-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border-2);
        font-family: var(--f-display);
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
    }

        .rs-card-head i {
            font-size: 15px;
        }

            .rs-card-head i.red {
                color: var(--red);
            }

            .rs-card-head i.amber {
                color: var(--amber);
            }

            .rs-card-head i.green {
                color: var(--green);
            }

    .rs-card-body {
        padding: 20px;
    }

    /* Feedback box */
    .feedback-box {
        background: var(--red-bg);
        border: 1px solid rgba(220,38,38,0.15);
        border-radius: 10px;
        padding: 16px;
        font-size: 0.88rem;
        color: var(--text-2);
        line-height: 1.65;
    }

    /* Timer */
    .timer-box {
        background: var(--amber-bg);
        border: 1px solid rgba(217,119,6,0.15);
        border-radius: 10px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .timer-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(217,119,6,0.15);
        color: var(--amber);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .timer-val {
        font-family: var(--f-display);
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--amber);
        line-height: 1;
    }

    .timer-label {
        font-size: 0.72rem;
        color: var(--amber);
        margin-top: 3px;
        opacity: 0.7;
    }

    .timer-date {
        font-size: 0.82rem;
        color: var(--text-2);
        margin-top: 4px;
    }

    /* Reapply box */
    .reapply-box {
        background: var(--green-bg);
        border: 1px solid rgba(5,150,105,0.15);
        border-radius: 10px;
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .reapply-text {
        font-size: 0.85rem;
        color: var(--text-2);
        font-weight: 600;
    }

        .reapply-text span {
            color: var(--green);
        }

    /* Steps */
    .step-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .step-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px;
        background: var(--off);
        border: 1px solid var(--border-2);
        border-radius: 10px;
    }

    .step-num {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--purple-5);
        color: var(--purple);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 800;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .step-text {
        font-size: 0.83rem;
        color: var(--text-2);
        line-height: 1.5;
    }

    /* Buttons */
    .btn-p {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--f-body);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
    }

    .btn-purple {
        background: var(--purple);
        color: #fff;
        box-shadow: 0 4px 12px rgba(124,58,237,0.3);
    }

        .btn-purple:hover {
            background: var(--purple-2);
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-green {
        background: var(--green);
        color: #fff;
        box-shadow: 0 4px 12px rgba(5,150,105,0.3);
    }

        .btn-green:hover {
            background: #047857;
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-outline {
        background: transparent;
        color: var(--muted);
        border: 1.5px solid var(--border);
        padding: 10px 18px;
    }

        .btn-outline:hover {
            border-color: var(--purple);
            color: var(--purple);
        }

    .action-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .info-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 16px;
        background: #EFF6FF;
        border: 1px solid rgba(37,99,235,0.15);
        border-radius: 10px;
        font-size: 0.78rem;
        color: #1D4ED8;
        line-height: 1.5;
    }

    @@media (max-width:600px) {
        .rs-hero {
            padding: 20px;
        }

        .rs-hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .action-row {
            flex-direction: column;
        }

        .btn-p {
            width: 100%;
            justify-content: center;
        }

        .reapply-box {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="rs-wrap">

    <!-- Hero -->
    <div class="rs-hero @(canReapply ? "can-reapply" : "rejected")">
        <div class="rs-hero-inner">
            <div class="rs-icon @(canReapply ? "green" : "red")">
                <i class="bi bi-@(canReapply ? "arrow-clockwise" : "x-circle-fill")"></i>
            </div>
            <div>
                <div class="rs-hero-title">@(canReapply ? "Ready to Reapply" : "Registration Under Review")</div>
                <div class="rs-hero-sub">
                    @(canReapply
                                        ? "The waiting period has ended — you can now update and reapply."
                                        : "Your team leader registration has been reviewed. Please read the feedback below.")
                </div>
            </div>
        </div>
    </div>

    <!-- Feedback -->
    <div class="rs-card">
        <div class="rs-card-head"><i class="bi bi-chat-quote-fill red"></i> Admin Feedback</div>
        <div class="rs-card-body">
            <div class="feedback-box">@Model.RejectionReason</div>
            @if (Model.RejectedAt.HasValue)
            {
                <p style="font-size:0.72rem;color:var(--muted);margin-top:10px;">
                    <i class="bi bi-clock"></i> Reviewed on @Model.RejectedAt.Value.ToString("MMMM dd, yyyy HH:mm") UTC
                </p>
            }
        </div>
    </div>

    <!-- Timer / Reapply -->
    @if (Model.ReapplicationAllowedDate.HasValue)
    {
        <div class="rs-card">
            <div class="rs-card-head">
                <i class="bi bi-@(canReapply ? "check-circle-fill green" : "hourglass-split amber")"></i>
                @(canReapply ? "You Can Reapply Now" : "Reapplication Timeline")
            </div>
            <div class="rs-card-body">
                @if (canReapply)
                {
                    <div class="reapply-box">
                        <div>
                            <div class="reapply-text"><span>✅ The waiting period has ended!</span></div>
                            <div style="font-size:0.78rem;color:var(--muted);margin-top:4px;">Update your profile and request re-verification when ready.</div>
                        </div>
                        <a href="@Url.Action("EditProfile", "TeamDashboard")" class="btn-p btn-green">
                            <i class="bi bi-arrow-clockwise"></i> Update & Reapply
                        </a>
                    </div>
                }
                else
                {
                    <div class="timer-box">
                        <div class="timer-icon"><i class="bi bi-hourglass-split"></i></div>
                        <div>
                            <div class="timer-val">@daysUntilReapply days</div>
                            <div class="timer-label">Until reapplication opens</div>
                            <div class="timer-date">Available from: <strong>@Model.ReapplicationAllowedDate.Value.ToString("MMMM dd, yyyy")</strong></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- What to do -->
    <div class="rs-card">
        <div class="rs-card-head"><i class="bi bi-list-check" style="color:var(--purple)"></i> What You Can Do</div>
        <div class="rs-card-body">
            <div class="step-list">
                <div class="step-item"><div class="step-num">1</div><div class="step-text">Review the admin feedback carefully and understand what needs to be improved.</div></div>
                <div class="step-item"><div class="step-num">2</div><div class="step-text">Update your profile information, bio, and expertise areas based on the feedback.</div></div>
                <div class="step-item"><div class="step-num">3</div><div class="step-text">Add relevant portfolio examples, credentials, or certifications to strengthen your profile.</div></div>
                @if (canReapply)
                {
                    <div class="step-item" style="background:var(--green-bg);border-color:rgba(5,150,105,0.2)">
                        <div class="step-num" style="background:var(--green-bg);color:var(--green)">4</div>
                        <div class="step-text" style="font-weight:600;color:var(--green)">Submit your updated profile for re-verification — you're eligible now!</div>
                    </div>
                }
                else
                {
                    <div class="step-item"><div class="step-num">4</div><div class="step-text">Wait until the reapplication date, then request re-verification.</div></div>
                }
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="rs-card">
        <div class="rs-card-body">
            <div class="action-row">
                <a href="@Url.Action("ViewProfile", "TeamDashboard")" class="btn-p btn-outline">
                    <i class="bi bi-person-fill"></i> View Profile
                </a>
                @if (canReapply)
                {
                    <a href="@Url.Action("EditProfile", "TeamDashboard")" class="btn-p btn-green">
                        <i class="bi bi-arrow-clockwise"></i> Update & Reapply
                    </a>
                }
                else
                {
                    <a href="@Url.Action("EditProfile", "TeamDashboard")" class="btn-p btn-purple">
                        <i class="bi bi-pencil-square"></i> Edit Profile
                    </a>
                }
            </div>
            <div class="info-note" style="margin-top:14px;">
                <i class="bi bi-envelope-fill" style="flex-shrink:0;margin-top:1px"></i>
                <div>Need help or have questions about the feedback? Contact us at <a href="mailto:support@scaleverse.com" style="color:inherit;font-weight:600">support@scaleverse.com</a></div>
            </div>
        </div>
    </div>

</div>
