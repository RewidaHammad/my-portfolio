


@using Scalaverse.Entitys.Models
@model IEnumerable<TeamRoom>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Team Rooms";
    var totalProjects = Model.SelectMany(t => t.Projects).Count();
    var activeProjects = Model.SelectMany(t => t.Projects).Count(p => p.Status == "InProgress");
    var totalEarnings = Model.SelectMany(t => t.Projects).Where(p => p.Status == "Completed").Sum(p => p.Budget);
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-soft: rgba(124,58,237,0.08);
        --purple-glow: rgba(124,58,237,0.2);
        --white: #FFFFFF;
        --off: #F8F9FC;
        --border: rgba(0,0,0,0.07);
        --border-2: rgba(0,0,0,0.1);
        --text: #0D1117;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --amber: #D97706;
        --red: #DC2626;
        --f-display: 'Plus Jakarta Sans',sans-serif;
        --f-body: 'Inter',sans-serif;
        --ease: cubic-bezier(0.16,1,0.3,1);
        --radius: 16px;
        --shadow: 0 4px 16px rgba(0,0,0,0.08),0 1px 4px rgba(0,0,0,0.04);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
        -webkit-font-smoothing: antialiased;
    }

    /* Page header */
    .page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 28px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .page-title {
        font-family: var(--f-display);
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -.03em;
        color: var(--text);
    }

    .page-sub {
        font-size: .85rem;
        color: var(--muted);
        margin-top: 4px;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 22px;
        background: var(--purple);
        color: #fff;
        border: none;
        border-radius: 11px;
        font-family: var(--f-body);
        font-size: .88rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s var(--ease);
        box-shadow: 0 4px 14px var(--purple-glow);
    }

        .btn-create:hover {
            background: var(--purple-2);
            transform: translateY(-1px);
            color: #fff;
            box-shadow: 0 6px 20px rgba(124,58,237,0.4);
        }

    /* Stats */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .si-purple {
        background: var(--purple-soft);
        color: var(--purple);
    }

    .si-green {
        background: #ECFDF5;
        color: var(--green);
    }

    .si-blue {
        background: #EFF6FF;
        color: #2563EB;
    }

    .si-amber {
        background: #FFFBEB;
        color: var(--amber);
    }

    .stat-val {
        font-family: var(--f-display);
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -.03em;
        line-height: 1;
    }

    .stat-label {
        font-size: .75rem;
        color: var(--muted);
        margin-top: 3px;
    }

    /* Teams grid */
    .teams-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(340px,1fr));
        gap: 20px;
    }

    /* Team card */
    .team-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all .3s var(--ease);
        position: relative;
    }

        .team-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg,var(--purple),var(--purple-3));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .4s var(--ease);
        }

        .team-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.12);
            border-color: rgba(124,58,237,0.12);
        }

            .team-card:hover::before {
                transform: scaleX(1);
            }

    /* Card banner */
    .card-banner {
        background: linear-gradient(135deg,#0f1520 0%,#1a1040 100%);
        padding: 18px 20px;
        position: relative;
        overflow: hidden;
    }

        .card-banner::after {
            content: '';
            position: absolute;
            top: -30px;
            right: -20px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(124,58,237,0.2) 0%,transparent 65%);
        }

    .banner-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        position: relative;
        z-index: 2;
    }

    .card-badges {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .cbadge {
        font-size: .65rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 100px;
        text-transform: uppercase;
        letter-spacing: .04em;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .cb-specialty {
        background: rgba(124,58,237,0.2);
        color: var(--purple-4);
        border: 1px solid rgba(124,58,237,0.25);
    }

    .cb-verified {
        background: rgba(5,150,105,0.15);
        color: #34D399;
        border: 1px solid rgba(5,150,105,0.2);
    }

    .cb-pending {
        background: rgba(217,119,6,0.15);
        color: #FCD34D;
        border: 1px solid rgba(217,119,6,0.2);
    }

    .cb-avail {
        background: rgba(37,99,235,0.15);
        color: #93C5FD;
        border: 1px solid rgba(37,99,235,0.2);
    }

    .cb-unavail {
        background: rgba(107,114,128,0.15);
        color: #9CA3AF;
        border: 1px solid rgba(107,114,128,0.2);
    }

    .card-menu-btn {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.5);
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .15s;
        position: relative;
        z-index: 2;
    }

        .card-menu-btn:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

    .card-name {
        font-family: var(--f-display);
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        margin-top: 10px;
        letter-spacing: -.02em;
        position: relative;
        z-index: 2;
    }

    .card-desc {
        font-size: .76rem;
        color: rgba(255,255,255,0.4);
        margin-top: 4px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        position: relative;
        z-index: 2;
    }

    /* Card body */
    .card-body {
        padding: 16px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        background: var(--off);
        border-radius: 10px;
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .stat-cell {
        padding: 10px 8px;
        text-align: center;
        border-right: 1px solid var(--border);
    }

        .stat-cell:last-child {
            border-right: none;
        }

    .sc-icon {
        font-size: 14px;
        margin-bottom: 3px;
    }

    .sc-val {
        font-family: var(--f-display);
        font-size: .92rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1;
    }

    .sc-lbl {
        font-size: .6rem;
        color: var(--muted);
        margin-top: 2px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .sc-purple {
        color: var(--purple);
    }

    .sc-green {
        color: var(--green);
    }

    .sc-amber {
        color: #F59E0B;
    }

    /* Pricing row */
    .price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        background: var(--off);
        border-radius: 10px;
        border: 1px solid var(--border);
    }

    .price-item {
        text-align: center;
    }

    .price-val {
        font-family: var(--f-display);
        font-size: 1rem;
        font-weight: 800;
        color: var(--purple);
    }

    .price-lbl {
        font-size: .62rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-top: 1px;
    }

    .price-divider {
        width: 1px;
        height: 28px;
        background: var(--border);
    }

    /* Active alert */
    .active-alert {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        background: #EFF6FF;
        border: 1px solid rgba(37,99,235,0.15);
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 600;
        color: #2563EB;
    }

    /* Card footer */
    .card-footer {
        padding: 12px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 8px;
    }

    .btn-edit {
        flex: 1;
        padding: 9px 0;
        border: 1.5px solid var(--border-2);
        border-radius: 10px;
        background: transparent;
        color: var(--text-2);
        font-family: var(--f-body);
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .btn-edit:hover {
            border-color: var(--purple);
            color: var(--purple);
            background: var(--purple-soft);
        }

    .btn-view-pub {
        flex: 1;
        padding: 9px 0;
        border: 1.5px solid var(--border-2);
        border-radius: 10px;
        background: transparent;
        color: var(--text-2);
        font-family: var(--f-body);
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .btn-view-pub:hover {
            border-color: var(--purple);
            color: var(--purple);
            background: var(--purple-soft);
        }

    .created-date {
        font-size: .68rem;
        color: var(--muted);
        text-align: center;
        padding: 8px 0 4px;
    }

    /* Dropdown */
    .dropdown-menu {
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        padding: 6px;
        min-width: 150px;
    }

    .dropdown-item {
        border-radius: 7px;
        font-size: .82rem;
        padding: 7px 12px;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: background .15s;
    }

        .dropdown-item:hover {
            background: var(--off);
        }

        .dropdown-item.text-danger:hover {
            background: #FEF2F2;
        }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 80px 40px;
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        background: var(--purple-soft);
        border: 1px solid rgba(124,58,237,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 28px;
        color: var(--purple);
    }

    .empty-title {
        font-family: var(--f-display);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 8px;
    }

    .empty-sub {
        font-size: .88rem;
        color: var(--muted);
        margin-bottom: 24px;
    }

    @@media(max-width:900px) {
        .stats-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:600px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .teams-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Page Header -->
<div class="page-head">
    <div>
        <div class="page-title">My Team Rooms</div>
        <div class="page-sub">Manage your teams, track projects, and grow your business</div>
    </div>
    <a href="@Url.Action("Create")" class="btn-create"><i class="bi bi-plus-circle-fill"></i> Create New Team</a>
</div>

<!-- Stats -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon si-purple"><i class="bi bi-people-fill"></i></div>
        <div>
            <div class="stat-val">@Model.Count()</div>
            <div class="stat-label">Total Teams</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-green"><i class="bi bi-graph-up-arrow"></i></div>
        <div>
            <div class="stat-val">@activeProjects</div>
            <div class="stat-label">Active Projects</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-blue"><i class="bi bi-folder-fill"></i></div>
        <div>
            <div class="stat-val">@totalProjects</div>
            <div class="stat-label">Total Projects</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-amber"><i class="bi bi-currency-dollar"></i></div>
        <div>
            <div class="stat-val">$@totalEarnings.ToString("N0")</div>
            <div class="stat-label">Total Earnings</div>
        </div>
    </div>
</div>

<!-- Teams Grid -->
@if (Model.Any())
{
    <div class="teams-grid">
        @foreach (var team in Model)
        {
            var tp = team.Projects?.Count() ?? 0;
            var ta = team.Projects?.Count(p => p.Status == "InProgress") ?? 0;
            <div class="team-card">

                <div class="card-banner">
                    <div class="banner-top">
                        <div class="card-badges">
                            <span class="cbadge cb-specialty">@team.Specialty</span>
                            @if (team.IsVerified)
                            {
                                <span class="cbadge cb-verified"><i class="bi bi-patch-check-fill"></i> Verified</span>
                            }
                            else
                            {

                                <span class="cbadge cb-pending"><i class="bi bi-clock-fill"></i> Pending</span>
                            }
                            @if (team.IsAvailable)
                            {
                                <span class="cbadge cb-avail"><i class="bi bi-circle-fill" style="font-size:6px"></i> Available</span>
                            }
                            else
                            {

                                <span class="cbadge cb-unavail">Unavailable</span>
                            }
                        </div>
                        <div class="dropdown">
                            <button class="card-menu-btn" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("Edit", new { id = team.TeamRoomId })"><i class="bi bi-pencil"></i> Edit Team</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Details", new { id = team.TeamRoomId })"><i class="bi bi-eye"></i> View Public Page</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="Delete" asp-route-id="@team.TeamRoomId" method="post"
                                          onsubmit="return confirm('Delete this team?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-name">@team.TeamName</div>
                    <div class="card-desc">@team.Description</div>
                </div>

                <div class="card-body">
                    <div class="stats-row">
                        <div class="stat-cell">
                            <div class="sc-icon sc-purple"><i class="bi bi-people-fill"></i></div>
                            <div class="sc-val">@team.TeamSize</div>
                            <div class="sc-lbl">Members</div>
                        </div>
                        <div class="stat-cell">
                            <div class="sc-icon sc-green"><i class="bi bi-folder-fill"></i></div>
                            <div class="sc-val">@tp</div>
                            <div class="sc-lbl">Projects</div>
                        </div>
                        <div class="stat-cell">
                            <div class="sc-icon sc-amber"><i class="bi bi-star-fill"></i></div>
                            <div class="sc-val">@(team.AverageRating?.ToString("0.0") ?? "—")</div>
                            <div class="sc-lbl">Rating</div>
                        </div>
                    </div>

                    <div class="price-row">
                        <div class="price-item">
                            <div class="price-val">$@team.HourlyRate</div>
                            <div class="price-lbl">Per Hour</div>
                        </div>
                        @if (team.ProjectRate.HasValue)
                        {
                            <div class="price-divider"></div>
                            <div class="price-item">
                                <div class="price-val" style="color:var(--green)">$@team.ProjectRate</div>
                                <div class="price-lbl">Project Rate</div>
                            </div>
                        }
                        <div class="price-divider"></div>
                        <div class="price-item">
                            <div class="price-val" style="color:var(--text)">@team.CompletedProjects</div>
                            <div class="price-lbl">Completed</div>
                        </div>
                    </div>

                    @if (ta > 0)
                    {
                        <div class="active-alert"><i class="bi bi-activity"></i> <strong>@ta</strong> active project@(ta > 1 ? "s" : "")</div>
                    }
                </div>

                <div class="card-footer">
                    <a href="@Url.Action("Edit", new { id = team.TeamRoomId })" class="btn-edit"><i class="bi bi-pencil"></i> Edit</a>
                    <a href="@Url.Action("Details", new { id = team.TeamRoomId })" class="btn-view-pub"><i class="bi bi-eye"></i> View Page</a>
                </div>
                <div class="created-date">Created @team.CreatedAt.ToString("MMM dd, yyyy")</div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-people"></i></div>
        <div class="empty-title">No team rooms yet</div>
        <div class="empty-sub">Create your first team room to start receiving project requests.</div>
        <a href="@Url.Action("Create")" class="btn-create"><i class="bi bi-plus-circle-fill"></i> Create Your First Team</a>
    </div>
}
