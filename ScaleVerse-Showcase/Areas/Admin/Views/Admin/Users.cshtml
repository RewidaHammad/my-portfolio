@model ScalaVerse.ViewModel.Admin_VM.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
}  

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ── Root tokens (matches ScaleVerse home) ── */
:root {
    --clr-bg:        #0b0c1a;
    --clr-surface:   #11132a;
    --clr-card:      #14163a;
    --clr-border:    rgba(139,120,255,.15);
    --clr-primary:   #7c6cf8;
    --clr-accent:    #a78bfa;
    --clr-grad-a:    #7c6cf8;
    --clr-grad-b:    #c084fc;
    --clr-success:   #10b981;
    --clr-warning:   #f59e0b;
    --clr-danger:    #ef4444;
    --clr-info:      #38bdf8;
    --clr-text:      #e2e8f0;
    --clr-muted:     #94a3b8;
    --font-main:     'Plus Jakarta Sans', sans-serif;
    --font-body:     'Inter', sans-serif;
    --radius:        14px;
    --radius-sm:     8px;
    --shadow:        0 4px 24px rgba(0,0,0,.35);
    --shadow-lg:     0 8px 48px rgba(0,0,0,.5);
}

/* ── Base Reset ── */
.um-wrap * { box-sizing: border-box; margin: 0; padding: 0; }

.um-wrap {
    font-family: var(--font-body);
    background: var(--clr-bg);
    color: var(--clr-text);
    min-height: 100vh;
    padding: 2rem 1.5rem 4rem;
}

/* ── Header ── */
.um-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
}

.um-header-left {}

.um-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-main);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--clr-accent);
    margin-bottom: .6rem;
}
.um-tag .tag-line {
    width: 22px; height: 2px;
    background: linear-gradient(90deg, var(--clr-grad-a), var(--clr-grad-b));
    border-radius: 2px;
}

.um-title {
    font-family: var(--font-main);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    line-height: 1.15;
    background: linear-gradient(135deg, #fff 20%, var(--clr-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.um-subtitle {
    color: var(--clr-muted);
    font-size: .9rem;
    margin-top: .35rem;
}

/* ── Stats Cards ── */
.um-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.75rem;
}

.um-stat-card {
    background: var(--clr-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: border-color .2s, transform .2s;
    position: relative;
    overflow: hidden;
}
.um-stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--clr-grad-a), var(--clr-grad-b));
    opacity: 0;
    transition: opacity .2s;
}
.um-stat-card:hover { border-color: var(--clr-primary); transform: translateY(-2px); }
.um-stat-card:hover::before { opacity: 1; }

.um-stat-label {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--clr-muted);
    margin-bottom: .4rem;
}
.um-stat-val {
    font-family: var(--font-main);
    font-size: 1.75rem;
    font-weight: 800;
    color: #fff;
}
.um-stat-icon {
    font-size: 2rem;
    opacity: .15;
}
.sc-primary .um-stat-icon { color: var(--clr-primary); }
.sc-success .um-stat-icon { color: var(--clr-success); }
.sc-info    .um-stat-icon { color: var(--clr-info); }

/* ── Search/Filter Card ── */
.um-filter-card {
    background: var(--clr-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    margin-bottom: 1.75rem;
    overflow: hidden;
    box-shadow: var(--shadow);
}
.um-filter-header {
    background: rgba(124,108,248,.1);
    border-bottom: 1px solid var(--clr-border);
    padding: .9rem 1.5rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font-main);
    font-weight: 700;
    font-size: .85rem;
    color: var(--clr-accent);
}
.um-filter-body { padding: 1.5rem; }

.um-filter-row {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
}
.um-filter-group { display: flex; flex-direction: column; gap: .4rem; flex: 1; min-width: 180px; }
.um-filter-group label {
    font-size: .78rem;
    font-weight: 600;
    color: var(--clr-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
}

.um-input, .um-select {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
    color: var(--clr-text);
    padding: .65rem 1rem;
    font-size: .88rem;
    font-family: var(--font-body);
    transition: border-color .2s, box-shadow .2s;
    width: 100%;
}
.um-input::placeholder { color: var(--clr-muted); }
.um-input:focus, .um-select:focus {
    outline: none;
    border-color: var(--clr-primary);
    box-shadow: 0 0 0 3px rgba(124,108,248,.15);
}
.um-select option { background: var(--clr-surface); }

.um-btn-actions { display: flex; gap: .5rem; align-items: center; }

.btn-primary-sv {
    background: linear-gradient(135deg, var(--clr-grad-a), var(--clr-grad-b));
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    padding: .65rem 1.25rem;
    font-size: .85rem;
    font-weight: 700;
    font-family: var(--font-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: opacity .2s, transform .15s;
    text-decoration: none;
}
.btn-primary-sv:hover { opacity: .88; transform: translateY(-1px); color: #fff; }

.btn-ghost-sv {
    background: transparent;
    border: 1px solid var(--clr-border);
    color: var(--clr-muted);
    border-radius: var(--radius-sm);
    padding: .65rem 1.1rem;
    font-size: .85rem;
    font-weight: 600;
    font-family: var(--font-main);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: border-color .2s, color .2s;
    text-decoration: none;
}
.btn-ghost-sv:hover { border-color: var(--clr-primary); color: var(--clr-accent); }

/* ── Table Card ── */
.um-table-card {
    background: var(--clr-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
}
.um-table-header {
    background: linear-gradient(135deg, var(--clr-grad-a), var(--clr-grad-b));
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font-main);
    font-weight: 700;
    font-size: .9rem;
    color: #fff;
}

.um-table-wrap { overflow-x: auto; }

table.um-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .875rem;
}

table.um-table thead th {
    background: rgba(255,255,255,.03);
    border-bottom: 1px solid var(--clr-border);
    padding: .85rem 1.25rem;
    font-family: var(--font-main);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--clr-muted);
    white-space: nowrap;
}

table.um-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,.04);
    transition: background .15s;
}
table.um-table tbody tr:hover { background: rgba(124,108,248,.06); }
table.um-table tbody tr.row-suspended { background: rgba(239,68,68,.05); }
table.um-table tbody tr.row-suspended:hover { background: rgba(239,68,68,.1); }

table.um-table tbody td {
    padding: 1rem 1.25rem;
    vertical-align: middle;
    color: var(--clr-text);
}

/* ── Avatar ── */
.um-avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--clr-grad-a), var(--clr-grad-b));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-main);
    font-weight: 800;
    font-size: .95rem;
    flex-shrink: 0;
}

.um-user-cell { display: flex; align-items: center; gap: .75rem; }
.um-user-name { font-weight: 700; font-family: var(--font-main); color: #fff; }

/* ── Badges ── */
.badge-sv {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .28rem .7rem;
    border-radius: 20px;
    font-size: .72rem;
    font-weight: 700;
    font-family: var(--font-main);
    letter-spacing: .04em;
    white-space: nowrap;
}
.badge-role    { background: rgba(124,108,248,.15); color: var(--clr-accent);  border: 1px solid rgba(124,108,248,.25); }
.badge-active  { background: rgba(16,185,129,.15);  color: var(--clr-success); border: 1px solid rgba(16,185,129,.25); }
.badge-susp    { background: rgba(239,68,68,.15);   color: var(--clr-danger);  border: 1px solid rgba(239,68,68,.25); }
.badge-inactive{ background: rgba(148,163,184,.1);  color: var(--clr-muted);   border: 1px solid rgba(148,163,184,.2); }
.badge-count   { background: rgba(56,189,248,.12);  color: var(--clr-info);    border: 1px solid rgba(56,189,248,.2); }

/* ── Action Buttons ── */
.um-actions { display: flex; gap: .4rem; }

.btn-act {
    width: 32px; height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--clr-border);
    background: transparent;
    color: var(--clr-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all .15s;
    font-size: .85rem;
    text-decoration: none;
}
.btn-act-success:hover { background: rgba(16,185,129,.15);  border-color: var(--clr-success); color: var(--clr-success); }
.btn-act-warning:hover { background: rgba(245,158,11,.15);  border-color: var(--clr-warning); color: var(--clr-warning); }
.btn-act-danger:hover  { background: rgba(239,68,68,.15);   border-color: var(--clr-danger);  color: var(--clr-danger);  }

/* ── Pagination ── */
.um-pagination {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--clr-border);
    display: flex;
    justify-content: center;
}

.pagination-list {
    display: flex;
    gap: .35rem;
    list-style: none;
}

.page-item .page-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 36px; height: 36px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--clr-border);
    background: transparent;
    color: var(--clr-muted);
    font-size: .82rem;
    font-weight: 600;
    font-family: var(--font-main);
    text-decoration: none;
    transition: all .15s;
    padding: 0 .6rem;
}
.page-item .page-link:hover { border-color: var(--clr-primary); color: var(--clr-accent); }
.page-item.active .page-link {
    background: linear-gradient(135deg, var(--clr-grad-a), var(--clr-grad-b));
    border-color: transparent;
    color: #fff;
}
.page-item.disabled .page-link { opacity: .35; pointer-events: none; }

/* ── Responsive ── */
@@media (max-width: 900px) {
    .um-stats { grid-template-columns: 1fr 1fr; }
}
@@media (max-width: 640px) {
    .um-wrap { padding: 1.25rem 1rem 3rem; }
    .um-stats { grid-template-columns: 1fr; }
    .um-filter-row { flex-direction: column; }
    .um-btn-actions { flex-wrap: wrap; }
    table.um-table thead th,
    table.um-table tbody td { padding: .7rem .75rem; font-size: .8rem; }
    .um-title { font-size: 1.5rem; }
}
</style>

<div class="um-wrap">

    <!-- Header -->
    <div class="um-header">
        <div class="um-header-left">
            <div class="um-tag"><div class="tag-line"></div> Admin Panel</div>
            <h1 class="um-title">User Management</h1>
            <p class="um-subtitle">Manage and monitor all platform users</p>
        </div>
    </div>

    <!-- Stats -->
    <div class="um-stats">
        <div class="um-stat-card sc-primary">
            <div>
                <div class="um-stat-label">Total Users</div>
                <div class="um-stat-val">@Model.TotalUsers</div>
            </div>
            <div class="um-stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
        <div class="um-stat-card sc-success">
            <div>
                <div class="um-stat-label">Current Page</div>
                <div class="um-stat-val">@Model.Users.Count</div>
            </div>
            <div class="um-stat-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
        </div>
        <div class="um-stat-card sc-info">
            <div>
                <div class="um-stat-label">Filters</div>
                <div class="um-stat-val" style="font-size:1.25rem">
                    @((!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter != "All") ? "Active" : "None")
                </div>
            </div>
            <div class="um-stat-icon">
                <i class="bi bi-funnel-fill"></i>
            </div>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="um-filter-card">
        <div class="um-filter-header">
            <i class="bi bi-search"></i> Search &amp; Filter
        </div>
        <div class="um-filter-body">
            <form method="get" asp-action="Users">
                <div class="um-filter-row">
                    <div class="um-filter-group" style="flex:2; min-width:200px">
                        <label><i class="bi bi-search"></i> &nbsp;Search Users</label>
                        <input type="text" name="search" class="um-input"
                               placeholder="Search by name or email…" value="@Model.SearchTerm" />
                    </div>
                    <div class="um-filter-group" style="min-width:160px">
                        <label><i class="bi bi-funnel"></i> &nbsp;Status</label>
                        <select name="status" class="um-select">
                            <option value="All"       selected="@(Model.StatusFilter == "All")">All Status</option>
                            <option value="Active"    selected="@(Model.StatusFilter == "Active")">Active Only</option>
                            <option value="Suspended" selected="@(Model.StatusFilter == "Suspended")">Suspended Only</option>
                        </select>
                    </div>
                    <div class="um-btn-actions">
                        <button type="submit" class="btn-primary-sv">
                            <i class="bi bi-search"></i> Apply
                        </button>
                        <a href="@Url.Action("Users")" class="btn-ghost-sv">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="um-table-card">
        <div class="um-table-header">
            <i class="bi bi-table"></i> Users List
        </div>
        <div class="um-table-wrap">
            <table class="um-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th>Projects</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="@(user.IsSuspended ? "row-suspended" : "")">
                            <td>
                                <div class="um-user-cell">
                                    <div class="um-avatar">@user.FullName.Substring(0, 1).ToUpper()</div>
                                    <span class="um-user-name">@user.FullName</span>
                                </div>
                            </td>
                            <td style="color:var(--clr-muted); font-size:.83rem">@user.Email</td>
                            <td>
                                <span class="badge-sv badge-role">
                                    <i class="bi bi-person-badge"></i> @user.Role
                                </span>
                            </td>
                            <td>
                                @if (user.IsSuspended)
                                {
                                    <span class="badge-sv badge-susp"><i class="bi bi-ban"></i> Suspended</span>
                                }
                                else if (user.IsActive)
                                {
                                    <span class="badge-sv badge-active"><i class="bi bi-check-circle"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge-sv badge-inactive"><i class="bi bi-dash-circle"></i> Inactive</span>
                                }
                            </td>
                            <td style="color:var(--clr-muted); font-size:.82rem">
                                <i class="bi bi-clock" style="margin-right:.3rem"></i>@user.LastLoginDisplay
                            </td>
                            <td>
                                <span class="badge-sv badge-count">@user.ProjectsCount</span>
                            </td>
                            <td>
                                <div class="um-actions">
                                    @if (user.IsSuspended)
                                    {
                                        <form method="post" action="@Url.Action("UnsuspendUser")" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <button type="submit" class="btn-act btn-act-success" title="Unsuspend">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("SuspendUser", new { id = user.UserId })"
                                           class="btn-act btn-act-warning" title="Suspend">
                                            <i class="bi bi-ban"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Load More -->
        @if (ViewBag.HasMore)
        {
            <div class="um-pagination">
                <ul class="pagination-list">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Users", new { page = Model.CurrentPage - 1, search = Model.SearchTerm, status = Model.StatusFilter })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Users", new { page = i, search = Model.SearchTerm, status = Model.StatusFilter })">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@@Url.Action("Users", new { page = Model.CurrentPage + 1, search = Model.SearchTerm, status = Model.SearchTerm, status = Model.StatusFilter })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

