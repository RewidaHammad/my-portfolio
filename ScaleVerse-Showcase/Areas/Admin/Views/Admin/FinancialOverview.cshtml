@model ScalaVerse.ViewModel.Admin_VM.FinancialOverviewViewModel
@{
    ViewData["Title"] = "Financial Overview";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* ── Root tokens (ScaleVerse) ── */
    :root {
        --clr-bg: #0b0c1a;
        --clr-surface: #11132a;
        --clr-card: #14163a;
        --clr-border: rgba(139,120,255,.15);
        --clr-primary: #7c6cf8;
        --clr-accent: #a78bfa;
        --clr-grad-a: #7c6cf8;
        --clr-grad-b: #c084fc;
        --clr-success: #10b981;
        --clr-warning: #f59e0b;
        --clr-danger: #ef4444;
        --clr-info: #38bdf8;
        --clr-gold: #fbbf24;
        --clr-text: #e2e8f0;
        --clr-muted: #94a3b8;
        --font-main: 'Plus Jakarta Sans', sans-serif;
        --font-body: 'Inter', sans-serif;
        --radius: 14px;
        --radius-sm: 8px;
        --shadow: 0 4px 24px rgba(0,0,0,.35);
        --shadow-lg: 0 8px 48px rgba(0,0,0,.5);
    }

    .fo-wrap * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .fo-wrap {
        font-family: var(--font-body);
        background: var(--clr-bg);
        color: var(--clr-text);
        min-height: 100vh;
        padding: 2rem 1.5rem 4rem;
    }

    /* ── Header ── */
    .fo-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-main);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--clr-accent);
        margin-bottom: .6rem;
    }

        .fo-tag .tag-line {
            width: 22px;
            height: 2px;
            background: linear-gradient(90deg, var(--clr-grad-a), var(--clr-grad-b));
            border-radius: 2px;
        }

    .fo-title {
        font-family: var(--font-main);
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 800;
        background: linear-gradient(135deg, #fff 20%, var(--clr-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.15;
    }

    .fo-subtitle {
        color: var(--clr-muted);
        font-size: .9rem;
        margin-top: .35rem;
    }

    .fo-header {
        margin-bottom: 2rem;
    }

    /* ── Stats Grid ── */
    .fo-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .fo-stat-card {
        background: var(--clr-card);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 1.35rem 1.5rem;
        position: relative;
        overflow: hidden;
        transition: border-color .2s, transform .2s;
    }

        .fo-stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--clr-grad-a), var(--clr-grad-b));
            opacity: 0;
            transition: opacity .2s;
        }

        .fo-stat-card:hover {
            border-color: var(--clr-primary);
            transform: translateY(-2px);
        }

            .fo-stat-card:hover::before {
                opacity: 1;
            }

    .fo-stat-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: .9rem;
    }

    .fo-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .si-success {
        background: rgba(16,185,129,.15);
        color: var(--clr-success);
    }

    .si-primary {
        background: rgba(124,108,248,.15);
        color: var(--clr-primary);
    }

    .si-info {
        background: rgba(56,189,248,.15);
        color: var(--clr-info);
    }

    .si-warning {
        background: rgba(251,191,36,.15);
        color: var(--clr-gold);
    }

    .fo-stat-label {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--clr-muted);
        margin-bottom: .35rem;
    }

    .fo-stat-val {
        font-family: var(--font-main);
        font-size: 1.7rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
    }

    /* ── Section Card ── */
    .fo-card {
        background: var(--clr-card);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        margin-bottom: 1.75rem;
    }

    .fo-card-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--clr-border);
        display: flex;
        align-items: center;
        gap: .6rem;
        font-family: var(--font-main);
        font-weight: 700;
        font-size: .9rem;
    }

        .fo-card-header.grad-header {
            background: linear-gradient(135deg, var(--clr-grad-a), var(--clr-grad-b));
            color: #fff;
        }

        .fo-card-header.dark-header {
            background: rgba(124,108,248,.08);
            color: var(--clr-accent);
        }

    .fo-table-wrap {
        overflow-x: auto;
    }

    table.fo-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }

        table.fo-table thead th {
            background: rgba(255,255,255,.03);
            border-bottom: 1px solid var(--clr-border);
            padding: .8rem 1.25rem;
            font-family: var(--font-main);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: var(--clr-muted);
            white-space: nowrap;
        }

        table.fo-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,.04);
            transition: background .15s;
        }

            table.fo-table tbody tr:hover {
                background: rgba(124,108,248,.06);
            }

        table.fo-table tbody td {
            padding: .95rem 1.25rem;
            vertical-align: middle;
            color: var(--clr-text);
        }

    /* ── Rank badge ── */
    .fo-rank {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-main);
        font-size: .7rem;
        font-weight: 800;
    }

    .rank-1 {
        background: linear-gradient(135deg,#fbbf24,#f59e0b);
        color: #000;
    }

    .rank-2 {
        background: rgba(148,163,184,.25);
        color: #cbd5e1;
    }

    .rank-3 {
        background: rgba(180,120,60,.25);
        color: #d4a45a;
    }

    .rank-n {
        background: rgba(148,163,184,.1);
        color: var(--clr-muted);
    }

    /* ── Money ── */
    .fo-money {
        font-family: var(--font-main);
        font-weight: 700;
        color: var(--clr-success);
    }

    .fo-commission {
        font-family: var(--font-main);
        font-weight: 600;
        color: var(--clr-accent);
    }

    /* ── Rating ── */
    .fo-rating {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-weight: 700;
        font-family: var(--font-main);
        font-size: .82rem;
        color: var(--clr-gold);
    }

    /* ── Badge ── */
    .badge-sv {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .26rem .65rem;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        font-family: var(--font-main);
        white-space: nowrap;
    }

    .badge-count {
        background: rgba(56,189,248,.12);
        color: var(--clr-info);
        border: 1px solid rgba(56,189,248,.2);
    }

    /* ── Provider name chip ── */
    .fo-name-cell {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .fo-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--clr-grad-a), var(--clr-grad-b));
        flex-shrink: 0;
    }

    .fo-name {
        font-weight: 600;
        font-family: var(--font-main);
    }

    /* ── Responsive ── */
    @@media (max-width: 1024px) {
        .fo-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .fo-wrap {
            padding: 1.25rem 1rem 3rem;
        }

        .fo-stats {
            grid-template-columns: 1fr;
        }

        .fo-stat-val {
            font-size: 1.4rem;
        }

        table.fo-table thead th,
        table.fo-table tbody td {
            padding: .65rem .75rem;
            font-size: .8rem;
        }
    }
</style>

<div class="fo-wrap">

    <!-- Header -->
    <div class="fo-header">
        <div class="fo-tag"><div class="tag-line"></div> Admin Panel</div>
        <h1 class="fo-title">Financial Overview</h1>
        <p class="fo-subtitle">Platform revenue, earnings, and transaction history</p>
    </div>

    <!-- Stats -->
    <div class="fo-stats">
        <div class="fo-stat-card">
            <div class="fo-stat-top">
                <div>
                    <div class="fo-stat-label">Total Revenue</div>
                    <div class="fo-stat-val">$@Model.TotalRevenue.ToString("N2")</div>
                </div>
                <div class="fo-stat-icon si-success">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
        </div>
        <div class="fo-stat-card">
            <div class="fo-stat-top">
                <div>
                    <div class="fo-stat-label">Platform Earnings</div>
                    <div class="fo-stat-val">$@Model.TotalPlatformEarnings.ToString("N2")</div>
                </div>
                <div class="fo-stat-icon si-primary">
                    <i class="bi bi-bank"></i>
                </div>
            </div>
        </div>
        <div class="fo-stat-card">
            <div class="fo-stat-top">
                <div>
                    <div class="fo-stat-label">Avg Project Value</div>
                    <div class="fo-stat-val">$@Model.AverageProjectValue.ToString("N2")</div>
                </div>
                <div class="fo-stat-icon si-info">
                    <i class="bi bi-bar-chart-line"></i>
                </div>
            </div>
        </div>
        <div class="fo-stat-card">
            <div class="fo-stat-top">
                <div>
                    <div class="fo-stat-label">Commission Rate</div>
                    <div class="fo-stat-val">@Model.CommissionPercentage<span style="font-size:1rem;color:var(--clr-muted)">%</span></div>
                </div>
                <div class="fo-stat-icon si-warning">
                    <i class="bi bi-percent"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Teams -->
    <div class="fo-card">
        <div class="fo-card-header grad-header">
            <i class="bi bi-trophy-fill"></i> Top 10 Earning Teams
        </div>
        <div class="fo-table-wrap">
            <table class="fo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Team</th>
                        <th>Total Earned</th>
                        <th>Projects</th>
                        <th>Rating</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int tIdx = 1;
                    }
                    @foreach (var team in Model.TopTeams)
                    {
                        <tr>
                            <td>
                                @{
                                    string tClass = tIdx == 1 ? "rank-1" : tIdx == 2 ? "rank-2" : tIdx == 3 ? "rank-3" : "rank-n";
                                }
                                <span class="fo-rank @tClass">@tIdx</span>
                            </td>
                            <td>
                                <div class="fo-name-cell">
                                    <div class="fo-dot"></div>
                                    <span class="fo-name">@team.Name</span>
                                </div>
                            </td>
                            <td><span class="fo-money">$@team.TotalEarned.ToString("N2")</span></td>
                            <td><span class="badge-sv badge-count">@team.ProjectsCompleted</span></td>
                            <td><span class="fo-rating">★ @team.AverageRating.ToString("0.0")</span></td>
                        </tr>
                        tIdx++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Top Companies -->
    <div class="fo-card">
        <div class="fo-card-header dark-header">
            <i class="bi bi-building"></i> Top 10 Earning Companies
        </div>
        <div class="fo-table-wrap">
            <table class="fo-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company</th>
                        <th>Total Earned</th>
                        <th>Projects</th>
                        <th>Rating</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int cIdx = 1;
                    }
                    @foreach (var company in Model.TopCompanies)
                    {
                        <tr>
                            <td>
                                @{
                                    string cClass = cIdx == 1 ? "rank-1" : cIdx == 2 ? "rank-2" : cIdx == 3 ? "rank-3" : "rank-n";
                                }
                                <span class="fo-rank @cClass">@cIdx</span>
                            </td>
                            <td>
                                <div class="fo-name-cell">
                                    <div class="fo-dot"></div>
                                    <span class="fo-name">@company.Name</span>
                                </div>
                            </td>
                            <td><span class="fo-money">$@company.TotalEarned.ToString("N2")</span></td>
                            <td><span class="badge-sv badge-count">@company.ProjectsCompleted</span></td>
                            <td><span class="fo-rating">★ @company.AverageRating.ToString("0.0")</span></td>
                        </tr>
                        cIdx++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="fo-card">
        <div class="fo-card-header dark-header">
            <i class="bi bi-clock-history"></i> Recent Transactions
        </div>
        <div class="fo-table-wrap">
            <table class="fo-table">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Client</th>
                        <th>Provider</th>
                        <th>Amount</th>
                        <th>Commission</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        <tr>
                            <td>
                                <div class="fo-name-cell">
                                    <div class="fo-dot"></div>
                                    <span class="fo-name">@tx.ProjectName</span>
                                </div>
                            </td>
                            <td style="color:var(--clr-muted); font-size:.83rem">@tx.ClientName</td>
                            <td style="font-weight:600">@tx.ProviderName</td>
                            <td><span class="fo-money">$@tx.Amount.ToString("N2")</span></td>
                            <td><span class="fo-commission">$@tx.PlatformEarnings.ToString("N2")</span></td>
                            <td style="color:var(--clr-muted); font-size:.82rem">
                                <i class="bi bi-calendar3" style="margin-right:.3rem"></i>@tx.CompletedAt.ToString("MMM dd, yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
