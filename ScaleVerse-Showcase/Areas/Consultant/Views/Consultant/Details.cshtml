@using ScalaVerse.ViewModel.Consultant_VM
@model ConsultantProfileViewModel
@{
    ViewData["Title"] = Model.FullName + " — Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

    :root {
        --navy:        #0A0E1A;
        --purple:      #7C3AED;
        --purple-2:    #6D28D9;
        --purple-3:    #8B5CF6;
        --purple-4:    #A78BFA;
        --purple-soft: rgba(124,58,237,0.08);
        --purple-glow: rgba(124,58,237,0.2);
        --white:       #FFFFFF;
        --off:         #F8F9FC;
        --border:      rgba(0,0,0,0.07);
        --border-2:    rgba(0,0,0,0.10);
        --text:        #0D1117;
        --text-2:      #374151;
        --muted:       #6B7280;
        --green:       #059669;
        --green-bg:    #ECFDF5;
        --green-bdr:   rgba(5,150,105,0.15);
        --amber:       #D97706;
        --f-display:   'Plus Jakarta Sans', sans-serif;
        --f-body:      'Inter', sans-serif;
        --ease:        cubic-bezier(0.22,1,0.36,1);
        --r-card:      18px;
        --r-sm:        10px;
        --shadow-xs:   0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md:   0 8px 28px rgba(0,0,0,0.09), 0 2px 8px rgba(0,0,0,0.05);
        --shadow-lg:   0 24px 64px rgba(0,0,0,0.13), 0 6px 18px rgba(0,0,0,0.06);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: var(--off);
        font-family: var(--f-body);
        -webkit-font-smoothing: antialiased;
        color: var(--text);
    }

    /* ── PAGE ── */
    .pr-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
    }

    /* ── BACK ── */
    .pr-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        margin-bottom: 2.25rem;
        letter-spacing: 0.01em;
        transition: color 0.2s, gap 0.2s;
    }
    .pr-back svg { transition: transform 0.2s var(--ease); }
    .pr-back:hover { color: var(--purple); }
    .pr-back:hover svg { transform: translateX(-3px); }

    /* ── LAYOUT ── */
    .pr-layout {
        display: grid;
        grid-template-columns: 290px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    /* ══════════════════════════════
       SIDEBAR
    ══════════════════════════════ */
    .pr-sidebar-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--r-card);
        padding: 2.25rem 1.5rem 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: sticky;
        top: 1.5rem;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    /* decorative top bar */
    .pr-sidebar-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--purple) 0%, var(--purple-3) 60%, transparent 100%);
    }

    /* ── AVATAR ── */
    .pr-avatar-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    /* Professional frame */
    .pr-avatar-frame {
        position: relative;
        width: 108px;
        height: 108px;
    }

    /* Outer decorative ring */
    .pr-avatar-frame::before {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 24px;
        background: linear-gradient(145deg, var(--purple), var(--purple-3), var(--purple-4) 70%);
        opacity: 0.9;
        z-index: 0;
    }

    /* Subtle inner shadow ring */
    .pr-avatar-frame::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 20px;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.18);
        z-index: 3;
        pointer-events: none;
    }

    .pr-avatar-frame img {
        position: relative;
        z-index: 2;
        width: 108px;
        height: 108px;
        border-radius: 20px;
        object-fit: cover;
        display: block;
        border: 3px solid var(--white);
    }

    /* Verified badge on avatar */
    .pr-avatar-badge {
        position: absolute;
        bottom: -6px;
        right: -6px;
        z-index: 4;
        width: 26px;
        height: 26px;
        background: var(--purple);
        border: 2.5px solid var(--white);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px var(--purple-glow);
    }

    .pr-avail {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 1rem;
        border-radius: 100px;
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .pr-avail.on  { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-bdr); }
    .pr-avail.off { background: var(--surface); color: var(--muted); border: 1px solid var(--border-2); }
    .pr-avail-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: currentColor;
        animation: pulse-dot 2s ease infinite;
    }
    .pr-avail.off .pr-avail-dot { animation: none; }
    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.5; transform: scale(0.7); }
    }

    /* ── IDENTITY ── */
    .pr-identity { text-align: center; }
    .pr-identity h2 {
        font-family: var(--f-display);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 0.3rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }
    .pr-specialty {
        font-size: 0.83rem;
        font-weight: 600;
        color: var(--purple);
        letter-spacing: 0.02em;
        margin-bottom: 0.6rem;
    }
    .pr-industry {
        display: inline-block;
        background: var(--purple-soft);
        color: var(--purple);
        border: 1px solid rgba(124,58,237,0.18);
        padding: 0.24rem 0.9rem;
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    /* ── DIVIDER ── */
    .pr-divider {
        width: 100%;
        height: 1px;
        background: var(--border);
    }

    /* ── RATE ── */
    .pr-rate-wrap { text-align: center; }
    .pr-rate-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.35rem;
    }
    .pr-rate-val {
        font-family: var(--f-display);
        font-size: 2.6rem;
        font-weight: 800;
        color: var(--purple);
        display: block;
        letter-spacing: -0.04em;
        line-height: 1;
    }
    .pr-rate-sup {
        font-family: var(--f-body);
        font-size: 1rem;
        font-weight: 600;
        color: var(--purple);
        vertical-align: super;
        margin-right: 2px;
    }
    .pr-rate-unit {
        font-size: 0.78rem;
        color: var(--muted);
        margin-top: 3px;
        letter-spacing: 0.02em;
    }

    /* ── EXTERNAL LINKS ── */
    .pr-links { width: 100%; }
    .pr-links-label {
        font-size: 0.67rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.65rem;
    }
    .pr-ext-link {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.6rem 0.8rem;
        border-radius: var(--r-sm);
        border: 1px solid var(--border);
        background: var(--off);
        text-decoration: none;
        color: var(--text-2);
        font-size: 0.84rem;
        font-weight: 500;
        margin-bottom: 0.45rem;
        transition: all 0.2s var(--ease);
    }
    .pr-ext-link:hover {
        border-color: var(--purple);
        background: var(--purple-soft);
        color: var(--purple);
        transform: translateX(3px);
    }
    .pr-ext-icon {
        width: 28px; height: 28px;
        border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .pr-ext-icon.li { background: #E3F0FA; color: #0077B5; }
    .pr-ext-icon.gh { background: #EBEBEB; color: #1A1A1A; }
    .pr-ext-icon.po { background: var(--purple-soft); color: var(--purple); }
    .pr-ext-icon.ce { background: #FEF3D0; color: var(--amber); }
    .pr-ext-icon.ws { background: var(--purple-soft); color: var(--purple); }
    .pr-ext-arrow { margin-left: auto; color: var(--muted); transition: color 0.2s, transform 0.2s; opacity: 0.5; }
    .pr-ext-link:hover .pr-ext-arrow { color: var(--purple); opacity: 1; transform: translateX(2px); }

    /* ── STATS ── */
    .pr-stats {
        display: flex;
        align-items: center;
        width: 100%;
        padding: 1rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }
    .pr-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
    .pr-stat-val {
        font-family: var(--f-display);
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--text);
    }
    .pr-stat-lbl { font-size: 0.68rem; color: var(--muted); letter-spacing: 0.03em; }
    .pr-stat-divider { width: 1px; height: 34px; background: var(--border); }

    /* ── MEMBER SINCE ── */
    .pr-since {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.74rem;
        color: var(--muted);
    }

    /* ══════════════════════════════
       MAIN SECTIONS
    ══════════════════════════════ */
    .pr-section {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--r-card);
        padding: 2rem 2.25rem;
        margin-bottom: 1.25rem;
        box-shadow: var(--shadow-xs);
        position: relative;
        overflow: hidden;
        transition: box-shadow 0.3s var(--ease);
    }
    .pr-section:hover { box-shadow: var(--shadow-md); }

    /* left accent bar */
    .pr-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; bottom: 0;
        width: 3px;
        background: linear-gradient(to bottom, var(--purple), var(--purple-3) 60%, transparent);
    }

    .pr-section-title {
        font-family: var(--f-display);
        font-size: 0.67rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.4rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .pr-section-line {
        display: block;
        width: 18px;
        height: 2px;
        background: linear-gradient(90deg, var(--purple), var(--purple-3));
        border-radius: 2px;
        flex-shrink: 0;
    }

    /* About */
    .pr-bio {
        font-size: 0.95rem;
        color: var(--text-2);
        line-height: 1.95;
    }

    /* Experience */
    .pr-exp-block {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        background: var(--off);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem 1.75rem;
    }
    .pr-exp-num {
        font-family: var(--f-display);
        font-size: 4rem;
        font-weight: 800;
        color: var(--purple);
        line-height: 1;
        flex-shrink: 0;
        letter-spacing: -0.03em;
    }
    .pr-exp-label {
        font-size: 0.97rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 0.35rem;
    }
    .pr-exp-sub {
        font-size: 0.84rem;
        color: var(--muted);
        line-height: 1.6;
    }

    /* Skills */
    .pr-skills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .pr-skill {
        background: var(--off);
        border: 1px solid var(--border-2);
        color: var(--text-2);
        padding: 0.38rem 1rem;
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        transition: all 0.18s var(--ease);
        cursor: default;
    }
    .pr-skill:hover {
        background: var(--purple-soft);
        border-color: rgba(124,58,237,0.25);
        color: var(--purple);
        transform: translateY(-1px);
    }

    /* Contact */
    .pr-contact-text {
        font-size: 0.92rem;
        color: var(--muted);
        line-height: 1.85;
        margin-bottom: 1.35rem;
    }
    .pr-contact-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .pr-btn-email {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        background: var(--purple);
        color: #fff;
        padding: 0.74rem 1.5rem;
        border-radius: 10px;
        font-family: var(--f-body);
        font-size: 0.87rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s var(--ease);
        box-shadow: 0 4px 14px var(--purple-glow);
        letter-spacing: 0.01em;
    }
    .pr-btn-email:hover {
        background: var(--purple-2);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(124,58,237,0.4);
    }
    .pr-email-addr {
        font-size: 0.82rem;
        color: var(--muted);
        word-break: break-all;
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 768px) {
        .pr-layout { grid-template-columns: 1fr; }
        .pr-sidebar-card { position: static; }
        .pr-section { padding: 1.5rem 1.25rem; }
    }
    @@media (max-width: 480px) {
        .pr-exp-block { flex-direction: column; text-align: center; }
        .pr-contact-actions { flex-direction: column; align-items: flex-start; }
    }

    /* ── FADE IN ── */
    .pr-sidebar-card, .pr-section {
        animation: fadeUp 0.45s var(--ease) both;
    }
    .pr-section:nth-child(1) { animation-delay: 0.08s; }
    .pr-section:nth-child(2) { animation-delay: 0.15s; }
    .pr-section:nth-child(3) { animation-delay: 0.22s; }
    .pr-section:nth-child(4) { animation-delay: 0.29s; }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="pr-page">

    <!-- Back -->
    <a asp-action="Index" class="pr-back">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12,19 5,12 12,5"/>
        </svg>
        Back to Consultants
    </a>

    <div class="pr-layout">

        <!-- ══ SIDEBAR ══ -->
        <aside class="pr-sidebar">
            <div class="pr-sidebar-card">

                <!-- Avatar -->
                <div class="pr-avatar-wrap">
                    <div class="pr-avatar-frame">
                        <img src="@Model.ProfileImageUrl" alt="@Model.FullName"
                             onerror="this.src='/images/default-avatar.png'" />
                        @if (Model.IsVerified)
                        {
                            <div class="pr-avatar-badge">
                                <svg width="13" height="13" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 24 24">
                                    <polyline points="20,6 9,17 4,12"/>
                                </svg>
                            </div>
                        }
                    </div>
                    <div class="pr-avail @(Model.IsAvailable ? "on" : "off")">
                        <span class="pr-avail-dot"></span>
                        @(Model.IsAvailable ? "Available" : "Unavailable")
                    </div>
                </div>

                <!-- Identity -->
                <div class="pr-identity">
                    <h2>@Model.FullName</h2>
                    <p class="pr-specialty">@Model.Specialty</p>
                    <span class="pr-industry">@Model.Industry</span>
                </div>

                <div class="pr-divider"></div>

                <!-- Rate -->
                <div class="pr-rate-wrap">
                    <p class="pr-rate-label">Hourly Rate</p>
                    <span class="pr-rate-val">
                        <span class="pr-rate-sup">$</span>@Model.HourlyRate.ToString("F0")
                    </span>
                    <p class="pr-rate-unit">per hour</p>
                </div>

                <!-- External Links -->
                @{
                    bool hasLinks = !string.IsNullOrEmpty(Model.LinkedInUrl) ||
                                    !string.IsNullOrEmpty(Model.GitHubUrl) ||
                                    !string.IsNullOrEmpty(Model.PortfolioUrl) ||
                                    !string.IsNullOrEmpty(Model.CertificationsUrl);
                }
                @if (hasLinks)
                {
                    <div class="pr-divider"></div>
                    <div class="pr-links">
                        <p class="pr-links-label">Connect</p>
                        @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                        {
                            <a href="@Model.LinkedInUrl" target="_blank" rel="noopener" class="pr-ext-link">
                                <span class="pr-ext-icon li">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7H10V9h4v1.76A6 6 0 0 1 16 8zM2 9h4v12H2z"/>
                                        <circle cx="4" cy="4" r="2"/>
                                    </svg>
                                </span>
                                <span>LinkedIn</span>
                                <svg class="pr-ext-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7,7 17,7 17,17"/>
                                </svg>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.GitHubUrl))
                        {
                            <a href="@Model.GitHubUrl" target="_blank" rel="noopener" class="pr-ext-link">
                                <span class="pr-ext-icon gh">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                                    </svg>
                                </span>
                                <span>GitHub</span>
                                <svg class="pr-ext-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7,7 17,7 17,17"/>
                                </svg>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.PortfolioUrl))
                        {
                            <a href="@Model.PortfolioUrl" target="_blank" rel="noopener" class="pr-ext-link">
                                <span class="pr-ext-icon po">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="2" y1="12" x2="22" y2="12"/>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                    </svg>
                                </span>
                                <span>Portfolio</span>
                                <svg class="pr-ext-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7,7 17,7 17,17"/>
                                </svg>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.CertificationsUrl))
                        {
                            <a href="@Model.CertificationsUrl" target="_blank" rel="noopener" class="pr-ext-link">
                                <span class="pr-ext-icon ws">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                                        <path d="M8 21h8M12 17v4"/>
                                    </svg>
                                </span>
                                <span>Workspace</span>
                                <svg class="pr-ext-arrow" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7,7 17,7 17,17"/>
                                </svg>
                            </a>
                        }
                    </div>
                }

                <!-- Stats -->
                <div class="pr-stats">
                    <div class="pr-stat">
                        <span class="pr-stat-val">
                            @(Model.AverageRating.HasValue ? Model.AverageRating.Value.ToString("F1") + " ★" : "New")
                        </span>
                        <span class="pr-stat-lbl">Rating</span>
                    </div>
                    <div class="pr-stat-divider"></div>
                    <div class="pr-stat">
                        <span class="pr-stat-val">@Model.TotalReviews</span>
                        <span class="pr-stat-lbl">Reviews</span>
                    </div>
                </div>

                <p class="pr-since">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    Member since @Model.MemberSince.ToString("MMMM yyyy")
                </p>

            </div>
        </aside>

        <!-- ══ MAIN ══ -->
        <main class="pr-main">

            <section class="pr-section">
                <h3 class="pr-section-title"><span class="pr-section-line"></span>About</h3>
                <p class="pr-bio">@Model.Bio</p>
            </section>

            <section class="pr-section">
                <h3 class="pr-section-title"><span class="pr-section-line"></span>Experience</h3>
                <div class="pr-exp-block">
                    <div class="pr-exp-num">@Model.YearsOfExperience</div>
                    <div>
                        <p class="pr-exp-label">Years of Professional Experience</p>
                        <p class="pr-exp-sub">Specializing in @Model.Specialty within the @Model.Industry industry.</p>
                    </div>
                </div>
            </section>

            @if (Model.ExpertiseAreas.Any())
            {
                <section class="pr-section">
                    <h3 class="pr-section-title"><span class="pr-section-line"></span>Skills & Expertise</h3>
                    <div class="pr-skills">
                        @foreach (var skill in Model.ExpertiseAreas)
                        {
                            <span class="pr-skill">@skill</span>
                        }
                    </div>
                </section>
            }

            <section class="pr-section">
                <h3 class="pr-section-title"><span class="pr-section-line"></span>Get in Touch</h3>
                <p class="pr-contact-text">
                    Ready to start a conversation? Send a direct email or connect through any of the
                    external links on the sidebar to get in touch with @Model.FullName.
                </p>
                <div class="pr-contact-actions">
                    <a href="mailto:@Model.Email" class="pr-btn-email">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        Send Email
                    </a>
                    <span class="pr-email-addr">@Model.Email</span>
                </div>
            </section>

        </main>
    </div>
</div>
