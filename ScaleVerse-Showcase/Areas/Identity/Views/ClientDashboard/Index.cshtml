@model ScalaVerse.ViewModel.Client_Dashboard_VM.DashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-soft: rgba(124,58,237,0.10);
        --off: #F9FAFB;
        --white: #FFFFFF;
        --border: #E5E7EB;
        --border-soft: #F3F4F6;
        --text: #111827;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --green-text: #065F46;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --amber-text: #92400E;
        --blue: #2563EB;
        --blue-bg: #EFF6FF;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 14px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 12px rgba(0,0,0,0.05);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.13);
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
        color: var(--text);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--f-display);
    }

    .dash-wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    /* ══ HERO ══ */
    .hero-banner {
        background: linear-gradient(135deg, var(--navy) 0%, #1a1040 55%, #0f1a35 100%);
        border-radius: var(--radius);
        padding: 36px 40px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 36px rgba(0,0,0,0.22);
        animation: fadeUp .4s var(--ease) .05s both;
    }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -40px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124,58,237,0.2) 0%, transparent 65%);
            pointer-events: none;
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            bottom: -50px;
            left: 25%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, transparent 65%);
            pointer-events: none;
        }

    .hero-grid-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
    }

    .hero-left {
        flex: 1;
        min-width: 220px;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(124,58,237,0.15);
        border: 1px solid rgba(124,58,237,0.3);
        border-radius: 100px;
        padding: 3px 12px 3px 7px;
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--purple-4);
        margin-bottom: 12px;
    }

    .pill-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--purple-3);
        animation: blink 2s infinite;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .3
        }
    }

    .hero-title {
        font-family: var(--f-display);
        font-size: 1.65rem;
        font-weight: 800;
        letter-spacing: -.035em;
        color: #fff;
        margin: 0 0 6px;
        line-height: 1.18;
    }

        .hero-title .grad {
            background: linear-gradient(120deg, #DDD6FE, var(--purple-4));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .hero-sub {
        font-size: 0.82rem;
        color: rgba(255,255,255,.38);
        margin: 0 0 22px;
        line-height: 1.55;
    }

    .hero-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 9px;
        font-family: var(--f-body);
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s var(--ease);
        border: 1px solid transparent;
    }

    .hb-primary {
        background: var(--purple);
        color: #fff;
        box-shadow: 0 4px 14px rgba(124,58,237,.4);
        border-color: var(--purple);
    }

        .hb-primary:hover {
            background: var(--purple-2);
            color: #fff;
            transform: translateY(-1px);
        }

    .hb-ghost {
        background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.75);
        border-color: rgba(255,255,255,.13);
        backdrop-filter: blur(4px);
    }

        .hb-ghost:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

    /* mini stats right side */
    .hero-minis {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }

    .hero-mini {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 12px;
        padding: 14px 20px;
        text-align: center;
        min-width: 78px;
    }

    .hm-val {
        font-family: var(--f-display);
        font-size: 1.45rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
        margin-bottom: 4px;
    }

        .hm-val span {
            color: var(--purple-4);
        }

    .hm-label {
        font-size: .6rem;
        color: rgba(255,255,255,.32);
        letter-spacing: .07em;
        text-transform: uppercase;
    }

    /* ══ STATS GRID ══ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        text-decoration: none;
        display: block;
        transition: all .25s var(--ease);
        box-shadow: var(--shadow);
        animation: fadeUp .5s var(--ease) both;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: var(--purple-4);
        }

    .stat-stripe {
        height: 3px;
    }

    .ss-blue {
        background: linear-gradient(90deg, var(--blue), #60A5FA);
    }

    .ss-green {
        background: linear-gradient(90deg, var(--green), #34D399);
    }

    .ss-purple {
        background: linear-gradient(90deg, var(--purple), var(--purple-3));
    }

    .ss-amber {
        background: linear-gradient(90deg, var(--amber), #FCD34D);
    }

    .stat-body {
        padding: 16px 18px 14px;
    }

    .stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        margin-bottom: 11px;
    }

    .si-blue {
        background: var(--blue-bg);
        color: var(--blue);
    }

    .si-green {
        background: var(--green-bg);
        color: var(--green);
    }

    .si-purple {
        background: var(--purple-soft);
        color: var(--purple);
    }

    .si-amber {
        background: var(--amber-bg);
        color: var(--amber);
    }

    .stat-value {
        font-family: var(--f-display);
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -.04em;
        color: var(--text);
        line-height: 1;
        margin-bottom: 3px;
    }

    .stat-label {
        font-size: .73rem;
        color: var(--muted);
        font-weight: 500;
        margin-bottom: 9px;
    }

    .stat-link {
        font-size: .7rem;
        font-weight: 600;
        color: var(--purple);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: gap .15s;
    }

    .stat-card:hover .stat-link {
        gap: 7px;
    }

    .stat-card:nth-child(1) {
        animation-delay: .1s;
    }

    .stat-card:nth-child(2) {
        animation-delay: .15s;
    }

    .stat-card:nth-child(3) {
        animation-delay: .2s;
    }

    .stat-card:nth-child(4) {
        animation-delay: .25s;
    }

    /* ══ SECTION HEADER ══ */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .section-title {
        font-family: var(--f-display);
        font-size: .88rem;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
    }

        .section-title i {
            color: var(--purple);
            font-size: 14px;
        }

    .section-link {
        font-size: .73rem;
        font-weight: 600;
        color: var(--purple);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: gap .15s;
    }

        .section-link:hover {
            gap: 7px;
        }

    /* ══ PROJECTS CARD ══ */
    .projects-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        animation: fadeUp .5s var(--ease) .28s both;
    }

    .proj-table {
        width: 100%;
        border-collapse: collapse;
    }

        .proj-table thead tr {
            background: var(--off);
            border-bottom: 1px solid var(--border);
        }

        .proj-table th {
            padding: 10px 16px;
            font-size: .66rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--muted);
            text-align: left;
        }

        .proj-table tbody tr {
            border-bottom: 1px solid var(--border-soft);
            transition: background .15s;
        }

            .proj-table tbody tr:last-child {
                border-bottom: none;
            }

            .proj-table tbody tr:hover {
                background: var(--off);
            }

        .proj-table td {
            padding: 12px 16px;
            font-size: .83rem;
            color: var(--text-2);
            vertical-align: middle;
        }

    .proj-name {
        font-weight: 700;
        color: var(--text);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        border-radius: 100px;
        font-size: .66rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .badge-active {
        background: var(--green-bg);
        color: var(--green-text);
    }

    .badge-pending {
        background: var(--amber-bg);
        color: var(--amber-text);
    }

    .badge-completed {
        background: var(--purple-soft);
        color: var(--purple-2);
    }

    .badge-onhold {
        background: var(--amber-bg);
        color: var(--amber-text);
    }

    .badge-cancelled {
        background: var(--border-soft);
        color: var(--muted);
    }

    .progress-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .progress-bar-bg {
        flex: 1;
        height: 5px;
        background: var(--border-soft);
        border-radius: 99px;
        overflow: hidden;
        min-width: 70px;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, var(--purple), var(--purple-3));
        transition: width .8s var(--ease);
    }

    .progress-pct {
        font-size: .68rem;
        font-weight: 700;
        color: var(--muted);
        white-space: nowrap;
        min-width: 28px;
    }

    .btn-view {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 7px;
        font-size: .72rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--purple);
        background: var(--purple-soft);
        border: 1px solid rgba(124,58,237,.2);
        transition: all .15s;
    }

        .btn-view:hover {
            background: var(--purple);
            color: #fff;
        }

    .empty-state {
        text-align: center;
        padding: 44px 20px;
    }

        .empty-state i {
            font-size: 38px;
            color: var(--border);
            display: block;
            margin-bottom: 10px;
        }

        .empty-state p {
            font-size: .82rem;
            color: var(--muted);
            margin: 0 0 14px;
        }

    /* ══ ANIMATIONS ══ */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ══ RESPONSIVE ══ */
    @@media (max-width: 960px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 720px) {
        .hero-banner {
            padding: 28px 22px;
        }

        .hero-title {
            font-size: 1.35rem;
        }

        .hero-minis {
            display: none;
        }

        .proj-table th:nth-child(3),
        .proj-table td:nth-child(3) {
            display: none;
        }
    }

    @@media (max-width: 500px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .hb-ghost {
            display: none;
        }
    }
</style>

<div class="dash-wrap">

    <!-- ══ HERO ══ -->
    <div class="hero-banner">
        <div class="hero-grid-pattern"></div>
        <div class="hero-inner">
            <div class="hero-left">
                <div class="hero-eyebrow">
                    <span class="pill-dot"></span> Client Dashboard
                </div>
                <div class="hero-title">
                    Welcome back, <span class="grad">@(Model.ClientName?.Split(' ')[0] ?? "there")</span>
                </div>
                <div class="hero-sub">Here's an overview of your projects and activity.</div>
                <div class="hero-actions">
                    <a href="@Url.Action("Index", "TeamRooms", new { area = "TeamRooms" })" class="hero-btn hb-primary">
                        <i class="bi bi-plus-circle-fill"></i> Start New Project
                    </a>
                    <a href="@Url.Action("MyRequests", "Projects", new { area = "TeamRooms" })" class="hero-btn hb-ghost">
                        <i class="bi bi-inbox-fill"></i> My Requests
                    </a>
                    <a href="@Url.Action("Index", "Projects", new { area = "TeamRooms" })" class="hero-btn hb-ghost">
                        <i class="bi bi-folder2-open"></i> All Projects
                    </a>
                </div>
            </div>
            <div class="hero-minis">
                <div class="hero-mini">
                    <div class="hm-val">@Model.Statistics.TotalProjects<span>+</span></div>
                    <div class="hm-label">Projects</div>
                </div>
                <div class="hero-mini">
                    <div class="hm-val">@Model.Statistics.ActiveProjects</div>
                    <div class="hm-label">Active</div>
                </div>
                <div class="hero-mini">
                    <div class="hm-val">@Model.Statistics.CompletedProjects</div>
                    <div class="hm-label">Done</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══ STATS GRID ══ -->
    <div class="stats-grid">
        <a href="@Url.Action("Index", "Projects", new { area = "TeamRooms", status = "all" })" class="stat-card">
            <div class="stat-stripe ss-blue"></div>
            <div class="stat-body">
                <div class="stat-icon si-blue"><i class="bi bi-folder2-open"></i></div>
                <div class="stat-value">@Model.Statistics.TotalProjects</div>
                <div class="stat-label">Total Projects</div>
                <div class="stat-link">View all <i class="bi bi-arrow-right"></i></div>
            </div>
        </a>
        <a href="@Url.Action("Index", "Projects", new { area = "TeamRooms", status = "active" })" class="stat-card">
            <div class="stat-stripe ss-green"></div>
            <div class="stat-body">
                <div class="stat-icon si-green"><i class="bi bi-play-circle-fill"></i></div>
                <div class="stat-value">@Model.Statistics.ActiveProjects</div>
                <div class="stat-label">Active Projects</div>
                <div class="stat-link">View active <i class="bi bi-arrow-right"></i></div>
            </div>
        </a>
        <a href="@Url.Action("Index", "Projects", new { area = "TeamRooms", status = "completed" })" class="stat-card">
            <div class="stat-stripe ss-purple"></div>
            <div class="stat-body">
                <div class="stat-icon si-purple"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-value">@Model.Statistics.CompletedProjects</div>
                <div class="stat-label">Completed</div>
                <div class="stat-link">View completed <i class="bi bi-arrow-right"></i></div>
            </div>
        </a>
        <div class="stat-card">
            <div class="stat-stripe ss-amber"></div>
            <div class="stat-body">
                <div class="stat-icon si-amber"><i class="bi bi-currency-dollar"></i></div>
                <div class="stat-value" style="font-size:1.4rem">$@Model.Statistics.TotalSpent.ToString("N0")</div>
                <div class="stat-label">Total Spent</div>
                <div style="font-size:.68rem;color:var(--muted)">Across all projects</div>
            </div>
        </div>
    </div>

    <!-- ══ RECENT PROJECTS ══ -->
    <div>
        <div class="section-header">
            <h2 class="section-title"><i class="bi bi-clock-history"></i> Recent Projects</h2>
            <a href="@Url.Action("Index", "Projects", new { area = "TeamRooms", status = "all" })" class="section-link">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="projects-card">
            @if (!Model.RecentProjects.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-folder-x"></i>
                    <p>No projects yet. Start your first project!</p>
                    <a href="@Url.Action("Index", "TeamRooms", new { area = "TeamRooms" })" class="btn-view">
                        <i class="bi bi-search"></i> Browse Teams
                    </a>
                </div>
            }
            else
            {
                <table class="proj-table">
                    <thead>
                        <tr>
                            <th>Project Name</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model.RecentProjects)
                        {
                            var badgeClass = project.Status switch
                            {
                                "Active" => "badge-active",
                                "InProgress" => "badge-active",
                                "Pending" => "badge-pending",
                                "Completed" => "badge-completed",
                                "OnHold" => "badge-onhold",
                                "Cancelled" => "badge-cancelled",
                                _ => "badge-pending"
                            };
                            var badgeIcon = project.Status switch
                            {
                                "Active" => "bi-play-circle-fill",
                                "InProgress" => "bi-play-circle-fill",
                                "Pending" => "bi-clock",
                                "Completed" => "bi-check-circle-fill",
                                "OnHold" => "bi-pause-circle-fill",
                                "Cancelled" => "bi-x-circle-fill",
                                _ => "bi-clock"
                            };
                            <tr>
                                <td><span class="proj-name">@project.ProjectName</span></td>
                                <td>
                                    <span class="badge @badgeClass">
                                        <i class="bi @badgeIcon"></i> @project.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="progress-wrap">
                                        <div class="progress-bar-bg">
                                            <div class="progress-bar-fill" style="width:@project.ProgressPercentage%"></div>
                                        </div>
                                        <span class="progress-pct">@project.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Projects", new { area = "TeamRooms", id = project.ProjectId })" class="btn-view">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.progress-bar-fill').forEach(bar => {
            const w = bar.style.width;
            bar.style.width = '0';
            setTimeout(() => { bar.style.width = w; }, 300);
        });
    </script>
}
