

@model ScalaVerse.ViewModel.Identity_VM.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-5: #EDE9FE;
        --white: #FFFFFF;
        --off: #F9FAFB;
        --border: #E5E7EB;
        --border-2: #F3F4F6;
        --text: #0F172A;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --red: #DC2626;
        --red-bg: #FEF2F2;
        --f-display: 'Plus Jakarta Sans',sans-serif;
        --f-body: 'Inter',sans-serif;
        --ease: cubic-bezier(0.16,1,0.3,1);
        --radius: 12px;
        --radius-lg: 16px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07),0 4px 12px rgba(0,0,0,0.04);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .cp-wrap {
        max-width: 560px;
        margin: 0 auto;
    }

    /* Hero */
    .cp-hero {
        background: var(--navy);
        border-radius: var(--radius-lg);
        padding: 24px 28px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .cp-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(ellipse 70% 80% at 100% 0%, rgba(124,58,237,0.18) 0%, transparent 60%);
        }

    .cp-hero-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: 44px 44px;
    }

    .cp-hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .cp-hero-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        flex-shrink: 0;
        background: rgba(124,58,237,0.2);
        border: 1px solid rgba(124,58,237,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: var(--purple-4);
    }

    .cp-hero-title {
        font-family: var(--f-display);
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .cp-hero-sub {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.4);
        margin-top: 3px;
    }

    /* Card */
    .cp-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .cp-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border-2);
        font-family: var(--f-display);
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
    }

        .cp-card-head i {
            color: var(--purple);
            font-size: 15px;
        }

    .cp-card-body {
        padding: 24px;
    }

    /* Form */
    .form-group {
        margin-bottom: 20px;
    }

        .form-group:last-of-type {
            margin-bottom: 0;
        }

    .form-lbl {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

        .form-lbl span {
            color: var(--red);
        }

    .input-wrap {
        position: relative;
    }

    .form-ctrl {
        width: 100%;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        background: var(--off);
        color: var(--text);
        font-family: var(--f-body);
        font-size: 0.88rem;
        font-weight: 500;
        padding: 11px 44px 11px 14px;
        outline: none;
        transition: all 0.2s;
    }

        .form-ctrl:focus {
            border-color: var(--purple);
            background: var(--white);
            box-shadow: 0 0 0 3px rgba(124,58,237,0.08);
        }

    .eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--muted);
        font-size: 16px;
        cursor: pointer;
        transition: color 0.15s;
        padding: 4px;
    }

        .eye-btn:hover {
            color: var(--purple);
        }

    .form-error {
        font-size: 0.75rem;
        color: var(--red);
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Password strength */
    .strength-wrap {
        margin-top: 8px;
    }

    .strength-bar {
        height: 4px;
        background: var(--border-2);
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 4px;
    }

    .strength-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 0.3s, background 0.3s;
        width: 0;
    }

    .strength-label {
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--muted);
    }

    /* Divider */
    .form-divider {
        height: 1px;
        background: var(--border-2);
        margin: 20px 0;
    }

    /* Validation summary */
    .val-summary {
        background: var(--red-bg);
        border: 1px solid rgba(220,38,38,0.2);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 0.82rem;
        color: var(--red);
    }

    /* Success */
    .success-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--green-bg);
        border: 1px solid rgba(5,150,105,0.2);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--green);
    }

    /* Tips */
    .tips-box {
        background: var(--off);
        border: 1px solid var(--border-2);
        border-radius: 10px;
        padding: 14px 16px;
        margin-top: 16px;
    }

    .tips-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .tip-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
        color: var(--text-2);
        margin-bottom: 6px;
    }

        .tip-row:last-child {
            margin-bottom: 0;
        }

    .tip-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--purple);
        flex-shrink: 0;
    }

    /* Actions */
    .action-row {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-save {
        flex: 1;
        padding: 12px;
        background: var(--purple);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: var(--f-body);
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s var(--ease);
        box-shadow: 0 4px 14px rgba(124,58,237,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-save:hover {
            background: var(--purple-2);
            transform: translateY(-1px);
        }

    .btn-cancel {
        padding: 12px 20px;
        background: transparent;
        color: var(--muted);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-family: var(--f-body);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .btn-cancel:hover {
            border-color: var(--purple);
            color: var(--purple);
        }

    @@media (max-width:600px) {
        .action-row {
            flex-direction: column;
        }

        .btn-cancel {
            justify-content: center;
        }

        .cp-hero {
            padding: 20px;
        }
    }
</style>

<div class="cp-wrap">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-banner">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Hero -->
    <div class="cp-hero">
        <div class="cp-hero-grid"></div>
        <div class="cp-hero-inner">
            <div class="cp-hero-icon"><i class="bi bi-shield-lock-fill"></i></div>
            <div>
                <div class="cp-hero-title">Change Password</div>
                <div class="cp-hero-sub">Keep your account secure with a strong password</div>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="cp-card">
        <div class="cp-card-head"><i class="bi bi-key-fill"></i> Update Your Password</div>
        <div class="cp-card-body">

            <div asp-validation-summary="All" class="val-summary"></div>

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <!-- Current Password -->
                <div class="form-group">
                    <label class="form-lbl">Current Password <span>*</span></label>
                    <div class="input-wrap">
                        <input asp-for="OldPassword" type="password" class="form-ctrl"
                               placeholder="Enter your current password" id="oldPass" />
                        <button type="button" class="eye-btn" onclick="togglePass('oldPass',this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="OldPassword" class="form-error"></span>
                </div>

                <div class="form-divider"></div>

                <!-- New Password -->
                <div class="form-group">
                    <label class="form-lbl">New Password <span>*</span></label>
                    <div class="input-wrap">
                        <input asp-for="NewPassword" type="password" class="form-ctrl"
                               placeholder="Enter your new password" id="newPass"
                               oninput="checkStrength(this.value)" />
                        <button type="button" class="eye-btn" onclick="togglePass('newPass',this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="form-error"></span>
                    <div class="strength-wrap">
                        <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                        <div class="strength-label" id="strengthLabel">Enter a password</div>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label class="form-lbl">Confirm New Password <span>*</span></label>
                    <div class="input-wrap">
                        <input asp-for="ConfirmPassword" type="password" class="form-ctrl"
                               placeholder="Repeat your new password" id="confirmPass" />
                        <button type="button" class="eye-btn" onclick="togglePass('confirmPass',this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="form-error"></span>
                </div>

                <!-- Tips -->
                <div class="tips-box">
                    <div class="tips-title">Password Requirements</div>
                    <div class="tip-row"><div class="tip-dot"></div> At least 8 characters long</div>
                    <div class="tip-row"><div class="tip-dot"></div> Include uppercase and lowercase letters</div>
                    <div class="tip-row"><div class="tip-dot"></div> Include at least one number</div>
                    <div class="tip-row"><div class="tip-dot"></div> Include at least one special character (!@@#$%)</div>
                </div>

                <!-- Actions -->
                <div class="action-row">
                    <a href="javascript:history.back()" class="btn-cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn-save">
                        <i class="bi bi-shield-check-fill"></i> Update Password
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

<script>
    // Toggle password visibility
    function togglePass(id, btn) {
      var input = document.getElementById(id);
      var icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
      } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
      }
    }

    // Password strength checker
    function checkStrength(val) {
      var fill = document.getElementById('strengthFill');
      var label = document.getElementById('strengthLabel');
      var score = 0;
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val)) score++;
      if (/[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      var configs = [
        { w:'0%',   bg:'transparent', txt:'Enter a password' },
        { w:'25%',  bg:'#DC2626',     txt:'Weak' },
        { w:'50%',  bg:'#D97706',     txt:'Fair' },
        { w:'75%',  bg:'#2563EB',     txt:'Good' },
        { w:'100%', bg:'#059669',     txt:'Strong ✓' },
      ];
      var c = configs[score];
      fill.style.width = c.w;
      fill.style.background = c.bg;
      label.textContent = c.txt;
      label.style.color = c.bg === 'transparent' ? 'var(--muted)' : c.bg;
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
