@model ScalaVerse.ViewModel.Company_Dashboard_VM.CompanyDashboardViewModel
@{
    ViewData["Title"] = "Company Dashboard";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --navy: #0A0E1A;
        --navy-2: #111827;
        --navy-3: #1E2740;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-glow: rgba(124,58,237,0.25);
        --purple-soft: rgba(124,58,237,0.1);
        --white: #FFFFFF;
        --off: #F9FAFB;
        --fog: #F3F4F6;
        --border: #E5E7EB;
        --text: #111827;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --red: #DC2626;
        --red-bg: #FEF2F2;
        --blue: #2563EB;
        --blue-bg: #EFF6FF;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 16px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 16px rgba(0,0,0,0.05);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.1);
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
    }

    /* ── Hero Banner ── */
    .hero-banner {
        background: linear-gradient(135deg, #1a0a3e 0%, var(--purple-2) 40%, var(--purple) 100%);
        border-radius: 20px;
        padding: 32px 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 48px rgba(124,58,237,0.35);
    }

        /* Background grid pattern */
        .hero-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
            mask-image: radial-gradient(ellipse 80% 100% at 30% 50%, black, transparent);
            pointer-events: none;
        }

    .hero-orb-1 {
        position: absolute;
        right: 180px;
        top: -60px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
        filter: blur(2px);
        pointer-events: none;
    }

    .hero-orb-2 {
        position: absolute;
        right: 60px;
        bottom: -70px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(139,92,246,0.2);
        filter: blur(40px);
        pointer-events: none;
    }

    .hero-left {
        position: relative;
        z-index: 2;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
        margin-bottom: 10px;
    }

    .eyebrow-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--purple-3);
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.3;
    }

    }

    .hero-title {
        font-family: var(--f-display);
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.035em;
        color: #fff;
        line-height: 1.15;
        margin-bottom: 6px;
    }

    .hero-sub {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.45);
        font-weight: 500;
    }

    .hero-right {
        display: flex;
        gap: 10px;
        position: relative;
        z-index: 2;
        flex-shrink: 0;
    }

    .dbtn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--f-body);
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 10px;
        transition: all 0.2s var(--ease);
        cursor: pointer;
        border: 1px solid transparent;
        white-space: nowrap;
    }

        .dbtn svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .dbtn-white {
        background: rgba(255,255,255,0.15);
        color: #fff;
        border-color: rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
    }

        .dbtn-white:hover {
            background: rgba(255,255,255,0.25);
            color: #fff;
            transform: translateY(-1px);
        }

    .dbtn-outline {
        background: rgba(255,255,255,0.07);
        color: rgba(255,255,255,0.8);
        border-color: rgba(255,255,255,0.12);
    }

        .dbtn-outline:hover {
            background: rgba(255,255,255,0.14);
            color: #fff;
        }

    /* ── Alert Banner ── */
    .alert-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        background: linear-gradient(135deg, #1a0a3e 0%, #0A0E1A 100%);
        border: 1px solid rgba(124,58,237,0.3);
        border-left: 4px solid var(--purple);
        border-radius: var(--radius);
        padding: 14px 20px;
        margin-bottom: 20px;
        animation: slideDown 0.4s var(--ease);
    }

    @@keyframes slideDown {
        from

    {
        opacity: 0;
        transform: translateY(-8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .alert-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(124,58,237,0.2);
        border: 1px solid rgba(124,58,237,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .alert-text {
        flex: 1;
    }

    .alert-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 2px;
    }

    .alert-sub {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.4);
    }

    .alert-cta {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.78rem;
        font-weight: 700;
        color: #C4B5FD;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 8px;
        background: rgba(124,58,237,0.15);
        border: 1px solid rgba(124,58,237,0.3);
        transition: all 0.2s;
        white-space: nowrap;
    }

        .alert-cta:hover {
            background: rgba(124,58,237,0.28);
            color: #DDD6FE;
            transform: translateX(2px);
        }

    /* ── Stats Grid ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 18px;
        transition: all 0.3s var(--ease);
        box-shadow: var(--shadow);
        text-decoration: none;
        display: block;
        position: relative;
        overflow: hidden;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--purple);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s var(--ease);
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: rgba(124,58,237,0.3);
        }

            .stat-card:hover::after {
                transform: scaleX(1);
            }

    .stat-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--purple-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }

        .stat-icon svg {
            width: 14px;
            height: 14px;
            stroke: var(--purple);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .stat-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .stat-value {
        font-family: var(--f-display);
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
        line-height: 1;
        margin-bottom: 8px;
    }

    .stat-hint {
        font-size: 0.72rem;
        color: var(--purple);
        font-weight: 600;
    }

    .stat-card.green-card {
        background: linear-gradient(135deg, #ECFDF5, #D1FAE5);
        border-color: rgba(5,150,105,0.25);
    }

        .stat-card.green-card .stat-icon {
            background: rgba(5,150,105,0.12);
        }

            .stat-card.green-card .stat-icon svg {
                stroke: var(--green);
            }

        .stat-card.green-card .stat-label {
            color: #065F46;
        }

        .stat-card.green-card .stat-value {
            color: var(--green);
        }

        .stat-card.green-card .stat-hint {
            color: var(--green);
        }

        .stat-card.green-card::after {
            background: var(--green);
        }

    .stat-card.amber-card {
        background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
        border-color: rgba(217,119,6,0.25);
    }

        .stat-card.amber-card .stat-icon {
            background: rgba(217,119,6,0.12);
        }

            .stat-card.amber-card .stat-icon svg {
                stroke: var(--amber);
            }

        .stat-card.amber-card .stat-label {
            color: #92400E;
        }

        .stat-card.amber-card .stat-value {
            color: var(--amber);
        }

        .stat-card.amber-card .stat-hint {
            color: var(--amber);
        }

        .stat-card.amber-card::after {
            background: var(--amber);
        }

    /* ── Main Grid ── */
    .dash-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .dash-section {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: var(--shadow);
    }

    .sect-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--fog);
    }

    .sect-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sect-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .sect-icon svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .si-amber {
        background: var(--amber-bg);
    }

        .si-amber svg {
            stroke: var(--amber);
        }

    .si-purple {
        background: var(--purple-soft);
    }

        .si-purple svg {
            stroke: var(--purple);
        }

    .sect-title {
        font-family: var(--f-display);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: var(--text);
    }

    .sect-link {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--purple);
        text-decoration: none;
        padding: 5px 10px;
        border-radius: 7px;
        background: var(--purple-soft);
        transition: all 0.2s;
    }

        .sect-link:hover {
            background: rgba(124,58,237,0.18);
            color: var(--purple-2);
        }

    /* ── Request Card ── */
    .req-card {
        background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
        border: 1.5px solid rgba(217,119,6,0.2);
        border-radius: 12px;
        padding: 16px 18px;
        margin-bottom: 12px;
        transition: all 0.25s var(--ease);
        position: relative;
    }

        .req-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: var(--amber);
            border-radius: 3px 0 0 3px;
        }

        .req-card:last-child {
            margin-bottom: 0;
        }

        .req-card:hover {
            transform: translateX(3px);
            box-shadow: 0 4px 16px rgba(217,119,6,0.15);
            border-color: rgba(217,119,6,0.35);
        }

    .req-head {
        font-family: var(--f-display);
        font-size: 0.9rem;
        font-weight: 700;
        color: #78350F;
        margin-bottom: 6px;
    }

    .req-meta {
        font-size: 0.78rem;
        color: #92400E;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

        .req-meta strong {
            font-weight: 600;
        }

    .req-pill {
        display: inline-block;
        padding: 1px 8px;
        background: rgba(217,119,6,0.15);
        border-radius: 100px;
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--amber);
        letter-spacing: 0.03em;
    }

    .req-desc {
        font-size: 0.8rem;
        color: #A16207;
        margin: 8px 0;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .req-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
    }

    .req-time {
        font-size: 0.7rem;
        color: #B45309;
        font-weight: 500;
    }

    .req-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        background: var(--green);
        color: #fff;
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        transition: all 0.2s;
    }

        .req-btn:hover {
            background: #047857;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(5,150,105,0.35);
        }

        .req-btn svg {
            width: 11px;
            height: 11px;
            stroke: #fff;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    /* ── Project Card ── */
    .proj-card {
        background: var(--off);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        padding: 16px 18px;
        margin-bottom: 12px;
        transition: all 0.25s var(--ease);
    }

        .proj-card:last-child {
            margin-bottom: 0;
        }

        .proj-card:hover {
            background: var(--white);
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            border-color: rgba(124,58,237,0.2);
        }

    .proj-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .proj-head {
        font-family: var(--f-display);
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .proj-meta {
        font-size: 0.77rem;
        color: var(--muted);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .proj-sep {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--border);
    }

    .proj-bar-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .proj-bar {
        flex: 1;
        background: var(--border);
        height: 6px;
        border-radius: 100px;
        overflow: hidden;
    }

    .proj-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--green) 0%, #34D399 100%);
        border-radius: 100px;
        transition: width 0.7s var(--ease);
    }

    .proj-pct {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--muted);
        min-width: 32px;
        text-align: right;
    }

    .proj-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--purple);
        text-decoration: none;
        transition: gap 0.2s;
    }

        .proj-link:hover {
            gap: 7px;
        }

        .proj-link svg {
            width: 11px;
            height: 11px;
            stroke: var(--purple);
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    /* ── Badge ── */
    .badge {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 100px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .badge-green {
        background: var(--green-bg);
        color: var(--green);
    }

    .badge-blue {
        background: var(--blue-bg);
        color: var(--blue);
    }

    .badge-amber {
        background: var(--amber-bg);
        color: var(--amber);
    }

    /* ── Empty State ── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 36px 24px;
        text-align: center;
        color: var(--muted);
        gap: 10px;
    }

    .empty-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: var(--fog);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 4px;
    }

        .empty-icon svg {
            width: 20px;
            height: 20px;
            stroke: #D1D5DB;
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .empty-title {
        font-family: var(--f-display);
        font-size: 0.9rem;
        font-weight: 700;
        color: #9CA3AF;
    }

    .empty-sub {
        font-size: 0.78rem;
    }

    /* ── Animations ── */
    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .hero-banner {
        animation: fadeUp 0.6s var(--ease) both;
    }

    .alert-banner {
        animation: fadeUp 0.5s var(--ease) 0.1s both;
    }

    .stats-grid {
        animation: fadeUp 0.6s var(--ease) 0.15s both;
    }

    .dash-grid {
        animation: fadeUp 0.6s var(--ease) 0.25s both;
    }

    /* ── Responsive ── */
    @@media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .dash-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .hero-banner {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
            padding: 24px 22px;
        }

        .hero-right {
            width: 100%;
            flex-wrap: wrap;
        }

        .hero-title {
            font-size: 1.4rem;
        }
    }
</style>

<!-- Hero Banner -->
<div class="hero-banner">
    <div class="hero-orb-1"></div>
    <div class="hero-orb-2"></div>
    <div class="hero-left">
        <div class="hero-eyebrow">
            <div class="eyebrow-dot"></div>
            Company Dashboard
        </div>
        <div class="hero-title">@Model.WelcomeMessage</div>
        <div class="hero-sub">@Model.CompanyName</div>
    </div>
    <div class="hero-right">
        <a href="@Url.Action("ViewProfile")" class="dbtn dbtn-outline">
            <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
            Company Profile
        </a>
        <a href="@Url.Action("EditProfile")" class="dbtn dbtn-white">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
            Edit Profile
        </a>
    </div>
</div>

<!-- Alert Banner -->
@if (Model.PendingRequestsCount > 0)
{
    <div class="alert-banner">
        <div class="alert-icon">🔔</div>
        <div class="alert-text">
            <div class="alert-title">@Model.PendingRequestsCount New Project Request@(Model.PendingRequestsCount != 1 ? "s" : "") Waiting</div>
            <div class="alert-sub">Respond promptly to improve your acceptance rate and ranking</div>
        </div>
        <a href="/teamrooms/Projects/CompanyIncomingRequests" class="alert-cta">
            View All →
        </a>
    </div>
}

<!-- Statistics Grid -->
<div class="stats-grid">
    <a href="/Company/Projects/CompanyProjects?status=all" class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>
        </div>
        <div class="stat-label">Total Projects</div>
        <div class="stat-value">@Model.TotalProjects</div>
        <div class="stat-hint">View All →</div>
    </a>

    <a href="/Company/Projects/CompanyProjects?status=active" class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
        </div>
        <div class="stat-label">Active</div>
        <div class="stat-value">@Model.ActiveProjects</div>
        <div class="stat-hint">In Progress →</div>
    </a>

    <a href="/Company/Projects/CompanyProjects?status=completed" class="stat-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
        </div>
        <div class="stat-label">Completed</div>
        <div class="stat-value">@Model.CompletedProjects</div>
        <div class="stat-hint">View History →</div>
    </a>

    <div class="stat-card green-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
        </div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">@Model.TotalRevenue.ToString("C0")</div>
        <div class="stat-hint">From Completed</div>
    </div>

    <div class="stat-card amber-card">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
        </div>
        <div class="stat-label">Avg Rating</div>
        <div class="stat-value">@Model.AverageRating.ToString("0.0")<span style="font-size:1rem;opacity:.6"> ★</span></div>
        <div class="stat-hint">Client Score</div>
    </div>
</div>

<!-- Main Grid -->
<div class="dash-grid">

    <!-- Incoming Requests -->
    <div class="dash-section">
        <div class="sect-head">
            <div class="sect-title-wrap">
                <div class="sect-icon si-amber">
                    <svg viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 010 8h-1" /><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z" /><line x1="6" y1="1" x2="6" y2="4" /><line x1="10" y1="1" x2="10" y2="4" /><line x1="14" y1="1" x2="14" y2="4" /></svg>
                </div>
                <span class="sect-title">Incoming Requests</span>
            </div>
            @if (Model.PendingRequestsCount > 5)
            {
                <a href="/teamrooms/Projects/CompanyIncomingRequests" class="sect-link">View All (@Model.PendingRequestsCount)</a>
            }
        </div>

        @if (Model.IncomingRequests.Any())
        {
            foreach (var request in Model.IncomingRequests)
            {
                <div class="req-card">
                    <div class="req-head">@request.ProjectName</div>
                    <div class="req-meta">
                        <strong>Client:</strong> @request.ClientName
                        @if (request.ClientBudget.HasValue)
                        {
                            <span class="proj-sep"></span>
                            <span><strong>Budget:</strong> @request.ClientBudget.Value.ToString("C0")</span>
                        }
                        @if (!string.IsNullOrEmpty(request.SelectedServiceName))
                        {
                            <span class="req-pill">@request.SelectedServiceName@(!string.IsNullOrEmpty(request.SelectedServiceTier) ? $" · {request.SelectedServiceTier}" : "")</span>
                        }
                    </div>
                    <div class="req-desc">@request.Description</div>
                    <div class="req-footer">
                        <span class="req-time">@request.TimeAgo</span>
                        <a href="/teamrooms/Projects/CompanyIncomingRequests" class="req-btn">
                            Respond
                            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                </div>
                <div class="empty-title">No pending requests</div>
                <span class="empty-sub">New client requests will appear here</span>
            </div>
        }
    </div>

    <!-- Recent Projects -->
    <div class="dash-section">
        <div class="sect-head">
            <div class="sect-title-wrap">
                <div class="sect-icon si-purple">
                    <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>
                </div>
                <span class="sect-title">Recent Projects</span>
            </div>
            <a href="/Company/Projects/CompanyProjects?status=all" class="sect-link">View All</a>
        </div>

        @if (Model.RecentProjects.Any())
        {
            foreach (var project in Model.RecentProjects)
            {
                <div class="proj-card">
                    <div class="proj-top">
                        <div class="proj-head">@project.ProjectName</div>
                        <span class="badge @(project.Status == "Completed" ? "badge-green" : project.Status == "Active" ? "badge-blue" : "badge-amber")">
                            @project.Status
                        </span>
                    </div>
                    <div class="proj-meta">
                        @project.ClientName
                        <span class="proj-sep"></span>
                        @project.Budget.ToString("C0")
                    </div>
                    <div class="proj-bar-wrap">
                        <div class="proj-bar">
                            <div class="proj-fill" style="width: @(project.ProgressPercentage)%"></div>
                        </div>
                        <span class="proj-pct">@project.ProgressPercentage%</span>
                    </div>
                    <a href="/TeamRooms/Projects/Details/@project.ProjectId" class="proj-link">
                        View Details
                        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>
                </div>
                <div class="empty-title">No projects yet</div>
                <span class="empty-sub">Accepted requests will show here</span>
            </div>
        }
    </div>

</div>
