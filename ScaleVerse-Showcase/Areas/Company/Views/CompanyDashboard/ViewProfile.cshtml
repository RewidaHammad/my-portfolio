@model ScalaVerse.ViewModel.Company_Dashboard_VM.CompanyProfileViewModel
@{
    ViewData["Title"] = "Company Profile";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-glow: rgba(124,58,237,0.25);
        --purple-soft: rgba(124,58,237,0.1);
        --white: #FFFFFF;
        --off: #F9FAFB;
        --fog: #F3F4F6;
        --border: #E5E7EB;
        --text: #111827;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 16px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 16px rgba(0,0,0,0.05);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.1);
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
    }

    /* ── Wrapper ── */
    .profile-wrap {
        max-width: 900px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Page Header ── */
    .page-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 28px;
        padding-top: 28px;
    }

    .page-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--purple);
        margin-bottom: 6px;
    }

    .eyebrow-line {
        width: 18px;
        height: 2px;
        background: var(--purple);
        border-radius: 2px;
    }

    .page-title {
        font-family: var(--f-display);
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
        line-height: 1.1;
    }

    .btn-group {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        border-radius: 10px;
        font-family: var(--f-body);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s var(--ease);
        border: 1.5px solid transparent;
        white-space: nowrap;
    }

        .btn svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .btn-purple {
        background: var(--purple);
        color: #fff;
        box-shadow: 0 4px 14px var(--purple-glow);
    }

        .btn-purple:hover {
            background: var(--purple-2);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px var(--purple-glow);
        }

    .btn-ghost {
        background: var(--white);
        color: var(--muted);
        border-color: var(--border);
    }

        .btn-ghost:hover {
            border-color: var(--purple);
            color: var(--purple);
            background: var(--purple-soft);
        }

    /* ── Success Message ── */
    .success-msg {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--green-bg);
        border: 1.5px solid rgba(5,150,105,0.25);
        border-left: 4px solid var(--green);
        border-radius: var(--radius);
        padding: 14px 20px;
        margin-bottom: 24px;
        color: #065F46;
        font-weight: 600;
        font-size: 0.875rem;
        animation: slideDown 0.4s var(--ease);
    }

    @@keyframes slideDown {
        from

    {
        opacity: 0;
        transform: translateY(-6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .success-msg svg {
        width: 18px;
        height: 18px;
        stroke: var(--green);
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    /* ── Hero Profile Card ── */
    .hero-profile-card {
        background: linear-gradient(135deg, #1a0a3e 0%, var(--purple-2) 50%, var(--purple) 100%);
        border-radius: 20px;
        padding: 36px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 28px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 48px rgba(124,58,237,0.35);
    }

        .hero-profile-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 36px 36px;
            mask-image: radial-gradient(ellipse 80% 100% at 20% 50%, black, transparent);
            pointer-events: none;
        }

    .hero-profile-orb {
        position: absolute;
        right: -40px;
        top: -60px;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: rgba(139,92,246,0.15);
        filter: blur(50px);
        pointer-events: none;
    }

    .profile-avatar-wrap {
        position: relative;
        z-index: 2;
        flex-shrink: 0;
    }

    .profile-avatar-img {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(255,255,255,0.2);
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
        display: block;
    }

    .profile-avatar-fallback {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
        border: 3px solid rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
    }

        .profile-avatar-fallback svg {
            width: 36px;
            height: 36px;
            stroke: rgba(255,255,255,0.5);
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .profile-hero-info {
        flex: 1;
        position: relative;
        z-index: 2;
    }

    .profile-hero-name {
        font-family: var(--f-display);
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 6px;
    }

    .profile-hero-meta {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .profile-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.55);
        font-weight: 500;
    }

        .profile-hero-tag svg {
            width: 12px;
            height: 12px;
            stroke: rgba(255,255,255,0.4);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .verified-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        background: rgba(5,150,105,0.2);
        border: 1px solid rgba(5,150,105,0.35);
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #6EE7B7;
        letter-spacing: 0.03em;
    }

    .pending-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        background: rgba(217,119,6,0.2);
        border: 1px solid rgba(217,119,6,0.35);
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #FCD34D;
    }

    .profile-hero-stats {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .phero-stat {
        text-align: left;
    }

    .phero-val {
        font-family: var(--f-display);
        font-size: 1.3rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #fff;
        line-height: 1;
    }

    .phero-label {
        font-size: 0.68rem;
        color: rgba(255,255,255,0.4);
        margin-top: 2px;
        font-weight: 500;
    }

    .phero-div {
        width: 1px;
        height: 36px;
        background: rgba(255,255,255,0.12);
    }

    /* ── Info Card ── */
    .info-card {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: 0;
        margin-bottom: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
        transition: box-shadow 0.3s var(--ease);
    }

        .info-card:hover {
            box-shadow: var(--shadow-md);
        }

    .card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1.5px solid var(--fog);
        background: var(--off);
    }

    .card-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--purple-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .card-icon svg {
            width: 15px;
            height: 15px;
            stroke: var(--purple);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .card-title {
        font-family: var(--f-display);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .card-body {
        padding: 4px 0;
    }

    /* ── Info Row ── */
    .info-row {
        display: grid;
        grid-template-columns: 200px 1fr;
        align-items: start;
        padding: 14px 24px;
        border-bottom: 1px solid var(--fog);
        transition: background 0.15s;
    }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row:hover {
            background: var(--off);
        }

    .info-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--muted);
        padding-top: 1px;
        letter-spacing: 0.01em;
    }

    .info-value {
        font-size: 0.875rem;
        color: var(--text);
        line-height: 1.5;
        word-break: break-word;
    }

        .info-value a {
            color: var(--purple);
            text-decoration: none;
            font-weight: 600;
        }

            .info-value a:hover {
                text-decoration: underline;
            }

    .info-empty {
        color: #C9CDD4;
        font-style: italic;
    }

    /* ── Badges ── */
    .verified-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        background: var(--green-bg);
        border: 1.5px solid rgba(5,150,105,0.2);
        color: var(--green);
        border-radius: 100px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .pending-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        background: var(--amber-bg);
        border: 1.5px solid rgba(217,119,6,0.2);
        color: var(--amber);
        border-radius: 100px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    /* ── Performance card ── */
    .perf-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .perf-cell {
        padding: 20px 24px;
        border-right: 1px solid var(--fog);
        border-bottom: 1px solid var(--fog);
    }

        .perf-cell:nth-child(2n) {
            border-right: none;
        }

        .perf-cell:nth-last-child(-n+2) {
            border-bottom: none;
        }

    .perf-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .perf-value {
        font-family: var(--f-display);
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
        line-height: 1;
    }

    .perf-sub {
        font-size: 0.73rem;
        color: var(--muted);
        margin-top: 4px;
    }

    /* ── Description Card ── */
    .desc-body {
        padding: 20px 24px;
        font-size: 0.875rem;
        color: var(--text);
        line-height: 1.75;
    }

    .desc-empty {
        color: #C9CDD4;
        font-style: italic;
    }

    /* ── Animations ── */
    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .hero-profile-card {
        animation: fadeUp 0.55s var(--ease) both;
    }

    .info-card {
        animation: fadeUp 0.5s var(--ease) both;
    }

        .info-card:nth-child(2) {
            animation-delay: 0.07s;
        }

        .info-card:nth-child(3) {
            animation-delay: 0.14s;
        }

        .info-card:nth-child(4) {
            animation-delay: 0.21s;
        }

        .info-card:nth-child(5) {
            animation-delay: 0.28s;
        }

        .info-card:nth-child(6) {
            animation-delay: 0.35s;
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .hero-profile-card {
            flex-direction: column;
            align-items: flex-start;
            padding: 24px 20px;
        }

        .info-row {
            grid-template-columns: 140px 1fr;
        }

        .perf-grid {
            grid-template-columns: 1fr;
        }

        .perf-cell {
            border-right: none;
        }

        .page-head {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-title {
            font-size: 1.6rem;
        }
    }

    @@media (max-width: 480px) {
        .info-row {
            grid-template-columns: 1fr;
            gap: 4px;
            padding: 12px 18px;
        }

        .info-label {
            font-size: 0.72rem;
        }
    }
</style>

<div class="profile-wrap">

    <!-- Page Header -->
    <div class="page-head">
        <div>
            <div class="page-eyebrow">
                <div class="eyebrow-line"></div>
                Company Settings
            </div>
            <h1 class="page-title">Company Profile</h1>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("EditProfile")" class="btn btn-purple">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                Edit Profile
            </a>
            <a href="@Url.Action("Index")" class="btn btn-ghost">
                <svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
                Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-msg">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Hero Profile Banner -->
    <div class="hero-profile-card">
        <div class="hero-profile-orb"></div>
        <div class="profile-avatar-wrap">
            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" alt="Company Logo" class="profile-avatar-img" />
            }
            else
            {
                <div class="profile-avatar-fallback">
                    <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
                </div>
            }
        </div>
        <div class="profile-hero-info">
            <div class="profile-hero-name">@Model.CompanyName</div>
            <div class="profile-hero-meta">
                @if (!string.IsNullOrEmpty(Model.Industry))
                {
                    <span class="profile-hero-tag">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        @Model.Industry
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.City) || !string.IsNullOrEmpty(Model.Country))
                {
                    <span class="profile-hero-tag">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        @(Model.City)@(!string.IsNullOrEmpty(Model.City) && !string.IsNullOrEmpty(Model.Country) ? ", " : "")@(Model.Country)
                    </span>
                }
                @if (Model.IsVerified)
                {
                    <span class="verified-pill">✓ Verified</span>
                }
                else
                {
                    <span class="pending-pill">⚠ Pending Verification</span>
                }
            </div>
            <div class="profile-hero-stats">
                <div class="phero-stat">
                    <div class="phero-val">@Model.AverageRating.ToString("0.0") ★</div>
                    <div class="phero-label">Avg Rating</div>
                </div>
                <div class="phero-div"></div>
                <div class="phero-stat">
                    <div class="phero-val">@Model.TotalReviews</div>
                    <div class="phero-label">Reviews</div>
                </div>
                <div class="phero-div"></div>
                <div class="phero-stat">
                    <div class="phero-val">@Model.CompletedProjects</div>
                    <div class="phero-label">Completed</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Manager Information -->
    <div class="info-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            </div>
            <span class="card-title">Manager Information</span>
        </div>
        <div class="card-body">
            <div class="info-row">
                <div class="info-label">Full Name</div>
                <div class="info-value">@Model.ManagerName</div>
            </div>
            <div class="info-row">
                <div class="info-label">Email Address</div>
                <div class="info-value">@Model.Email</div>
            </div>
            <div class="info-row">
                <div class="info-label">Phone Number</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        @Model.PhoneNumber
                    }
                    else
                    {
                        <span class="info-empty">Not provided</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Company Information -->
    <div class="info-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
            </div>
            <span class="card-title">Company Information</span>
        </div>
        <div class="card-body">
            <div class="info-row">
                <div class="info-label">Company Name</div>
                <div class="info-value">@Model.CompanyName</div>
            </div>
            <div class="info-row">
                <div class="info-label">Registration Number</div>
                <div class="info-value">@Model.RegistrationNumber</div>
            </div>
            <div class="info-row">
                <div class="info-label">Tax ID</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.TaxId))
                    {
                        @Model.TaxId
                    }
                    else
                    {
                        <span class="info-empty">Not provided</span>
                    }
                </div>
            </div>
            <div class="info-row">
                <div class="info-label">Industry</div>
                <div class="info-value">@Model.Industry</div>
            </div>
            <div class="info-row">
                <div class="info-label">Company Size</div>
                <div class="info-value">@Model.CompanySize</div>
            </div>
            <div class="info-row">
                <div class="info-label">Verification Status</div>
                <div class="info-value">
                    @if (Model.IsVerified)
                    {
                        <span class="verified-badge">✓ Verified</span>
                    }
                    else
                    {
                        <span class="pending-badge">⚠ Pending Verification</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Location & Contact -->
    <div class="info-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
            </div>
            <span class="card-title">Location &amp; Contact</span>
        </div>
        <div class="card-body">
            <div class="info-row">
                <div class="info-label">Address</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        @Model.Address
                    }
                    else
                    {
                        <span class="info-empty">Not provided</span>
                    }
                </div>
            </div>
            <div class="info-row">
                <div class="info-label">City</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.City))
                    {
                        @Model.City
                    }
                    else
                    {
                        <span class="info-empty">Not provided</span>
                    }
                </div>
            </div>
            <div class="info-row">
                <div class="info-label">Country</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.Country))
                    {
                        @Model.Country
                    }
                    else
                    {
                        <span class="info-empty">Not provided</span>
                    }
                </div>
            </div>
            <div class="info-row">
                <div class="info-label">Website</div>
                <div class="info-value">
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank" rel="noopener">@Model.Website ↗</a>
                    }
                    else
                    {
                        <span class="info-empty">Not provided</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="info-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" /></svg>
            </div>
            <span class="card-title">Description</span>
        </div>
        <div class="desc-body">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Model.Description
            }
            else
            {
                <span class="desc-empty">No description provided yet. Add one to attract more clients.</span>
            }
        </div>
    </div>

    <!-- Performance -->
    <div class="info-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" /></svg>
            </div>
            <span class="card-title">Performance</span>
        </div>
        <div class="perf-grid">
            <div class="perf-cell">
                <div class="perf-label">Average Rating</div>
                <div class="perf-value">@Model.AverageRating.ToString("0.0") ★</div>
                <div class="perf-sub">Based on @Model.TotalReviews review@(Model.TotalReviews != 1 ? "s" : "")</div>
            </div>
            <div class="perf-cell">
                <div class="perf-label">Completed Projects</div>
                <div class="perf-value">@Model.CompletedProjects</div>
                <div class="perf-sub">Successfully delivered</div>
            </div>
        </div>
    </div>

</div>
