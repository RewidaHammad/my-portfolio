@model Scalaverse.Entitys.Models.RegisteredCompany
@{
    ViewData["Title"] = "Company Registration Status";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-x-circle"></i> Company Registration - Under Review
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Status:</strong> Your company registration for <strong>@Model.CompanyName</strong> has been reviewed.
                    </div>

                    <h5>Feedback from Admin Team:</h5>
                    <div class="card mb-3">
                        <div class="card-body bg-light">
                            <p class="mb-0">@Model.RejectionReason</p>
                        </div>
                    </div>

                    @if (Model.ReapplicationAllowedDate.HasValue)
                    {
                        var daysUntilReapply = (Model.ReapplicationAllowedDate.Value - DateTime.UtcNow).Days;
                        
                        @if (daysUntilReapply > 0)
                        {
                            <div class="alert alert-info">
                                <h6>Reapplication Available:</h6>
                                <p class="mb-0">
                                    You may update your company information and request re-verification after
                                    <strong>@Model.ReapplicationAllowedDate.Value.ToString("MMMM dd, yyyy")</strong>
                                    (in <strong>@daysUntilReapply days</strong>).
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                <h6>You can now reapply!</h6>
                                <p class="mb-0">
                                    The waiting period has ended. You can update your company profile and request re-verification.
                                </p>
                                <a href="@Url.Action("EditProfile", "CompanyDashboard")" class="btn btn-success mt-2">
                                    Update Company Profile & Reapply
                                </a>
                            </div>
                        }
                    }

                    <hr />

                    <h6>Common Reasons for Review & How to Address Them:</h6>
                    <div class="accordion" id="helpAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                    Missing or Invalid Documentation
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    <small>
                                        Ensure you have uploaded valid:
                                        <ul>
                                            <li>Business registration certificate</li>
                                            <li>Tax identification documents</li>
                                            <li>Proof of business address</li>
                                        </ul>
                                        All documents must be current and clearly legible.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                    Incomplete Company Information
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    <small>
                                        Make sure your company profile includes:
                                        <ul>
                                            <li>Complete company description</li>
                                            <li>Services you offer</li>
                                            <li>Valid contact information</li>
                                            <li>Professional company logo</li>
                                        </ul>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                    Registration Number Mismatch
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                                <div class="accordion-body">
                                    <small>
                                        Verify that:
                                        <ul>
                                            <li>Your registration number matches official documents</li>
                                            <li>The company name is spelled exactly as registered</li>
                                            <li>Tax ID is accurate and up-to-date</li>
                                        </ul>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-secondary mt-3">
                        <small>
                            <strong>Need Help?</strong> If you have questions about the feedback or need clarification,
                            please contact our support team at <a href="mailto:support@scalaverse.com">support@scalaverse.com</a>
                        </small>
                    </div>

                    <div class="mt-4">
                        <a href="@Url.Action("ViewProfile", "CompanyDashboard")" class="btn btn-primary">View Company Profile</a>
                        
                        @if (Model.ReapplicationAllowedDate.HasValue && (Model.ReapplicationAllowedDate.Value - DateTime.UtcNow).Days <= 0)
                        {
                            <a href="@Url.Action("EditProfile", "CompanyDashboard")" class="btn btn-success">Update & Reapply</a>
                        }
                        else
                        {
                            <a href="@Url.Action("EditProfile", "CompanyDashboard")" class="btn btn-secondary">View/Edit Profile</a>
                        }
                    </div>
                </div>
                
                <div class="card-footer text-muted">
                    <small>
                        Reviewed on: @Model.RejectedAt?.ToString("MMMM dd, yyyy HH:mm") UTC
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bi-x-circle {
        font-size: 1.2rem;
    }
</style>