
@model ScalaVerse.ViewModel.Profile_VM.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-5: #EDE9FE;
        --white: #FFFFFF;
        --off: #F9FAFB;
        --border: #E5E7EB;
        --border-2: #F3F4F6;
        --text: #0F172A;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --red: #DC2626;
        --f-display: 'Plus Jakarta Sans',sans-serif;
        --f-body: 'Inter',sans-serif;
        --ease: cubic-bezier(0.16,1,0.3,1);
        --radius: 12px;
        --radius-lg: 16px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07),0 4px 12px rgba(0,0,0,0.04);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .vp-hero {
        background: var(--navy);
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .vp-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(ellipse 70% 80% at 100% 0%,rgba(124,58,237,0.18) 0%,transparent 60%);
        }

    .vp-grid-bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);
        background-size: 44px 44px;
    }

    .vp-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .vp-av {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        flex-shrink: 0;
        background: linear-gradient(135deg,var(--purple),var(--purple-3));
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--f-display);
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        box-shadow: 0 4px 16px rgba(124,58,237,0.4);
    }

    .vp-name {
        font-family: var(--f-display);
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.03em;
        margin-bottom: 4px;
    }

    .vp-role {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.4);
        margin-bottom: 8px;
    }

    .badge-v {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.68rem;
        font-weight: 700;
        color: #34D399;
        background: rgba(5,150,105,0.15);
        border: 1px solid rgba(5,150,105,0.25);
        padding: 3px 10px;
        border-radius: 100px;
    }

    .badge-p {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.68rem;
        font-weight: 700;
        color: #FCD34D;
        background: rgba(217,119,6,0.15);
        border: 1px solid rgba(217,119,6,0.25);
        padding: 3px 10px;
        border-radius: 100px;
    }

    .vp-actions {
        margin-left: auto;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--f-body);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: 10px;
        text-decoration: none;
        transition: all .2s;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .btn-purple {
        background: var(--purple);
        color: #fff;
        box-shadow: 0 4px 12px rgba(124,58,237,0.3);
    }

        .btn-purple:hover {
            background: var(--purple-2);
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-ghost-d {
        background: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.75);
        border-color: rgba(255,255,255,0.12);
    }

        .btn-ghost-d:hover {
            background: rgba(255,255,255,0.14);
            color: #fff;
        }

    .vp-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .vp-full {
        grid-column: 1/-1;
    }

    .vp-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 0;
    }

    .vp-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border-2);
        font-family: var(--f-display);
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
    }

        .vp-head i {
            color: var(--purple);
            font-size: 15px;
        }

    .vp-body {
        padding: 20px;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-2);
    }

        .info-row:first-child {
            padding-top: 0;
        }

        .info-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .info-lbl {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        min-width: 130px;
        padding-top: 2px;
        flex-shrink: 0;
    }

    .info-val {
        font-size: 0.87rem;
        color: var(--text-2);
        font-weight: 500;
        flex: 1;
        line-height: 1.5;
    }

        .info-val a {
            color: var(--purple);
            text-decoration: none;
        }

            .info-val a:hover {
                text-decoration: underline;
            }

    .success-msg {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--green-bg);
        border: 1px solid rgba(5,150,105,0.2);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--green);
    }

    @@media(max-width:900px) {
        .vp-grid {
            grid-template-columns: 1fr;
        }

        .vp-full {
            grid-column: 1;
        }

        .vp-actions {
            margin-left: 0;
            width: 100%;
        }

        .btn-a {
            flex: 1;
            justify-content: center;
        }
    }

    @@media(max-width:600px) {
        .info-row {
            flex-direction: column;
            gap: 4px;
        }

        .info-lbl {
            min-width: auto;
        }

        .vp-hero {
            padding: 20px;
        }

        .vp-name {
            font-size: 1.2rem;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-msg"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
}

<div class="vp-hero">
    <div class="vp-grid-bg"></div>
    <div class="vp-inner">
        <div class="vp-av">@(Model.FullName?.Substring(0, 1).ToUpper() ?? "C")</div>
        <div style="flex:1;min-width:0">
            <div class="vp-name">@Model.FullName</div>
            <div class="vp-role">Client@(!string.IsNullOrEmpty(Model.CompanyName) ? " · " + Model.CompanyName : "")</div>
            @if (Model.IsVerified)
            {
                <span class="badge-v"><i class="bi bi-patch-check-fill"></i> Verified</span>
            }
            else
            {

                <span class="badge-p"><i class="bi bi-clock-fill"></i> Pending</span>
            }
        </div>
        <div class="vp-actions">
            <a href="@Url.Action("EditProfile", "ClientDashboard", new { area = "Identity" })" class="btn-a btn-purple"><i class="bi bi-pencil-square"></i> Edit Profile</a>
            <a href="@Url.Action("Index", "ClientDashboard", new { area = "Identity" })" class="btn-a btn-ghost-d"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
    </div>
</div>

<div class="vp-grid">
    <!-- Personal -->
    <div class="vp-card">
        <div class="vp-head"><i class="bi bi-person-fill"></i> Personal Information</div>
        <div class="vp-body">
            <div class="info-row"><div class="info-lbl">Full Name</div><div class="info-val">@Model.FullName</div></div>
            <div class="info-row"><div class="info-lbl">Email</div><div class="info-val">@Model.Email</div></div>
            <div class="info-row"><div class="info-lbl">Phone</div><div class="info-val">@(Model.PhoneNumber ?? "Not provided")</div></div>
            <div class="info-row"><div class="info-lbl">Status</div><div class="info-val">@if(Model.IsVerified){
            <span class="badge-v"><i class="bi bi-patch-check-fill"></i> Verified</span>
                        }else
            {

                <span class="badge-p"><i class="bi bi-clock-fill"></i> Pending</span>
            }
</div></div>
        </div>
    </div>

    <!-- Company -->
    <div class="vp-card">
        <div class="vp-head"><i class="bi bi-building"></i> Company Information</div>
        <div class="vp-body">
            <div class="info-row"><div class="info-lbl">Company</div><div class="info-val">@(Model.CompanyName ?? "Not provided")</div></div>
            <div class="info-row"><div class="info-lbl">Industry</div><div class="info-val">@(Model.Industry ?? "Not provided")</div></div>
            <div class="info-row"><div class="info-lbl">Company Size</div><div class="info-val">@(Model.CompanySize ?? "Not provided")</div></div>
        </div>
    </div>

    <!-- Location -->
    <div class="vp-card">
        <div class="vp-head"><i class="bi bi-geo-alt-fill"></i> Location</div>
        <div class="vp-body">
            <div class="info-row"><div class="info-lbl">Address</div><div class="info-val">@(Model.Address ?? "Not provided")</div></div>
            <div class="info-row"><div class="info-lbl">City</div><div class="info-val">@(Model.City ?? "Not provided")</div></div>
            <div class="info-row"><div class="info-lbl">Country</div><div class="info-val">@(Model.Country ?? "Not provided")</div></div>
        </div>
    </div>

    <!-- Bio -->
    <div class="vp-card">
        <div class="vp-head"><i class="bi bi-file-person-fill"></i> Bio</div>
        <div class="vp-body">
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p style="font-size:.87rem;color:var(--text-2);line-height:1.7;">@Model.Bio</p>
            }
            else
            {

                <p style="font-size:.85rem;color:var(--muted);font-style:italic;">No bio yet. <a href="@Url.Action("EditProfile", "ClientDashboard", new { area = "Identity" })" style="color:var(--purple)">Add one →</a></p>
            }
        </div>
    </div>
</div>