
@using ScalaVerse.ViewModel
@using ScalaVerse.ViewModel.TeamRoom_VM
@model BookTeamRoomViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = $"Book {Model.TeamName}";
}

<style>
  :root{
    --navy:#0A0E1A;--purple:#7C3AED;--purple-2:#6D28D9;--purple-3:#8B5CF6;--purple-4:#A78BFA;
    --purple-soft:rgba(124,58,237,0.08);--purple-glow:rgba(124,58,237,0.2);
    --white:#FFFFFF;--off:#F8F9FC;--border:rgba(0,0,0,0.07);--border-2:rgba(0,0,0,0.1);
    --text:#0D1117;--text-2:#374151;--muted:#6B7280;--green:#059669;--red:#DC2626;
    --f-display:'Plus Jakarta Sans',sans-serif;--f-body:'Inter',sans-serif;
    --ease:cubic-bezier(0.16,1,0.3,1);--radius:16px;
    --shadow:0 4px 16px rgba(0,0,0,0.08),0 1px 4px rgba(0,0,0,0.04);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:var(--f-body);background:var(--off);-webkit-font-smoothing:antialiased;}

  .breadcrumb-wrap{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--muted);margin-bottom:24px;}
  .breadcrumb-wrap a{color:var(--muted);text-decoration:none;transition:color .15s;}
  .breadcrumb-wrap a:hover{color:var(--purple);}
  .breadcrumb-wrap i{font-size:10px;}
  .breadcrumb-wrap span{color:var(--text-2);font-weight:600;}

  .book-layout{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start;}

  /* Main form card */
  .form-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;}
  .form-card-head{background:linear-gradient(135deg,var(--navy),#1a1040);padding:24px 28px;position:relative;overflow:hidden;}
  .form-card-head::after{content:'';position:absolute;top:-40px;right:-20px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,0.2) 0%,transparent 65%);}
  .form-head-title{font-family:var(--f-display);font-size:1.3rem;font-weight:800;color:#fff;position:relative;z-index:2;}
  .form-head-sub{font-size:.82rem;color:rgba(255,255,255,0.4);margin-top:5px;position:relative;z-index:2;}
  .team-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(124,58,237,0.2);border:1px solid rgba(124,58,237,0.3);border-radius:8px;padding:5px 12px;margin-top:12px;font-size:.8rem;font-weight:700;color:var(--purple-4);position:relative;z-index:2;}
  .form-body{padding:28px;}

  .form-group{margin-bottom:20px;}
  .form-group:last-child{margin-bottom:0;}
  .form-lbl{display:block;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
  .req{color:var(--red);}
  .form-input,.form-textarea{width:100%;border:1.5px solid var(--border-2);border-radius:10px;background:var(--off);color:var(--text);font-family:var(--f-body);font-size:.88rem;font-weight:500;padding:11px 14px;outline:none;transition:all .2s;resize:none;}
  .form-input:focus,.form-textarea:focus{border-color:var(--purple);background:var(--white);box-shadow:0 0 0 3px var(--purple-soft);}
  .form-hint{font-size:.72rem;color:var(--muted);margin-top:5px;display:flex;align-items:center;gap:5px;}
  .form-error{font-size:.75rem;color:var(--red);margin-top:4px;}

  .milestone-toggle{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--off);border:1.5px solid var(--border-2);border-radius:10px;cursor:pointer;transition:all .2s;}
  .milestone-toggle:hover{border-color:var(--purple);background:var(--purple-soft);}
  .toggle-switch{width:40px;height:22px;border-radius:11px;background:var(--border-2);position:relative;transition:background .2s;flex-shrink:0;}
  .toggle-switch.on{background:var(--purple);}
  .toggle-knob{width:18px;height:18px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:transform .2s;box-shadow:0 1px 4px rgba(0,0,0,0.15);}
  .toggle-switch.on .toggle-knob{transform:translateX(18px);}
  .toggle-label{font-size:.85rem;font-weight:600;color:var(--text-2);}
  .toggle-sub{font-size:.72rem;color:var(--muted);margin-top:1px;}

  .btn-submit{width:100%;padding:14px;background:var(--purple);color:#fff;border:none;border-radius:11px;font-family:var(--f-body);font-size:.95rem;font-weight:700;cursor:pointer;transition:all .2s var(--ease);box-shadow:0 4px 14px var(--purple-glow);display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:10px;}
  .btn-submit:hover{background:var(--purple-2);transform:translateY(-1px);}
  .btn-back{width:100%;padding:11px;background:transparent;color:var(--muted);border:1.5px solid var(--border-2);border-radius:11px;font-family:var(--f-body);font-size:.88rem;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:6px;}
  .btn-back:hover{border-color:var(--purple);color:var(--purple);}

  /* Sidebar summary */
  .summary-card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;position:sticky;top:20px;}
  .summary-head{background:linear-gradient(135deg,var(--navy),#1a1040);padding:20px 24px;}
  .summary-title{font-family:var(--f-display);font-size:1rem;font-weight:800;color:#fff;}
  .summary-body{padding:20px;}
  .summary-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);}
  .summary-row:last-child{border-bottom:none;}
  .summary-lbl{font-size:.8rem;color:var(--muted);}
  .summary-val{font-size:.88rem;font-weight:700;color:var(--text);}
  .summary-val.rate{color:var(--purple);font-family:var(--f-display);font-size:1.1rem;}
  .info-box{margin-top:16px;padding:12px 14px;background:#EFF6FF;border:1px solid rgba(37,99,235,0.15);border-radius:10px;font-size:.78rem;color:#1D4ED8;line-height:1.5;display:flex;align-items:flex-start;gap:8px;}

  @@media(max-width:900px){.book-layout{grid-template-columns:1fr;}.summary-card{position:static;}}
</style>

<div class="breadcrumb-wrap">
  <a href="/">Home</a>
  <i class="bi bi-chevron-right"></i>
  <a href="@Url.Action("Index","TeamRooms",new{area="TeamRooms"})">Team Rooms</a>
  <i class="bi bi-chevron-right"></i>
  <a href="@Url.Action("Details","TeamRooms",new{area="TeamRooms",id=Model.TeamRoomId})">@Model.TeamName</a>
  <i class="bi bi-chevron-right"></i>
  <span>Book</span>
</div>

<div class="book-layout">

  <!-- Form -->
  <div class="form-card">
    <div class="form-card-head">
      <div class="form-head-title">Send Project Request</div>
      <div class="form-head-sub">Describe your project — the team will reply with a detailed proposal</div>
      <div class="team-badge"><i class="bi bi-people-fill"></i> @Model.TeamName</div>
    </div>
    <div class="form-body">
      <form asp-action="Book" asp-controller="TeamRooms" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="form-error" style="padding:12px 16px;background:#FEF2F2;border-radius:10px;border:1px solid rgba(220,38,38,0.2);margin-bottom:20px;"></div>
        <input type="hidden" asp-for="TeamRoomId" />

        <div class="form-group">
          <label class="form-lbl">Project Name <span class="req">*</span></label>
          <input asp-for="ProjectName" class="form-input" placeholder="e.g. E-commerce Website Redesign" />
          <span asp-validation-for="ProjectName" class="form-error"></span>
        </div>

        <div class="form-group">
          <label class="form-lbl">Project Description <span class="req">*</span></label>
          <textarea asp-for="ProjectDescription" class="form-textarea" rows="5"
            placeholder="Describe your project in detail — scope, goals, timeline, and any specific requirements…"></textarea>
          <span asp-validation-for="ProjectDescription" class="form-error"></span>
        </div>

        <input type="hidden" asp-for="SelectedAvailabilityId" value="0" />

        <div class="form-group">
          <label class="form-lbl">Your Budget ($) <span class="req">*</span></label>
          <input asp-for="Budget" type="number" class="form-input" placeholder="e.g. 5000" min="100" step="100" />
          <div class="form-hint"><i class="bi bi-info-circle"></i> This is your estimated budget. The team will propose a formal milestone-based plan.</div>
          <span asp-validation-for="Budget" class="form-error"></span>
        </div>

        <div class="form-group">
          <label class="form-lbl">Default Milestones</label>
          <label class="milestone-toggle" id="milestoneToggle" onclick="toggleMilestone()">
            <div class="toggle-switch" id="toggleSwitch"><div class="toggle-knob"></div></div>
            <input asp-for="CreateMilestones" type="checkbox" id="milestoneCheck" style="display:none" />
            <div>
              <div class="toggle-label">Auto-create default milestones</div>
              <div class="toggle-sub">3 equal milestones based on your budget</div>
            </div>
          </label>
        </div>

        <button type="submit" class="btn-submit"><i class="bi bi-send-fill"></i> Send Request</button>
        <a href="@Url.Action("Details","TeamRooms",new{area="TeamRooms",id=Model.TeamRoomId})" class="btn-back">
          <i class="bi bi-arrow-left"></i> Back to Team
        </a>
      </form>
    </div>
  </div>

  <!-- Summary -->
  <div class="summary-card">
    <div class="summary-head">
      <div class="summary-title">Booking Summary</div>
    </div>
    <div class="summary-body">
      <div class="summary-row">
        <div class="summary-lbl">Team</div>
        <div class="summary-val">@Model.TeamName</div>
      </div>
      <div class="summary-row">
        <div class="summary-lbl">Leader</div>
        <div class="summary-val">@Model.TeamLeaderName</div>
      </div>
      <div class="summary-row">
        <div class="summary-lbl">Hourly Rate</div>
        <div class="summary-val rate">$@Model.HourlyRate/hr</div>
      </div>
      @if (Model.ProjectRate.HasValue)
      {
        <div class="summary-row">
          <div class="summary-lbl">Project Rate</div>
          <div class="summary-val" style="color:var(--green)">$@Model.ProjectRate</div>
        </div>
      }
    </div>
    <div style="padding:0 20px 20px">
      <div class="info-box">
        <i class="bi bi-shield-check-fill" style="flex-shrink:0;margin-top:1px"></i>
        <div>Your request is reviewed by the team. They will send a proposal with milestones before any payment is required.</div>
      </div>
    </div>
  </div>

</div>

<script>
  var milestoneOn = false;
  function toggleMilestone() {
    milestoneOn = !milestoneOn;
    document.getElementById('toggleSwitch').classList.toggle('on', milestoneOn);
    document.getElementById('milestoneCheck').checked = milestoneOn;
  }
</script>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
