


@using ScalaVerse.ViewModel.TeamRoom_VM
@model TeamLeaderProfileViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Team Leader Profile";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-soft: rgba(124,58,237,0.08);
        --purple-glow: rgba(124,58,237,0.2);
        --white: #FFFFFF;
        --off: #F8F9FC;
        --border: rgba(0,0,0,0.07);
        --border-2: rgba(0,0,0,0.1);
        --text: #0D1117;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --red: #DC2626;
        --f-display: 'Plus Jakarta Sans',sans-serif;
        --f-body: 'Inter',sans-serif;
        --ease: cubic-bezier(0.16,1,0.3,1);
        --radius: 16px;
        --shadow: 0 4px 16px rgba(0,0,0,0.08),0 1px 4px rgba(0,0,0,0.04);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
        -webkit-font-smoothing: antialiased;
    }

    .profile-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 24px;
        align-items: start;
        max-width: 900px;
    }

    /* Form card */
    .form-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .form-card-head {
        background: linear-gradient(135deg,var(--navy),#1a1040);
        padding: 28px 32px;
        position: relative;
        overflow: hidden;
    }

        .form-card-head::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -30px;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(124,58,237,0.2) 0%,transparent 65%);
        }

        .form-card-head::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

    .avatar-wrap {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: linear-gradient(135deg,var(--purple),var(--purple-3));
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--f-display);
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 14px;
        position: relative;
        z-index: 2;
    }

    .head-title {
        font-family: var(--f-display);
        font-size: 1.3rem;
        font-weight: 800;
        color: #fff;
        position: relative;
        z-index: 2;
    }

    .head-sub {
        font-size: .82rem;
        color: rgba(255,255,255,0.4);
        margin-top: 5px;
        position: relative;
        z-index: 2;
    }

    .form-body {
        padding: 28px 32px;
    }

    .form-section-title {
        font-family: var(--f-display);
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--purple);
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group:last-child {
            margin-bottom: 0;
        }

    .form-lbl {
        display: block;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .form-input, .form-textarea {
        width: 100%;
        border: 1.5px solid var(--border-2);
        border-radius: 10px;
        background: var(--off);
        color: var(--text);
        font-family: var(--f-body);
        font-size: .88rem;
        font-weight: 500;
        padding: 11px 14px;
        outline: none;
        transition: all .2s;
        resize: none;
    }

        .form-input:focus, .form-textarea:focus {
            border-color: var(--purple);
            background: var(--white);
            box-shadow: 0 0 0 3px var(--purple-soft);
        }

    .form-error {
        font-size: .75rem;
        color: var(--red);
        margin-top: 4px;
    }

    .char-count {
        font-size: .7rem;
        color: var(--muted);
        text-align: right;
        margin-top: 3px;
    }

    .divider {
        height: 1px;
        background: var(--border);
        margin: 24px 0;
    }

    .btn-save {
        width: 100%;
        padding: 13px;
        background: var(--purple);
        color: #fff;
        border: none;
        border-radius: 11px;
        font-family: var(--f-body);
        font-size: .92rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s var(--ease);
        box-shadow: 0 4px 14px var(--purple-glow);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-save:hover {
            background: var(--purple-2);
            transform: translateY(-1px);
        }

    /* Sidebar */
    .sidebar-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        position: sticky;
        top: 20px;
    }

    .sidebar-head {
        background: linear-gradient(135deg,#0f1520,#1a1040);
        padding: 20px 24px;
    }

    .sidebar-title {
        font-family: var(--f-display);
        font-size: .95rem;
        font-weight: 800;
        color: #fff;
    }

    .sidebar-body {
        padding: 20px;
    }

    .preview-av {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg,var(--purple),var(--purple-3));
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--f-display);
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        margin: 0 auto 14px;
    }

    .preview-name {
        font-family: var(--f-display);
        font-size: 1rem;
        font-weight: 800;
        color: var(--text);
        text-align: center;
        margin-bottom: 4px;
    }

    .preview-sub {
        font-size: .75rem;
        color: var(--muted);
        text-align: center;
        margin-bottom: 16px;
    }

    .preview-divider {
        height: 1px;
        background: var(--border);
        margin-bottom: 14px;
    }

    .preview-field {
        margin-bottom: 12px;
    }

    .preview-lbl {
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--muted);
        margin-bottom: 3px;
    }

    .preview-val {
        font-size: .8rem;
        color: var(--text-2);
    }

    .progress-wrap {
        margin-top: 16px;
        padding: 14px;
        background: var(--off);
        border-radius: 10px;
        border: 1px solid var(--border);
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        font-size: .72rem;
        font-weight: 600;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .progress-bar {
        height: 6px;
        background: var(--border-2);
        border-radius: 3px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg,var(--purple),var(--purple-3));
        border-radius: 3px;
        transition: width .3s;
    }

    @@media(max-width:800px) {
        .profile-layout {
            grid-template-columns: 1fr;
        }

        .sidebar-card {
            position: static;
        }
    }
</style>

<div class="profile-layout">

    <!-- Form -->
    <div class="form-card">
        <div class="form-card-head">
            <div class="avatar-wrap">
                @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "T")
            </div>
            <div class="head-title">Team Leader Profile</div>
            <div class="head-sub">Complete your profile to increase visibility and attract more clients</div>
        </div>
        <div class="form-body">
            <form asp-action="TeamLeaderProfile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="form-error" style="padding:12px 16px;background:#FEF2F2;border-radius:10px;border:1px solid rgba(220,38,38,0.2);margin-bottom:20px;"></div>

                <!-- Bio -->
                <div class="form-section-title">About You</div>
                <div class="form-group">
                    <label class="form-lbl">Bio</label>
                    <textarea asp-for="Bio" class="form-textarea" rows="4" id="bioTextarea"
                              placeholder="Tell clients about yourself — your background, what you love building, and what makes your team unique…"
                              oninput="updatePreview();countChars(this,'bioCount',400)"></textarea>
                    <div class="char-count"><span id="bioCount">0</span>/400</div>
                    <span asp-validation-for="Bio" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label class="form-lbl">Expertise Areas</label>
                    <input asp-for="ExpertiseAreas" class="form-input" id="expertiseInput"
                           placeholder="e.g. Web Development, Mobile Apps, Cloud Architecture, UI/UX"
                           oninput="updatePreview()" />
                    <span asp-validation-for="ExpertiseAreas" class="form-error"></span>
                </div>

                <div class="divider"></div>

                <!-- Experience -->
                <div class="form-section-title">Experience</div>
                <div class="form-group">
                    <label class="form-lbl">Years of Experience</label>
                    <input asp-for="YearsOfExperience" type="number" class="form-input" placeholder="e.g. 5" min="0" max="50" oninput="updatePreview()" />
                    <span asp-validation-for="YearsOfExperience" class="form-error"></span>
                </div>

                <div class="divider"></div>

                <!-- Portfolio -->
                <div class="form-section-title">Portfolio & Links</div>
                <div class="form-group">
                    <label class="form-lbl">Portfolio URL</label>
                    <input asp-for="PortfolioUrl" class="form-input" placeholder="https://yourportfolio.com" type="url" />
                    <span asp-validation-for="PortfolioUrl" class="form-error"></span>
                </div>

                <div style="margin-top:28px">
                    <button type="submit" class="btn-save"><i class="bi bi-check-circle-fill"></i> Save Profile</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Sidebar Preview -->
    <div class="sidebar-card">
        <div class="sidebar-head">
            <div class="sidebar-title">Profile Preview</div>
        </div>
        <div class="sidebar-body">
            <div class="preview-av">@(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "T")</div>
            <div class="preview-name">@(User.Identity?.Name?.Split('@')[0] ?? "Your Name")</div>
            <div class="preview-sub" id="previewSub">Team Leader · 0 years experience</div>
            <div class="preview-divider"></div>
            <div class="preview-field">
                <div class="preview-lbl">Bio</div>
                <div class="preview-val" id="previewBio" style="color:var(--muted);font-style:italic">Not filled yet</div>
            </div>
            <div class="preview-field">
                <div class="preview-lbl">Expertise</div>
                <div class="preview-val" id="previewExpertise" style="color:var(--muted);font-style:italic">Not filled yet</div>
            </div>
            <div class="progress-wrap">
                <div class="progress-label"><span>Profile Completeness</span><span id="progressPct">0%</span></div>
                <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
            </div>
        </div>
    </div>

</div>

<script>
    function countChars(el, countId, max) {
      var n = el.value.length;
      document.getElementById(countId).textContent = n;
      document.getElementById(countId).style.color = n > max * 0.9 ? '#DC2626' : '';
    }

    function updatePreview() {
      var bio = document.getElementById('bioTextarea')?.value.trim() || '';
      var exp = document.getElementById('expertiseInput')?.value.trim() || '';
      var yrs = document.querySelector('input[name="YearsOfExperience"]')?.value || '0';

      var bioEl = document.getElementById('previewBio');
      if (bio) { bioEl.textContent = bio.length > 100 ? bio.substring(0,100)+'…' : bio; bioEl.style.fontStyle='normal'; bioEl.style.color=''; }
      else { bioEl.textContent = 'Not filled yet'; bioEl.style.fontStyle='italic'; bioEl.style.color='var(--muted)'; }

      var expEl = document.getElementById('previewExpertise');
      if (exp) { expEl.textContent = exp; expEl.style.fontStyle='normal'; expEl.style.color=''; }
      else { expEl.textContent = 'Not filled yet'; expEl.style.fontStyle='italic'; expEl.style.color='var(--muted)'; }

      document.getElementById('previewSub').textContent = 'Team Leader · ' + yrs + ' years experience';

      var filled = [bio, exp, yrs && yrs !== '0'].filter(Boolean).length;
      var pct = Math.round((filled / 3) * 100);
      document.getElementById('progressFill').style.width = pct + '%';
      document.getElementById('progressPct').textContent = pct + '%';
    }

    // Init on load
    updatePreview();
    var bioTA = document.getElementById('bioTextarea');
    if (bioTA) countChars(bioTA, 'bioCount', 400);
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
