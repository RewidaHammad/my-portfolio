@using Scalaverse.Entities.Models
@using Scalaverse.Entitys.Models
@model IEnumerable<ProjectRequest>

@{
    ViewData["Title"] = "Incoming Requests";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Incoming Requests — ScaleVerse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        :root {
            --primary: #7F77DD;
            --primary-dark: #534AB7;
            --primary-light: #EEEDFE;
            --success: #1D9E75;
            --success-light: #E1F5EE;
            --warning: #BA7517;
            --warning-light: #FAEEDA;
            --danger: #E24B4A;
            --danger-light: #FCEBEB;
            --info: #378ADD;
            --info-light: #E6F1FB;
            --gold: #b07d00;
            --gold-light: #fdf3d0;
            --gray: #888780;
            --gray-light: #F1EFE8;
            --text: #1a1a2e;
            --text-muted: #6b6b80;
            --text-light: #9898a8;
            --bg: #f8f8fc;
            --card-bg: #fff;
            --border: #e8e8f0;
            --border-sub: #f2f2f8;
            --radius: 12px;
            --radius-sm: 8px;
            --radius-pill: 999px;
            --shadow: 0 2px 12px rgba(127,119,221,0.08);
            --shadow-hover: 0 8px 32px rgba(127,119,221,0.18);
            --font: 'Plus Jakarta Sans',sans-serif;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh
        }

        /* ── NAV ── */
        nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(26,26,46,0.97);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.06)
        }

        .nav-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none
        }

        .nav-logo-icon {
            width: 32px;
            height: 32px;
            background: var(--primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center
        }

            .nav-logo-icon svg {
                width: 18px;
                height: 18px;
                stroke: #fff;
                stroke-width: 2;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round
            }

        .nav-logo-text {
            font-size: 18px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.3px
        }

            .nav-logo-text span {
                color: var(--primary)
            }

        .nav-links {
            display: flex;
            gap: 28px;
            list-style: none
        }

            .nav-links a {
                color: rgba(255,255,255,0.72);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: color .2s
            }

                .nav-links a:hover, .nav-links a.active-link {
                    color: #fff
                }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px
        }

        .nav-login {
            color: rgba(255,255,255,0.72);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500
        }

        .nav-btn {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 8px 18px;
            border-radius: var(--radius-pill);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            font-family: var(--font);
            transition: background .2s;
            text-decoration: none;
            display: inline-block
        }

            .nav-btn:hover {
                background: var(--primary-dark)
            }

        /* ── PAGE HEADER ── */
        .page-header {
            background: linear-gradient(135deg,#1a1a2e 0%,#2d2b5c 60%,#1a2a4a 100%);
            padding: 60px 24px 0;
            position: relative;
            overflow: hidden
        }

            .page-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 80% 120% at 70% -20%,rgba(127,119,221,0.22),transparent);
                pointer-events: none
            }

        .ph-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
            position: relative;
            padding-bottom: 40px
        }

        .ph-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(127,119,221,0.18);
            border: 1px solid rgba(127,119,221,0.35);
            border-radius: var(--radius-pill);
            padding: 5px 14px;
            font-size: 12px;
            font-weight: 600;
            color: #C4B5FD;
            letter-spacing: .5px;
            margin-bottom: 16px
        }

        .pill-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #a78bfa;
            animation: pdot 2s infinite
        }
        @@keyframes pdot {
            0%, 100% {
                opacity: 1;
                transform: scale(1)
            }

            50% {
                opacity: .6;
                transform: scale(.85)
            }
        }

        .ph-title {
            font-size: clamp(26px,4vw,40px);
            font-weight: 800;
            color: #fff;
            line-height: 1.15;
            letter-spacing: -1px
        }

            .ph-title .grad {
                background: linear-gradient(90deg,#a78bfa,#60a5fa);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent
            }

        .ph-sub {
            color: rgba(255,255,255,0.6);
            font-size: 15px;
            margin-top: 8px
        }

        .company-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(253,243,208,0.15);
            border: 1px solid rgba(240,208,112,0.4);
            border-radius: var(--radius-pill);
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 700;
            color: #FAC775;
            margin-left: 10px
        }

        .pending-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--danger-light);
            color: var(--danger);
            padding: 8px 18px;
            border-radius: var(--radius-pill);
            font-size: 13px;
            font-weight: 700;
            align-self: flex-end
        }

            .pending-badge svg {
                width: 14px;
                height: 14px;
                fill: currentColor
            }

        /* ── STATS BAR ── */
        .stats-bar {
            background: rgba(255,255,255,0.04);
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 20px 24px
        }

        .stats-bar-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            gap: 36px;
            flex-wrap: wrap
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .stat-icon {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center
        }

            .stat-icon svg {
                width: 16px;
                height: 16px;
                stroke-width: 2;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round
            }

        .si-red {
            background: var(--danger-light)
        }

            .si-red svg {
                stroke: var(--danger)
            }

        .si-green {
            background: var(--success-light)
        }

            .si-green svg {
                stroke: var(--success)
            }

        .si-amber {
            background: var(--warning-light)
        }

            .si-amber svg {
                stroke: var(--warning)
            }

        .si-purple {
            background: var(--primary-light)
        }

            .si-purple svg {
                stroke: var(--primary-dark)
            }

        .stat-val {
            font-size: 20px;
            font-weight: 800;
            color: #fff
        }

        .stat-lbl {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            font-weight: 500;
            letter-spacing: .3px;
            margin-top: 1px
        }

        /* ── MAIN ── */
        .main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 36px 24px 80px
        }

        /* ── REQUEST CARD ── */
        .req-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            border: 1.5px solid var(--border);
            margin-bottom: 20px;
            overflow: hidden;
            transition: transform .25s,box-shadow .25s,border-color .25s;
            position: relative
        }

            .req-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                border-radius: var(--radius) var(--radius) 0 0;
                background: var(--primary)
            }

            .req-card.is-new::before {
                background: var(--danger);
                animation: newglow 2s infinite
            }
        @@keyframes newglow {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .5
            }
        }

        .req-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: rgba(127,119,221,0.3)
        }

        .req-header {
            padding: 22px 26px 16px
        }

        .req-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px
        }

        .req-title {
            font-size: 18px;
            font-weight: 800;
            color: var(--text);
            margin: 0 0 10px;
            letter-spacing: -0.3px
        }

        .new-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--danger-light);
            color: var(--danger);
            border-radius: var(--radius-pill);
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 700;
            animation: newpulse 1.5s infinite
        }
        ِ@@keyframes newpulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .5
            }
        }

        .new-badge svg {
            width: 11px;
            height: 11px;
            fill: currentColor
        }

        .client-row {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .client-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--primary-light);
            color: var(--primary-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 15px;
            flex-shrink: 0
        }

        .client-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--text)
        }

        .client-email {
            font-size: 12px;
            color: var(--text-light)
        }

        .req-meta {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 12px
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            color: var(--text-muted)
        }

            .meta-item svg {
                width: 13px;
                height: 13px;
                stroke: currentColor;
                stroke-width: 2;
                fill: none;
                flex-shrink: 0
            }

            .meta-item strong {
                color: var(--text);
                font-weight: 700
            }

        .service-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: var(--radius-sm);
            font-size: 12px;
            font-weight: 700;
            background: var(--gold-light);
            color: var(--gold);
            border: 1px solid #f0d070
        }

            .service-tag svg {
                width: 12px;
                height: 12px;
                fill: currentColor
            }

        .req-desc {
            padding: 14px 26px;
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.65;
            border-top: 1px solid var(--border-sub);
            border-bottom: 1px solid var(--border-sub)
        }

        .req-desc-inner {
            display: flex;
            gap: 8px;
            align-items: flex-start
        }

            .req-desc-inner svg {
                width: 15px;
                height: 15px;
                stroke: var(--text-light);
                stroke-width: 2;
                fill: none;
                flex-shrink: 0;
                margin-top: 2px
            }

        .req-footer {
            padding: 14px 26px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px
        }

        .req-id {
            font-size: 12px;
            color: var(--text-light);
            font-weight: 500
        }

        .btn-group {
            display: flex;
            gap: 8px
        }

        /* ── BUTTONS ── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 18px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            border: 1.5px solid transparent;
            font-family: var(--font);
            transition: all .18s;
            text-decoration: none
        }

            .btn svg {
                width: 14px;
                height: 14px;
                stroke: currentColor;
                stroke-width: 2;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round
            }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary)
        }

            .btn-primary:hover {
                background: var(--primary-dark)
            }

        .btn-danger {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger)
        }

            .btn-danger:hover {
                background: #a32d2d
            }

            .btn-danger svg {
                stroke: none;
                fill: #fff
            }

        .btn-outline {
            background: transparent;
            color: var(--text-muted);
            border-color: var(--border)
        }

            .btn-outline:hover {
                background: var(--gray-light);
                border-color: var(--primary);
                color: var(--primary)
            }

        .btn:disabled {
            opacity: .5;
            cursor: not-allowed
        }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 80px 24px;
            background: var(--card-bg);
            border-radius: var(--radius);
            border: 1.5px solid var(--border)
        }

        .empty-icon {
            width: 80px;
            height: 80px;
            background: var(--primary-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px
        }

            .empty-icon svg {
                width: 36px;
                height: 36px;
                stroke: var(--primary);
                stroke-width: 1.5;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round
            }

        .empty-title {
            font-size: 22px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 8px
        }

        .empty-sub {
            font-size: 14px;
            color: var(--text-muted)
        }

        /* ── MODAL ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10,10,30,0.55);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 16px
        }

            .modal-overlay.open {
                display: flex
            }

        .modal-box {
            background: var(--card-bg);
            border-radius: 16px;
            border: 1.5px solid var(--border);
            width: 100%;
            max-width: 680px;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 24px 64px rgba(0,0,0,0.22)
        }

        .modal-head {
            padding: 20px 26px;
            border-bottom: 1px solid var(--border-sub);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0
        }

        .modal-head-title {
            font-size: 16px;
            font-weight: 800;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 8px
        }

            .modal-head-title svg {
                width: 18px;
                height: 18px;
                stroke: var(--primary);
                stroke-width: 2;
                fill: none
            }

        .modal-head-sub {
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 400;
            margin-left: 4px
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--gray-light);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: var(--text-muted);
            transition: background .15s;
            flex-shrink: 0
        }

            .modal-close:hover {
                background: #f0d0d0;
                color: var(--danger)
            }

        .modal-body {
            padding: 22px 26px;
            overflow-y: auto;
            flex: 1
        }

        .modal-foot {
            padding: 16px 26px;
            border-top: 1px solid var(--border-sub);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0
        }

        /* ── FORM ── */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 16px
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
            display: block
        }

        .form-req {
            color: var(--danger);
            margin-left: 2px
        }

        .form-control {
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 9px 12px;
            font-size: 14px;
            font-family: var(--font);
            outline: none;
            width: 100%;
            transition: border-color .15s;
            color: var(--text);
            background: var(--card-bg)
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(127,119,221,0.12)
            }

        .form-hint {
            font-size: 11px;
            color: var(--text-light);
            margin-top: 4px
        }

        .form-group {
            margin-bottom: 16px
        }

        .service-ref-box {
            display: none;
            background: var(--gold-light);
            border: 1px solid #f0d070;
            border-radius: var(--radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            margin-bottom: 16px;
            color: var(--gold);
            font-weight: 600;
            align-items: center;
            gap: 8px
        }

            .service-ref-box svg {
                width: 14px;
                height: 14px;
                fill: var(--gold);
                flex-shrink: 0
            }

            .service-ref-box.show {
                display: flex
            }

        /* ── MILESTONE BUILDER ── */
        .ms-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px
        }

        .ms-header-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text)
        }

        .ms-add-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 14px;
            border-radius: var(--radius-sm);
            font-size: 12px;
            font-weight: 700;
            background: transparent;
            border: 1.5px solid var(--border);
            color: var(--text-muted);
            cursor: pointer;
            font-family: var(--font);
            transition: all .15s
        }

            .ms-add-btn:hover {
                border-color: var(--primary);
                color: var(--primary)
            }

            .ms-add-btn svg {
                width: 13px;
                height: 13px;
                stroke: currentColor;
                stroke-width: 2.5;
                fill: none
            }

        .ms-builder {
            display: flex;
            flex-direction: column;
            gap: 10px
        }

        .ms-row {
            border: 1.5px solid var(--border-sub);
            border-radius: var(--radius-sm);
            padding: 16px;
            background: var(--bg)
        }

        .ms-row-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px
        }

        .ms-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800
        }

        .ms-label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin-left: 8px
        }

        .ms-remove {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--danger);
            display: flex;
            align-items: center;
            padding: 4px;
            border-radius: 6px;
            transition: background .15s
        }

            .ms-remove:hover {
                background: var(--danger-light)
            }

            .ms-remove svg {
                width: 15px;
                height: 15px;
                stroke: currentColor;
                stroke-width: 2;
                fill: none
            }

        .ms-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px
        }

        .budget-summary {
            background: var(--primary-light);
            border-radius: var(--radius-sm);
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
            border: 1px solid rgba(127,119,221,0.2)
        }

        .budget-total-val {
            font-size: 20px;
            font-weight: 800;
            color: var(--primary-dark)
        }

        .budget-total-lbl {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 2px
        }

        .budget-ok {
            color: var(--success);
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 5px
        }

            .budget-ok svg {
                width: 15px;
                height: 15px;
                fill: var(--success)
            }

        .budget-bad {
            color: var(--danger);
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 5px
        }

            .budget-bad svg {
                width: 15px;
                height: 15px;
                fill: var(--danger)
            }

        /* TOAST */
        .sv-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 13px 20px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            box-shadow: 0 4px 20px rgba(0,0,0,.2);
            z-index: 9999;
            max-width: 320px;
            transition: opacity .3s;
            font-family: var(--font)
        }

        /* ── RESPONSIVE ── */
        @@media(max - width:768px) {
            .nav-links, .nav-login {
                display: none
            }

            .ph-inner {
                flex-direction: column;
                align-items: flex-start
            }

            .stats-bar-inner {
                gap: 20px
            }

            .form-grid, .ms-grid {
                grid-template-columns: 1fr
            }

            .req-footer {
                flex-direction: column;
                align-items: flex-start
            }

            .btn-group {
                width: 100%
            }

                .btn-group .btn {
                    flex: 1;
                    justify-content: center
                }
        }
        @@media(max - width:480px) {
            .req-header {
                padding: 16px
            }

            .req-footer {
                padding: 12px 16px
            }

            .modal-body {
                padding: 16px
            }

            .modal-head, .modal-foot {
                padding: 14px 16px
            }
        }
    </style>
</head>
<body>

    @Html.AntiForgeryToken()

    <!-- ══════ NAV ══════ -->
    <nav>
        <div class="nav-inner">
            <a href="/" class="nav-logo">
                <div class="nav-logo-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                </div>
                <span class="nav-logo-text">Scale<span>Verse</span></span>
            </a>
            <ul class="nav-links">
                <li><a href="#">Dashboard</a></li>
                <li><a href="#" class="active-link">Requests</a></li>
                <li><a href="#">Projects</a></li>
            </ul>
            <div class="nav-right">
                <a href="#" class="nav-login">My Account</a>
            </div>
        </div>
    </nav>

    <!-- ══════ PAGE HEADER ══════ -->
    <div class="page-header">
        <div class="ph-inner">
            <div>
                <div class="ph-pill">
                    <span class="pill-dot"></span>
                    Company Dashboard
                </div>
                <h1 class="ph-title">
                    Incoming <span class="grad">Requests</span>
                    @if (ViewBag.CompanyName != null)
                    {
                        <span class="company-tag">
                            <svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:currentColor;stroke-width:2;fill:none"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
                            @ViewBag.CompanyName
                        </span>
                    }
                </h1>
                <p class="ph-sub">Review client requests and send professional proposals</p>
            </div>

            @if (Model.Any())
            {
                <div class="pending-badge">
                    <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" /></svg>
                    @Model.Count() pending
                </div>
            }
        </div>

        @if (Model.Any())
        {
            var totalBudget = Model.Where(r => r.ClientBudget.HasValue).Sum(r => r.ClientBudget!.Value);
            var newCount = Model.Count(r => (DateTime.UtcNow - r.CreatedAt).TotalHours < 24);
            var budgetCount = Model.Count(r => r.ClientBudget.HasValue);

            <div class="stats-bar">
                <div class="stats-bar-inner">
                    <div class="stat-item">
                        <div class="stat-icon si-red">
                            <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z" /></svg>
                        </div>
                        <div>
                            <div class="stat-val">@Model.Count()</div>
                            <div class="stat-lbl">TOTAL REQUESTS</div>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-icon si-red">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        </div>
                        <div>
                            <div class="stat-val">@newCount</div>
                            <div class="stat-lbl">NEW TODAY</div>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-icon si-amber">
                            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
                        </div>
                        <div>
                            <div class="stat-val">$@totalBudget.ToString("N0")</div>
                            <div class="stat-lbl">TOTAL BUDGET</div>
                        </div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-icon si-green">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                        </div>
                        <div>
                            <div class="stat-val">@budgetCount</div>
                            <div class="stat-lbl">WITH BUDGET</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ══════ MAIN ══════ -->
    <div class="main">

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                </div>
                <h3 class="empty-title">No incoming requests</h3>
                <p class="empty-sub">When clients send requests to your company, they'll appear here</p>
            </div>
        }
        else
        {
            @foreach (var req in Model)
            {
                var initial = req.Client?.User?.FullName?.Substring(0, 1).ToUpper() ?? "C";
                var isNew = (DateTime.UtcNow - req.CreatedAt).TotalHours < 24;

                <div class="req-card @(isNew ? "is-new" : "")">

                    <!-- HEADER -->
                    <div class="req-header">
                        <div class="req-top">
                            <div style="flex:1">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap">
                                    <h3 class="req-title">@req.ProjectName</h3>
                                    @if (isNew)
                                    {
                                        <span class="new-badge">
                                            <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                                            NEW
                                        </span>
                                    }
                                </div>
                                <div class="client-row">
                                    <div class="client-avatar">@initial</div>
                                    <div>
                                        <div class="client-name">@req.Client?.User?.FullName</div>
                                        <div class="client-email">@req.Client?.User?.Email</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="req-meta">
                            <div class="meta-item">
                                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                                <strong>@req.CreatedAt.ToString("MMM dd, yyyy — HH:mm")</strong>
                            </div>
                            @if (req.ClientBudget.HasValue)
                            {
                                <div class="meta-item">
                                    <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
                                    Budget: <strong>$@req.ClientBudget.Value.ToString("N0")</strong>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(req.Category))
                            {
                                <div class="meta-item">
                                    <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" /></svg>
                                    <strong>@req.Category</strong>
                                </div>
                            }
                            @if (req.SelectedService != null)
                            {
                                <span class="service-tag">
                                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                    @req.SelectedService.ServiceName — @req.SelectedServiceTier
                                </span>
                            }
                        </div>
                    </div>

                    <!-- DESCRIPTION -->
                    @if (!string.IsNullOrWhiteSpace(req.Description))
                    {
                        <div class="req-desc">
                            <div class="req-desc-inner">
                                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg>
                                <span>@req.Description</span>
                            </div>
                        </div>
                    }

                    <!-- FOOTER -->
                    <div class="req-footer">
                        <span class="req-id">Request #@req.RequestId</span>
                        <div class="btn-group">
                            <button class="btn btn-danger" onclick="declineRequest(@req.RequestId)">
                                <svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:#fff;stroke-width:2.5;fill:none"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                Decline
                            </button>
                            <button class="btn btn-primary"
                                    onclick="openProposalModal(@req.RequestId,'@Html.Raw(req.ProjectName.Replace("'", "\\'"))',@(req.ClientBudget ?? 0),'@Html.Raw((req.SelectedService?.ServiceName ?? "").Replace("'", "\\'"))')">
                                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                Send Proposal
                            </button>
                        </div>
                    </div>

                </div>
            }
        }

    </div>

    <!-- ══════ PROPOSAL MODAL ══════ -->
    <div class="modal-overlay" id="proposalOverlay" onclick="handleOverlayClick(event)">
        <div class="modal-box">

            <div class="modal-head">
                <div class="modal-head-title">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                    Send Proposal
                    <span class="modal-head-sub" id="modalProjectName"></span>
                </div>
                <button class="modal-close" onclick="closeModal()">✕</button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="proposalRequestId">

                <div class="service-ref-box" id="serviceRefBox">
                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                    Based on service: <strong id="serviceRefName"></strong>
                </div>

                <div class="form-grid">
                    <div>
                        <label class="form-label">Proposed Budget ($)<span class="form-req">*</span></label>
                        <input type="number" class="form-control" id="proposedBudget" placeholder="e.g. 15000" min="1" oninput="updateBudgetCheck()">
                        <div class="form-hint">Client budget: $<span id="clientBudgetHint">—</span></div>
                    </div>
                    <div>
                        <label class="form-label">Estimated End Date<span class="form-req">*</span></label>
                        <input type="date" class="form-control" id="estimatedEndDate" min="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Proposal Note</label>
                    <textarea class="form-control" id="proposalNote" rows="3" placeholder="Describe your approach, methodology, and why your company is the best fit…"></textarea>
                </div>

                <div class="ms-header">
                    <span class="ms-header-label">Project Milestones<span class="form-req">*</span></span>
                    <button type="button" class="ms-add-btn" onclick="addMilestone()">
                        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Add Milestone
                    </button>
                </div>

                <div class="ms-builder" id="msBuilder"></div>

                <div class="budget-summary">
                    <div>
                        <div class="budget-total-lbl">Milestones Total</div>
                        <div class="budget-total-val">$<span id="msTotal">0</span></div>
                    </div>
                    <div id="budgetMatch"></div>
                </div>
            </div>

            <div class="modal-foot">
                <button class="btn btn-outline" onclick="closeModal()">Cancel</button>
                <button class="btn btn-primary" id="sendProposalBtn">
                    <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                    Send Proposal
                </button>
            </div>

        </div>
    </div>

    @section Scripts {
        <script>
            (function(){
              var token   = document.querySelector('input[name="__RequestVerificationToken"]').value;
              var msCount = 0;

              function showToast(msg, type){
                var colors = {success:'#1D9E75',error:'#E24B4A',info:'#7F77DD'};
                var t = document.createElement('div');
                t.className = 'sv-toast';
                t.style.background = colors[type]||colors.info;
                t.textContent = msg;
                document.body.appendChild(t);
                setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ t.remove(); },300); },3500);
              }

              function post(url, data, cb){
                fetch(url,{
                  method:'POST',
                  headers:{'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken':token},
                  body: new URLSearchParams(data)
                })
                .then(r=>r.json())
                .then(r=>{ showToast(r.message||'Done', r.success?'success':'error'); if(r.success&&cb) cb(r); })
                .catch(()=>showToast('Server error','error'));
              }

              window.openProposalModal = function(requestId, projectName, clientBudget, serviceName){
                document.getElementById('proposalRequestId').value   = requestId;
                document.getElementById('modalProjectName').textContent = '— ' + projectName;
                document.getElementById('clientBudgetHint').textContent = clientBudget > 0 ? Number(clientBudget).toLocaleString() : '—';
                document.getElementById('proposedBudget').value      = clientBudget > 0 ? clientBudget : '';
                document.getElementById('proposalNote').value        = '';
                document.getElementById('estimatedEndDate').value    = '';
                document.getElementById('msBuilder').innerHTML       = '';
                msCount = 0;

                var svcBox = document.getElementById('serviceRefBox');
                if(serviceName){ document.getElementById('serviceRefName').textContent = serviceName; svcBox.classList.add('show'); }
                else { svcBox.classList.remove('show'); }

                addMilestone(); addMilestone(); addMilestone();
                updateBudgetCheck();
                document.getElementById('proposalOverlay').classList.add('open');
                document.body.style.overflow = 'hidden';
              };

              window.closeModal = function(){
                document.getElementById('proposalOverlay').classList.remove('open');
                document.body.style.overflow = '';
              };

              window.handleOverlayClick = function(e){
                if(e.target === document.getElementById('proposalOverlay')) closeModal();
              };

              window.addMilestone = function(){
                msCount++;
                var idx = msCount;
                var div = document.createElement('div');
                div.className = 'ms-row'; div.id = 'ms-'+idx;
                div.innerHTML =
                  '<div class="ms-row-head">' +
                    '<div style="display:flex;align-items:center">' +
                      '<div class="ms-num">'+idx+'</div>' +
                      '<span class="ms-label">Milestone '+idx+'</span>' +
                    '</div>' +
                    (idx>1 ? '<button type="button" class="ms-remove" onclick="removeMilestone('+idx+')"><svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg></button>' : '') +
                  '</div>' +
                  '<div style="margin-bottom:10px"><label class="form-label">Title<span class="form-req">*</span></label>' +
                  '<input type="text" class="form-control ms-title" placeholder="e.g. Requirements & Architecture" oninput="updateBudgetCheck()"></div>' +
                  '<div style="margin-bottom:10px"><label class="form-label">Description</label>' +
                  '<input type="text" class="form-control ms-desc" placeholder="Deliverables for this milestone"></div>' +
                  '<div class="ms-grid">' +
                    '<div><label class="form-label">Amount ($)<span class="form-req">*</span></label>' +
                    '<input type="number" class="form-control ms-amount" min="1" placeholder="0" oninput="updateBudgetCheck()"></div>' +
                    '<div><label class="form-label">Days from Start<span class="form-req">*</span></label>' +
                    '<input type="number" class="form-control ms-days" min="1" placeholder="e.g. 30"></div>' +
                  '</div>';
                document.getElementById('msBuilder').appendChild(div);
              };

              window.removeMilestone = function(idx){
                var el = document.getElementById('ms-'+idx);
                if(el){ el.remove(); updateBudgetCheck(); }
              };

              window.updateBudgetCheck = function(){
                var amounts = document.querySelectorAll('.ms-amount');
                var total = 0;
                amounts.forEach(function(a){ total += parseFloat(a.value)||0; });
                document.getElementById('msTotal').textContent = total.toLocaleString();
                var budget = parseFloat(document.getElementById('proposedBudget').value)||0;
                var matchEl = document.getElementById('budgetMatch');
                if(budget>0){
                  if(Math.abs(total-budget)<0.01){
                    matchEl.className='budget-ok';
                    matchEl.innerHTML='<svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:#1D9E75"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01" stroke="#fff" stroke-width="2" fill="none"/></svg> Matches budget';
                  } else {
                    var diff = total-budget;
                    matchEl.className='budget-bad';
                    matchEl.innerHTML='<svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:#E24B4A"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12" stroke="#fff" stroke-width="2"/><line x1="12" y1="16" x2="12.01" y2="16" stroke="#fff" stroke-width="2"/></svg> '+(diff>0?'+':'')+' $'+Math.abs(diff).toLocaleString()+' vs budget';
                  }
                } else { matchEl.textContent=''; }
              };

              document.getElementById('sendProposalBtn').addEventListener('click', function(){
                var requestId = document.getElementById('proposalRequestId').value;
                var budget    = document.getElementById('proposedBudget').value;
                var endDate   = document.getElementById('estimatedEndDate').value;
                var note      = document.getElementById('proposalNote').value;
                if(!budget||!endDate){ showToast('Please fill budget and end date','error'); return; }

                var rows = document.querySelectorAll('.ms-row');
                var milestones=[]; var valid=true; var idx=0;
                rows.forEach(function(row){
                  idx++;
                  var title  = row.querySelector('.ms-title').value.trim();
                  var desc   = row.querySelector('.ms-desc').value.trim();
                  var amount = row.querySelector('.ms-amount').value;
                  var days   = row.querySelector('.ms-days').value;
                  if(!title||!amount||!days){ valid=false; return; }
                  milestones.push({title,desc,amount,days,order:idx});
                });

                if(!valid||milestones.length===0){ showToast('Please complete all milestone fields','error'); return; }
                var total = milestones.reduce(function(s,m){ return s+parseFloat(m.amount); },0);
                if(Math.abs(total-parseFloat(budget))>0.01){ showToast('Milestones total must equal proposed budget','error'); return; }

                var btn = document.getElementById('sendProposalBtn');
                btn.disabled=true;
                btn.innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#fff;stroke-width:2;fill:none;animation:spin 1s linear infinite"><polyline points="23 4 23 11 16 11"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 11"/></svg> Sending…';

                var params = new URLSearchParams();
                params.append('requestId',requestId);
                params.append('proposedBudget',budget);
                params.append('estimatedEndDate',endDate);
                params.append('proposalNote',note);
                milestones.forEach(function(ms,i){
                  params.append('milestones['+i+'].Title',ms.title);
                  params.append('milestones['+i+'].Description',ms.desc);
                  params.append('milestones['+i+'].Amount',ms.amount);
                  params.append('milestones['+i+'].DaysFromStart',ms.days);
                });

                fetch('@Url.Action("CompanySendProposal", "Projects", new { area = "TeamRooms" })',{
                  method:'POST',
                  headers:{'Content-Type':'application/x-www-form-urlencoded','RequestVerificationToken':token},
                  body:params.toString()
                })
                .then(r=>r.json())
                .then(r=>{
                  showToast(r.message, r.success?'success':'error');
                  if(r.success){
                    closeModal();
                    setTimeout(function(){ location.reload(); },1000);
                  } else {
                    btn.disabled=false;
                    btn.innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#fff;stroke-width:2;fill:none"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Send Proposal';
                  }
                })
                .catch(function(){
                  showToast('Server error','error');
                  btn.disabled=false;
                  btn.innerHTML='<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:#fff;stroke-width:2;fill:none"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Send Proposal';
                });
              });

              window.declineRequest = function(requestId){
                if(!confirm('Decline this request?')) return;
                post('@Url.Action("DeclineCompanyRequest", "Projects", new { area = "TeamRooms" })',
                  {requestId},
                  function(){ setTimeout(function(){ location.reload(); },800); }
                );
              };

              document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeModal(); });
            })();
        </script>
    }

</body>
</html>
