@using ScalaVerse.ViewModel.Project_VM
@model ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Project.ProjectName;

    var statusConfig = Model.Project.Status switch
    {
        "Active" => ("status-active", "bi-play-circle-fill", "Active"),
        "Completed" => ("status-completed", "bi-check-circle-fill", "Completed"),
        "OnHold" => ("status-hold", "bi-pause-circle-fill", "On Hold"),
        "Cancelled" => ("status-cancelled", "bi-x-circle-fill", "Cancelled"),
        _ => ("status-pending", "bi-clock-fill", Model.Project.Status)
    };
}

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #0d1117;
        --ink-soft: #24292f;
        --muted: #57606a;
        --border: #d0d7de;
        --border-subtle: #eaeef2;
        --bg: #f6f8fa;
        --surface: #ffffff;
        /* ── ScaleVerse Purple Theme ── */
        --accent: #7030A0;
        --accent-hover: #5B1F8A;
        --accent-light: #EDE9FE;
        --accent-mid: #9B59D0;
        --green: #1a7f37;
        --green-bg: #dafbe1;
        --red: #cf222e;
        --red-bg: #ffebe9;
        --orange: #bf8700;
        --orange-bg: #fff8c5;
        --radius: 10px;
        --shadow: 0 1px 3px rgba(112,48,160,.08), 0 4px 12px rgba(112,48,160,.04);
        --shadow-md: 0 4px 16px rgba(112,48,160,.12);
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--ink);
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Sora', sans-serif;
    }

    .proj-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 20px 60px;
    }

    /* ── Breadcrumb ── */
    .breadcrumb {
        display: flex;
        gap: 6px;
        align-items: center;
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

        .breadcrumb a {
            color: var(--accent);
            text-decoration: none;
        }

            .breadcrumb a:hover {
                text-decoration: underline;
            }

        .breadcrumb .sep {
            color: var(--border);
        }

    /* ── Header ── */
    .proj-header {
        background: var(--surface);
        border: 1px solid var(--border);
        border-top: 3px solid var(--accent);
        border-radius: var(--radius);
        padding: 28px 32px;
        margin-bottom: 24px;
        box-shadow: var(--shadow);
    }

    .proj-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .proj-title {
        font-size: 26px;
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 6px;
    }

    .proj-desc {
        color: var(--muted);
        font-size: 15px;
        margin: 0 0 14px;
        max-width: 680px;
        line-height: 1.6;
    }

    .tag-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    /* ── Tags ── */
    .tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .3px;
    }

    .status-active {
        background: var(--green-bg);
        color: var(--green);
    }

    .status-completed {
        background: var(--accent-light);
        color: var(--accent);
    }

    .status-hold {
        background: var(--orange-bg);
        color: var(--orange);
    }

    .status-cancelled {
        background: var(--red-bg);
        color: var(--red);
    }

    .status-pending {
        background: #f0f0f0;
        color: var(--muted);
    }

    .tag-category {
        background: var(--bg);
        color: var(--muted);
        border: 1px solid var(--border);
    }

    .tag-priority {
        background: var(--red-bg);
        color: var(--red);
    }

    /* ── Actions Dropdown ── */
    .actions-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-size: 14px;
        font-weight: 500;
        color: var(--ink-soft);
        cursor: pointer;
        transition: all .15s;
    }

        .actions-btn:hover {
            background: var(--accent-light);
            border-color: var(--accent);
            color: var(--accent);
        }

    .dropdown-menu {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-md);
        padding: 6px;
        min-width: 180px;
    }

    .dropdown-item {
        border-radius: 6px;
        font-size: 14px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── Stats Grid ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    @@media(max-width:900px) {
        .stats-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:540px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 22px;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent);
            opacity: 0.4;
        }

    .stat-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .stat-value {
        font-family: 'Sora', sans-serif;
        font-size: 28px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1;
        margin-bottom: 8px;
    }

    .stat-sub {
        font-size: 13px;
        color: var(--muted);
    }

    .stat-icon {
        font-size: 28px;
        opacity: .12;
        color: var(--accent);
    }

    .progress-bar-wrap {
        height: 6px;
        background: var(--border-subtle);
        border-radius: 99px;
        overflow: hidden;
        margin-top: 10px;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), var(--accent-mid));
        border-radius: 99px;
        transition: width .6s ease;
    }

    /* ── Layout ── */
    .content-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 24px;
    }

    @@media(max-width:1024px) {
        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ── Cards ── */
    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 22px;
        border-bottom: 1px solid var(--border-subtle);
        background: linear-gradient(135deg, #faf7fd 0%, #ffffff 100%);
    }

    .card-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

        .card-title i {
            color: var(--accent);
            font-size: 16px;
        }

    .card-body {
        padding: 20px 22px;
    }

    /* ── Milestones ── */
    .milestone-item {
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius);
        padding: 18px 20px;
        margin-bottom: 14px;
        transition: border-color .15s, box-shadow .15s;
    }

        .milestone-item:hover {
            border-color: var(--accent-mid);
            box-shadow: 0 2px 8px rgba(112,48,160,.1);
        }

        .milestone-item:last-child {
            margin-bottom: 0;
        }

        .milestone-item.approved {
            border-left: 3px solid var(--green);
        }

        .milestone-item.underreview {
            border-left: 3px solid var(--accent);
        }

        .milestone-item.rejected {
            border-left: 3px solid var(--red);
        }

        .milestone-item.inprogress {
            border-left: 3px solid var(--orange);
        }

        .milestone-item.pending {
            border-left: 3px solid var(--border);
        }

    .milestone-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .milestone-icon {
        font-size: 22px;
        margin-top: 1px;
        flex-shrink: 0;
    }

    .milestone-body {
        flex: 1;
    }

    .milestone-title {
        font-weight: 600;
        font-size: 15px;
        color: var(--ink);
        margin: 0 0 4px;
    }

    .milestone-desc {
        font-size: 13px;
        color: var(--muted);
        margin: 0 0 10px;
        line-height: 1.5;
    }

    .milestone-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .milestone-amount {
        font-family: 'Sora', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
    }

    .milestone-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        min-width: 130px;
    }

    .rejection-box {
        background: var(--red-bg);
        border: 1px solid #ffc1c0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: var(--red);
        margin-top: 10px;
    }

    /* ── Documents ── */
    .doc-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-subtle);
    }

        .doc-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .doc-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .doc-icon {
        width: 40px;
        height: 40px;
        background: var(--accent-light);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-size: 18px;
        flex-shrink: 0;
    }

    .doc-name {
        font-weight: 500;
        font-size: 14px;
        color: var(--ink);
        margin: 0 0 2px;
    }

    .doc-meta {
        font-size: 12px;
        color: var(--muted);
    }

    /* ── Activity ── */
    .comment-feed {
        max-height: 420px;
        overflow-y: auto;
        margin-bottom: 16px;
        padding-right: 4px;
    }

        .comment-feed::-webkit-scrollbar {
            width: 4px;
        }

        .comment-feed::-webkit-scrollbar-thumb {
            background: var(--accent-light);
            border-radius: 99px;
        }

    .comment-item {
        display: flex;
        gap: 12px;
        margin-bottom: 18px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        flex-shrink: 0;
    }

    .comment-content {
        flex: 1;
    }

    .comment-header {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 4px;
    }

    .comment-name {
        font-weight: 600;
        font-size: 14px;
    }

    .comment-time {
        font-size: 12px;
        color: var(--muted);
    }

    .comment-text {
        font-size: 14px;
        color: var(--ink-soft);
        line-height: 1.55;
    }

    /* ── Chat ── */
    .chat-feed {
        max-height: 280px;
        overflow-y: auto;
        padding: 16px 20px;
    }

        .chat-feed::-webkit-scrollbar {
            width: 3px;
        }

        .chat-feed::-webkit-scrollbar-thumb {
            background: var(--accent-light);
            border-radius: 99px;
        }

    .msg-item {
        display: flex;
        gap: 10px;
        margin-bottom: 14px;
    }

    .msg-bubble {
        background: var(--accent-light);
        border: 1px solid rgba(112,48,160,.15);
        border-radius: 0 10px 10px 10px;
        padding: 8px 12px;
        max-width: 260px;
    }

    .msg-name {
        font-size: 12px;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 2px;
    }

    .msg-text {
        font-size: 13px;
        color: var(--ink-soft);
    }

    .msg-time {
        font-size: 11px;
        color: var(--muted);
        margin-top: 4px;
    }

    /* ── Input Group ── */
    .input-send {
        display: flex;
        gap: 8px;
    }

        .input-send input {
            flex: 1;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 9px 14px;
            font-size: 14px;
            outline: none;
            transition: border-color .15s;
            font-family: inherit;
        }

            .input-send input:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(112,48,160,.1);
            }

        .input-send .btn-send {
            padding: 9px 16px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            font-family: inherit;
            font-weight: 500;
            transition: background .15s;
        }

            .input-send .btn-send:hover {
                background: var(--accent-hover);
            }

    /* ── Sidebar ── */
    .team-leader-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
    }

    .member-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 0;
    }

    .member-name {
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
    }

    .member-role {
        font-size: 12px;
        color: var(--muted);
    }

    .timeline-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--border-subtle);
        font-size: 14px;
    }

        .timeline-row:last-child {
            border-bottom: none;
        }

    .timeline-label {
        color: var(--muted);
        font-weight: 500;
    }

    .timeline-val {
        font-weight: 600;
        color: var(--ink);
    }

    /* ── Review Card ── */
    .review-prompt {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-mid) 100%);
        color: #fff;
        border-radius: var(--radius);
        padding: 22px;
        text-align: center;
        margin-bottom: 24px;
    }

        .review-prompt h6 {
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 6px;
        }

        .review-prompt p {
            font-size: 13px;
            opacity: .85;
            margin: 0 0 14px;
        }

    .btn-review {
        background: #fff;
        color: var(--accent);
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: opacity .15s;
        font-family: inherit;
    }

        .btn-review:hover {
            opacity: .88;
        }

    /* ── Buttons ── */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        border: 1px solid transparent;
        font-family: inherit;
        transition: all .15s;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

    .btn-success {
        background: var(--green);
        color: #fff;
        border-color: var(--green);
    }

        .btn-success:hover {
            background: #116329;
        }

    .btn-danger {
        background: var(--red);
        color: #fff;
        border-color: var(--red);
    }

        .btn-danger:hover {
            background: #a40e26;
        }

    .btn-warning {
        background: var(--orange);
        color: #fff;
        border-color: var(--orange);
    }

        .btn-warning:hover {
            background: #9a6700;
        }

    .btn-outline {
        background: transparent;
        color: var(--ink-soft);
        border-color: var(--border);
    }

        .btn-outline:hover {
            background: var(--accent-light);
            border-color: var(--accent);
            color: var(--accent);
        }

    .btn-sm {
        padding: 5px 11px;
        font-size: 12px;
    }

    .btn-xs {
        padding: 3px 9px;
        font-size: 11px;
    }

    .btn:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--muted);
    }

        .empty-state i {
            font-size: 40px;
            display: block;
            margin-bottom: 10px;
            opacity: .25;
            color: var(--accent);
        }

        .empty-state p {
            font-size: 14px;
            margin: 0;
        }

    /* ── Paid badge ── */
    .badge-paid {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--green-bg);
        color: var(--green);
        border-radius: 20px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
    }

    /* ── Modals ── */
    .modal-content {
        border-radius: var(--radius);
        border: 1px solid var(--border);
    }

    .modal-header {
        border-bottom: 1px solid var(--border-subtle);
        padding: 18px 24px;
    }

    .modal-title {
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        font-weight: 600;
    }

    .modal-body {
        padding: 20px 24px;
    }

    .modal-footer {
        border-top: 1px solid var(--border-subtle);
        padding: 14px 24px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink-soft);
        margin-bottom: 6px;
        display: block;
    }

    .form-control, .form-select {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        width: 100%;
        transition: border-color .15s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(112,48,160,.1);
        }

    /* ── Rating stars ── */
    .rating-stars {
        display: flex;
        gap: 6px;
    }

    .star-btn {
        font-size: 26px;
        cursor: pointer;
        color: var(--border);
        transition: color .15s, transform .12s;
        background: none;
        border: none;
        padding: 0;
        line-height: 1;
    }

        .star-btn:hover, .star-btn.active {
            color: #e3a008;
            transform: scale(1.15);
        }

    .section-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--muted);
        margin-bottom: 10px;
        display: block;
    }

    /* ── Payment Confirm Modal ── */
    .pay-modal-amount {
        font-family: 'Sora', sans-serif;
        font-size: 36px;
        font-weight: 700;
        color: var(--accent);
        text-align: center;
        margin: 10px 0 4px;
    }

    .pay-modal-txid {
        font-size: 11px;
        color: var(--muted);
        font-family: monospace;
        text-align: center;
        background: var(--bg);
        padding: 6px 10px;
        border-radius: 6px;
        margin-top: 8px;
    }

    /* ── Purple avatar default ── */
    .av-purple {
        background: var(--accent-light);
        color: var(--accent);
    }
</style>

<div class="proj-wrap">

    <!-- Breadcrumb -->
    <nav class="breadcrumb">
        <a href="/"><i class="bi bi-house-fill"></i> Home</a>
        <span class="sep">›</span>
        <a href="@Url.Action("Index")">My Projects</a>
        <span class="sep">›</span>
        <span>@Model.Project.ProjectName</span>
    </nav>

    <!-- TempData Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert"
             style="border-radius:var(--radius);font-size:14px;border-left:4px solid var(--green)">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert"
             style="border-radius:var(--radius);font-size:14px;border-left:4px solid var(--red)">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Project Header -->
    <div class="proj-header">
        <div class="proj-header-top">
            <div>
                <h1 class="proj-title">@Model.Project.ProjectName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Project.Description))
                {
                    <p class="proj-desc">@Model.Project.Description</p>
                }
                <div class="tag-row">
                    <span class="tag @statusConfig.Item1">
                        <i class="bi @statusConfig.Item2"></i> @statusConfig.Item3
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Project.Category))
                    {
                        <span class="tag tag-category">@Model.Project.Category</span>
                    }
                    @if (Model.Project.Priority == "High" || Model.Project.Priority == "Urgent")
                    {
                        <span class="tag tag-priority">
                            <i class="bi bi-exclamation-triangle-fill"></i> @Model.Project.Priority
                        </span>
                    }
                </div>
            </div>

            @if (Model.IsClient && Model.Project.Status == "Active")
            {
                <div class="dropdown">
                    <button class="actions-btn dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-gear"></i> Actions
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="#"
                               data-action="updateStatus" data-param="'OnHold'">
                                <i class="bi bi-pause-circle text-warning"></i> Put On Hold
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#"
                               data-action="updateStatus" data-param="'Completed'">
                                <i class="bi bi-check-circle" style="color:var(--accent)"></i> Mark Completed
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="#"
                               data-action="updateStatus" data-param="'Cancelled'">
                                <i class="bi bi-x-circle"></i> Cancel Project
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-grid">
        <div class="stat-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
                <div>
                    <div class="stat-label">Progress</div>
                    <div class="stat-value" id="progressValue">
                        @Model.Project.ProgressPercentage<span style="font-size:16px;font-weight:500">%</span>
                    </div>
                </div>
                <i class="bi bi-graph-up-arrow stat-icon"></i>
            </div>
            <div class="progress-bar-wrap">
                <div class="progress-bar-fill" id="progressBar"
                     style="width:@Model.Project.ProgressPercentage%"></div>
            </div>
        </div>

        <div class="stat-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
                <div>
                    <div class="stat-label">Budget</div>
                    <div class="stat-value">$@Model.Project.Budget.ToString("N0")</div>
                    <div class="stat-sub">Paid: $@Model.TotalPaid.ToString("N0")</div>
                </div>
                <i class="bi bi-currency-dollar stat-icon"></i>
            </div>
        </div>

        <div class="stat-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
                <div>
                    <div class="stat-label">Milestones</div>
                    <div class="stat-value">
                        @Model.CompletedMilestones
                        <span style="font-size:16px;color:var(--muted)">/@Model.TotalMilestones</span>
                    </div>
                    <div class="stat-sub">Completed</div>
                </div>
                <i class="bi bi-flag stat-icon"></i>
            </div>
        </div>

        <div class="stat-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
                <div>
                    <div class="stat-label">Days Left</div>
                    <div class="stat-value"
                         style="color:@(Model.DaysRemaining <= 7 ? "var(--red)" : "var(--ink)")">
                        @Model.DaysRemaining
                    </div>
                    <div class="stat-sub">
                        @if (Model.Project.EstimatedEndDate.HasValue)
                        {
                            <text>Until @Model.Project.EstimatedEndDate.Value.ToString("MMM dd, yyyy")</text>
                        }
                        else
                        {
                            <text>No deadline set</text>
                        }
                    </div>
                </div>
                <i class="bi bi-calendar-event stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- LEFT COLUMN -->
        <div>

            <!-- ══ MILESTONES ══ -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-flag-fill"></i> Milestones
                    </h5>
                    <span class="tag tag-category">
                        @Model.CompletedMilestones / @Model.TotalMilestones done
                    </span>
                </div>
                <div class="card-body">
                    @if (!Model.Milestones.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-flag"></i>
                            <p>No milestones defined yet</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var ms in Model.Milestones)
                        {
                            var msClass = ms.Status switch
                            {
                                "Approved" => "approved",
                                "UnderReview" => "underreview",
                                "Rejected" => "rejected",
                                "InProgress" => "inprogress",
                                _ => "pending"
                            };
                            var msTagClass = ms.Status switch
                            {
                                "Approved" => "status-completed",
                                "UnderReview" => "status-active",
                                "Rejected" => "status-cancelled",
                                "InProgress" => "status-hold",
                                _ => "status-pending"
                            };
                            var msIcon = ms.Status switch
                            {
                                "Approved" => ("bi-check-circle-fill", "var(--green)"),
                                "UnderReview" => ("bi-hourglass-split", "var(--accent)"),
                                "Rejected" => ("bi-x-circle-fill", "var(--red)"),
                                "InProgress" => ("bi-play-circle-fill", "var(--orange)"),
                                _ => ("bi-circle", "var(--border)")
                            };

                            <div class="milestone-item @msClass" id="ms-@ms.MilestoneId">
                                <div class="milestone-row">
                                    <i class="bi @msIcon.Item1 milestone-icon"
                                       style="color:@msIcon.Item2"></i>

                                    <div class="milestone-body">
                                        <div class="milestone-title">@ms.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(ms.Description))
                                        {
                                            <p class="milestone-desc">@ms.Description</p>
                                        }
                                        <div class="milestone-meta">
                                            <span class="tag @msTagClass">@ms.Status</span>
                                            <span style="font-size:12px;color:var(--muted)">
                                                <i class="bi bi-calendar3"></i>
                                                @ms.DueDate.ToString("MMM dd, yyyy")
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(ms.RejectionReason))
                                        {
                                            <div class="rejection-box">
                                                <i class="bi bi-exclamation-circle-fill"></i>
                                                <strong>Rejection reason:</strong> @ms.RejectionReason
                                            </div>
                                        }
                                    </div>

                                    <div class="milestone-actions">
                                        <span class="milestone-amount">$@ms.Amount.ToString("N0")</span>

                                        @if (ms.Status == "Approved")
                                        {
                                            <span class="badge-paid">
                                                <i class="bi bi-check-lg"></i> Paid
                                            </span>
                                        }

                                        @if (Model.IsTeamLeader)
                                        {
                                            @if (ms.Status == "Pending")
                                            {
                                                <button class="btn btn-warning btn-sm"
                                                        data-action="updateMilestoneStatus"
                                                        data-id="@ms.MilestoneId"
                                                        data-status="InProgress">
                                                    <i class="bi bi-play-fill"></i> Start
                                                </button>
                                                <button class="btn btn-success btn-sm"
                                                        data-action="completeMilestone"
                                                        data-id="@ms.MilestoneId">
                                                    <i class="bi bi-send"></i> Submit
                                                </button>
                                            }
                                            else if (ms.Status == "InProgress")
                                            {
                                                <button class="btn btn-success btn-sm"
                                                        data-action="completeMilestone"
                                                        data-id="@ms.MilestoneId">
                                                    <i class="bi bi-send"></i> Submit for Review
                                                </button>
                                                <button class="btn btn-outline btn-sm"
                                                        data-action="updateMilestoneStatus"
                                                        data-id="@ms.MilestoneId"
                                                        data-status="Pending">
                                                    <i class="bi bi-pause-fill"></i> Pause
                                                </button>
                                            }
                                            else if (ms.Status == "Rejected")
                                            {
                                                <div style="font-size:11px;color:var(--orange);text-align:right;margin-bottom:4px">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Fix & Resubmit
                                                </div>
                                                <button class="btn btn-success btn-sm"
                                                        data-action="completeMilestone"
                                                        data-id="@ms.MilestoneId">
                                                    <i class="bi bi-send"></i> Resubmit
                                                </button>
                                            }
                                            else if (ms.Status == "UnderReview")
                                            {
                                                <span class="tag"
                                                      style="background:var(--accent-light);color:var(--accent);font-size:11px">
                                                    <i class="bi bi-hourglass-split"></i> Awaiting Client
                                                </span>
                                            }
                                        }

                                        @if (Model.IsClient && ms.Status == "UnderReview")
                                        {
                                            <button class="btn btn-primary btn-sm"
                                                    data-action="simulatePayment"
                                                    data-id="@ms.MilestoneId"
                                                    data-amount="@ms.Amount.ToString("N0")"
                                                    data-title="@ms.Title">
                                                <i class="bi bi-cash-coin"></i> Approve & Pay
                                            </button>
                                            <button class="btn btn-danger btn-sm"
                                                    data-action="showRejectModal"
                                                    data-id="@ms.MilestoneId">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- ══ DOCUMENTS ══ -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-file-earmark-text-fill"></i> Documents
                    </h5>
                    <button class="btn btn-outline btn-sm"
                            data-bs-toggle="modal" data-bs-target="#uploadModal">
                        <i class="bi bi-upload"></i> Upload
                    </button>
                </div>
                <div class="card-body">
                    @if (!Model.Documents.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>No documents uploaded yet</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="doc-item">
                                <div class="doc-info">
                                    <div class="doc-icon">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </div>
                                    <div>
                                        <div class="doc-name">@doc.FileName</div>
                                        <div class="doc-meta">
                                            @doc.UploadedAt.ToString("MMM dd, yyyy")
                                            &nbsp;·&nbsp;
                                            @((doc.FileSize / 1024.0).ToString("N0")) KB
                                            @if (!string.IsNullOrEmpty(doc.Category))
                                            {
                                                <text>&nbsp;·&nbsp; @doc.Category</text>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <a href="@doc.FileUrl" class="btn btn-outline btn-sm" download>
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- ══ ACTIVITY ══ -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-chat-left-text-fill"></i> Activity
                    </h5>
                </div>
                <div class="card-body">
                    <div class="comment-feed" id="commentsList">
                        @if (!Model.Comments.Any())
                        {
                            <div class="empty-state" style="padding:20px">
                                <i class="bi bi-chat-dots"></i>
                                <p>No activity yet. Start the conversation!</p>
                            </div>
                        }
                        @foreach (var c in Model.Comments)
                        {
                            var initial = c.User?.FullName?.Substring(0, 1).ToUpper() ?? "U";
                            var bgColors = new[] { "var(--accent-light)", "#dafbe1", "#fff8c5", "#ffebe9", "#e8f4fd" };
                            var fgColors = new[] { "var(--accent)", "var(--green)", "var(--orange)", "var(--red)", "#1a6bff" };
                            var colorIdx = Math.Abs((c.User?.FullName ?? "U").GetHashCode()) % 5;

                            <div class="comment-item">
                                <div class="avatar"
                                     style="background:@bgColors[colorIdx];color:@fgColors[colorIdx]">
                                    @initial
                                </div>
                                <div class="comment-content">
                                    <div class="comment-header">
                                        <span class="comment-name">@(c.User?.FullName ?? "Unknown")</span>
                                        <span class="comment-time">@c.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                    <p class="comment-text">@c.CommentText</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="input-send">
                        <input type="text" id="commentInput" placeholder="Add a comment…">
                        <button class="btn-send" data-action="addComment">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div><!-- end LEFT -->
        <!-- RIGHT COLUMN -->
        <div>

            @if (Model.CanSubmitReview)
            {
                <div class="review-prompt">
                    <i class="bi bi-star-fill" style="font-size:28px;display:block;margin-bottom:8px"></i>
                    <h6>Rate This Team</h6>
                    <p>Project completed! Share your experience.</p>
                    <button class="btn-review" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        <i class="bi bi-pencil"></i> Write a Review
                    </button>
                </div>
            }

            <!-- Team -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title"><i class="bi bi-people-fill"></i> Team</h5>
                </div>
                <div class="card-body">
                    @if (Model.Project.TeamRoom != null)
                    {
                        var tr = Model.Project.TeamRoom;
                        <div style="margin-bottom:14px">
                            <div style="font-weight:600;font-size:15px;color:var(--ink)">@tr.TeamName</div>
                            @if (!string.IsNullOrEmpty(tr.Specialty))
                            {
                                <div style="font-size:13px;color:var(--muted)">@tr.Specialty</div>
                            }
                        </div>

                        <span class="section-label">Team Leader</span>
                        <div class="team-leader-row">
                            <div class="avatar av-purple"
                                 style="width:38px;height:38px;font-size:15px">
                                @tr.TeamLeader.User.FullName.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <div style="font-weight:600;font-size:14px">@tr.TeamLeader.User.FullName</div>
                                <div style="font-size:12px;color:var(--muted)">@tr.TeamLeader.User.Email</div>
                            </div>
                        </div>

                        @if (tr.TeamMembers.Any())
                        {
                            <span class="section-label" style="margin-top:14px">
                                Members (@tr.TeamMembers.Count)
                            </span>
                            @foreach (var m in tr.TeamMembers.Take(4))
                            {
                                <div class="member-row">
                                    <div class="avatar"
                                         style="width:30px;height:30px;font-size:12px;background:var(--bg);color:var(--muted);border:1px solid var(--border)">
                                        @m.MemberName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="member-name">@m.MemberName</div>
                                        <div class="member-role">@m.Role</div>
                                    </div>
                                </div>
                            }
                            @if (tr.TeamMembers.Count > 4)
                            {
                                <div style="font-size:12px;color:var(--muted);padding-top:6px">
                                    +@(tr.TeamMembers.Count - 4) more members
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-people"></i>
                            <p>No team assigned</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Timeline -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title"><i class="bi bi-calendar3"></i> Timeline</h5>
                </div>
                <div class="card-body" style="padding-bottom:14px">
                    <div class="timeline-row">
                        <span class="timeline-label">Start Date</span>
                        <span class="timeline-val">@Model.Project.StartDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="timeline-row">
                        <span class="timeline-label">End Date</span>
                        <span class="timeline-val">@(Model.Project.EstimatedEndDate?.ToString("MMM dd, yyyy") ?? "—")</span>
                    </div>
                    @if (Model.Project.CompletedAt.HasValue)
                    {
                        <div class="timeline-row">
                            <span class="timeline-label">Completed</span>
                            <span class="timeline-val" style="color:var(--green)">
                                @Model.Project.CompletedAt.Value.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Payments -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title"><i class="bi bi-credit-card-fill"></i> Payments</h5>
                </div>
                <div class="card-body" style="padding-bottom:14px">
                    @{
                        var pendingAmount = Model.Milestones.Where(m => m.Status != "Approved").Sum(m => m.Amount);
                        var paidPct = Model.Project.Budget > 0 ? (int)(Model.TotalPaid / Model.Project.Budget * 100) : 0;
                    }
                    <div class="timeline-row">
                        <span class="timeline-label">Total Budget</span>
                        <span class="timeline-val">$@Model.Project.Budget.ToString("N0")</span>
                    </div>
                    <div class="timeline-row">
                        <span class="timeline-label">Released</span>
                        <span class="timeline-val" style="color:var(--green)">$@Model.TotalPaid.ToString("N0")</span>
                    </div>
                    <div class="timeline-row">
                        <span class="timeline-label">Remaining</span>
                        <span class="timeline-val" style="color:var(--orange)">$@pendingAmount.ToString("N0")</span>
                    </div>
                    <div class="progress-bar-wrap" style="margin-top:12px">
                        <div class="progress-bar-fill" style="width:@paidPct%"></div>
                    </div>
                    <div style="font-size:12px;color:var(--muted);margin-top:6px">@paidPct% of budget released</div>
                </div>
            </div>

            <!-- Chat -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title"><i class="bi bi-chat-dots-fill"></i> Chat</h5>
                </div>
                <div class="chat-feed" id="messagesList">
                    @if (Model.RecentMessages.Any())
                    {
                        @foreach (var msg in Model.RecentMessages)
                        {
                            <div class="msg-item">
                                <div class="avatar av-purple"
                                     style="width:28px;height:28px;font-size:11px;flex-shrink:0">
                                    @msg.Sender.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <div class="msg-bubble">
                                    <div class="msg-name">@msg.Sender.FullName</div>
                                    <div class="msg-text">@msg.MessageText</div>
                                    <div class="msg-time">@msg.SentAt.ToString("HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align:center;color:var(--muted);font-size:13px;padding:20px">
                            No messages yet. Say hi! 👋
                        </div>
                    }
                </div>
                <div style="padding:12px 16px;border-top:1px solid var(--border-subtle)">
                    <div class="input-send">
                        <input type="text" id="messageInput" placeholder="Type a message…">
                        <button class="btn-send" data-action="sendMessage">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div><!-- end RIGHT -->
    </div>
</div>

<!-- ══ MODALS ══ -->
<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-upload" style="color:var(--accent)"></i> Upload Document
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="uploadForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select File <span style="color:var(--red)">*</span></label>
                        <input type="file" class="form-control" id="fileInput" required>
                        <div style="font-size:12px;color:var(--muted);margin-top:5px">Max file size: 10MB</div>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Category</label>
                        <select class="form-select" id="categoryInput">
                            <option value="Deliverable">Deliverable</option>
                            <option value="Contract">Contract</option>
                            <option value="Reference">Reference</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload"></i> Upload
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-x-circle" style="color:var(--red)"></i> Reject Milestone
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rejectMilestoneId">
                <p style="font-size:14px;color:var(--muted);margin-bottom:14px">
                    Explain clearly what needs to be fixed so the team can improve their work.
                </p>
                <label class="form-label">Reason for Rejection <span style="color:var(--red)">*</span></label>
                <textarea class="form-control" id="rejectionReason" rows="4"
                          placeholder="Describe what needs to be improved…" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" data-action="rejectMilestone">
                    <i class="bi bi-x-circle"></i> Reject Milestone
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Confirm Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header" style="border-bottom:none;padding-bottom:8px">
                <h5 class="modal-title">
                    <i class="bi bi-cash-coin" style="color:var(--accent)"></i> Release Payment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding-top:8px;text-align:center">
                <div style="font-size:13px;color:var(--muted);margin-bottom:6px">Approving milestone:</div>
                <div style="font-weight:600;font-size:15px;color:var(--ink);margin-bottom:12px" id="payModalTitle">—</div>
                <div class="pay-modal-amount" id="payModalAmount">$0</div>
                <div style="font-size:12px;color:var(--muted);margin-top:4px">10% platform fee applies</div>
                <div style="font-size:12px;color:var(--green);margin-top:2px" id="payModalNet"></div>
            </div>
            <div class="modal-footer" style="justify-content:center;gap:10px">
                <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="payConfirmBtn">
                    <i class="bi bi-check-lg"></i> Confirm & Release
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Review Modal -->
@if (Model.CanSubmitReview)
{
    <div class="modal fade" id="reviewModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-star-fill text-warning me-2"></i> Submit Your Review
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="reviewForm">
                    <div class="modal-body">
                        <div class="mb-4">
                            <label class="form-label">Overall Rating <span style="color:var(--red)">*</span></label>
                            <div class="rating-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <button type="button" class="star-btn" data-rating="@i">★</button>
                                }
                            </div>
                            <input type="hidden" id="overallRating" value="0">
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Your Review <span style="color:var(--red)">*</span></label>
                            <textarea class="form-control" id="reviewComment" rows="4" required
                                  placeholder="Share your experience working with this team…"></textarea>
                        </div>
                        <div style="border-top:1px solid var(--border-subtle);padding-top:16px">
                            <div class="section-label">Detailed Ratings (Optional)</div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                                @foreach (var (label, id) in new[] {
                                                        ("Communication",   "communicationRating"),
                                                        ("Quality",         "qualityRating"),
                                                        ("Timeliness",      "timelinessRating"),
                                                        ("Professionalism", "professionalismRating")
                                                        })
                                {
                                    <div>
                                        <label class="form-label" style="text-transform:none;letter-spacing:0">@label</label>
                                        <select class="form-select" id="@id">
                                            <option value="">— Skip —</option>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <option value="@i">@i Star@(i > 1 ? "s" : "")</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> Submit Review
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    @Html.AntiForgeryToken()

    <script>
        (function () {
            function ready(fn) {
                if (document.readyState !== 'loading') fn();
                else document.addEventListener('DOMContentLoaded', fn);
            }

            ready(function () {
                var jq = window.jQuery;
                if (!jq) { console.error('jQuery not found!'); return; }
                var $ = jq;

                var projectId = @Model.Project.ProjectId;
                var __token   = $('input[name="__RequestVerificationToken"]').val();

                var URLS = {
                    updateStatus:          '@Url.Action("UpdateStatus", "Projects", new { area = "TeamRooms" })',
                    addComment:            '@Url.Action("AddComment", "Projects", new { area = "TeamRooms" })',
                    sendMessage:           '@Url.Action("SendMessage", "Projects", new { area = "TeamRooms" })',
                    uploadDocument:        '@Url.Action("UploadDocument", "Projects", new { area = "TeamRooms" })',
                    completeMilestone:     '@Url.Action("CompleteMilestone", "Projects", new { area = "TeamRooms" })',
                    updateMilestoneStatus: '@Url.Action("UpdateMilestoneStatus", "Projects", new { area = "TeamRooms" })',
                    simulatePayment:       '@Url.Action("SimulatePayment", "Projects", new { area = "TeamRooms" })',
                    rejectMilestone:       '@Url.Action("RejectMilestone", "Projects", new { area = "TeamRooms" })',
                    submitReview:          '@Url.Action("SubmitReview", "Projects", new { area = "TeamRooms" })'
                };

                $.ajaxSetup({ headers: { 'RequestVerificationToken': __token } });

                function escapeHtml(str) {
                    return String(str)
                        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
                }

                function showToast(msg, type) {
                    var colors = { success: '#1a7f37', error: '#cf222e', info: '#7030A0' };
                    var t = document.createElement('div');
                    t.style.cssText =
                        'position:fixed;bottom:24px;right:24px;background:' + (colors[type] || colors.info) +
                        ';color:#fff;padding:12px 20px;border-radius:10px;font-size:14px;font-weight:500;' +
                        'box-shadow:0 4px 16px rgba(112,48,160,.25);z-index:9999;max-width:320px;transition:opacity .3s';
                    t.textContent = msg;
                    document.body.appendChild(t);
                    setTimeout(function () {
                        t.style.opacity = '0';
                        setTimeout(function () { if (t.parentNode) t.remove(); }, 300);
                    }, 3500);
                }

                function doPost(url, data, onSuccess) {
                    $.post(url, data, function (r) {
                        showToast(r.message || 'Done', r.success ? 'success' : 'error');
                        if (r.success) {
                            if (onSuccess) onSuccess(r);
                            else setTimeout(function () { location.reload(); }, 800);
                        }
                    }).fail(function (xhr) { showToast('Server error: ' + xhr.status, 'error'); });
                }

                var _pendingPaymentMilestoneId = null;

                $(document).on('click', '[data-action]', function (e) {
                    e.preventDefault();
                    var $btn   = $(this);
                    var action = $btn.data('action');
                    var id     = $btn.data('id');
                    var param  = $btn.data('param');

                    if (action === 'updateStatus') {
                        var status = param ? String(param).replace(/'/g, '') : id;
                        var labels = { OnHold: 'put on hold', Completed: 'mark as completed', Cancelled: 'cancel' };
                        if (!confirm('Are you sure you want to ' + (labels[status] || status) + ' this project?')) return;
                        doPost(URLS.updateStatus, { projectId: projectId, newStatus: status });
                    }
                    else if (action === 'completeMilestone') {
                        if (!confirm('Submit this milestone for client review?')) return;
                        $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Submitting…');
                        doPost(URLS.completeMilestone, { milestoneId: id });
                    }
                    else if (action === 'updateMilestoneStatus') {
                        var newStatus = $btn.data('status');
                        var statusLabels = { InProgress: 'start working on', Pending: 'pause' };
                        if (!confirm('Are you sure you want to ' + (statusLabels[newStatus] || newStatus) + ' this milestone?')) return;
                        $btn.prop('disabled', true);
                        doPost(URLS.updateMilestoneStatus, { milestoneId: id, newStatus: newStatus },
                            function () { setTimeout(function () { location.reload(); }, 600); });
                    }
                    else if (action === 'simulatePayment') {
                        var amount = $btn.data('amount');
                        var title  = $btn.data('title') || 'Milestone';
                        var raw    = parseFloat(String(amount).replace(/,/g, '')) || 0;
                        var net    = (raw * 0.90).toFixed(0);
                        _pendingPaymentMilestoneId = id;
                        $('#payModalTitle').text(title);
                        $('#payModalAmount').text('$' + amount);
                        $('#payModalNet').text('Team receives: $' + Number(net).toLocaleString());
                        $('#paymentModal').modal('show');
                    }
                    else if (action === 'showRejectModal') {
                        $('#rejectMilestoneId').val(id);
                        $('#rejectionReason').val('');
                        $('#rejectModal').modal('show');
                    }
                    else if (action === 'rejectMilestone') {
                        var reason = $('#rejectionReason').val().trim();
                        if (!reason) { showToast('Please provide a rejection reason', 'error'); return; }
                        var mid = $('#rejectMilestoneId').val();
                        doPost(URLS.rejectMilestone, { milestoneId: mid, reason: reason },
                            function () { $('#rejectModal').modal('hide'); });
                    }
                    else if (action === 'addComment') {
                        var commentText = $('#commentInput').val().trim();
                        if (!commentText) return;
                        $.post(URLS.addComment, { projectId: projectId, commentText: commentText }, function (r) {
                            if (r.success) {
                                $('#commentInput').val('');
                                var $feed = $('#commentsList');
                                $feed.find('.empty-state').remove();
                                $feed.prepend(
                                    '<div class="comment-item">' +
                                    '<div class="avatar" style="background:var(--accent-light);color:var(--accent)">' +
                                        escapeHtml(r.comment.userName.charAt(0)) +
                                    '</div>' +
                                    '<div class="comment-content">' +
                                        '<div class="comment-header">' +
                                            '<span class="comment-name">' + escapeHtml(r.comment.userName) + '</span>' +
                                            '<span class="comment-time">' + r.comment.createdAt + '</span>' +
                                        '</div>' +
                                        '<p class="comment-text">' + escapeHtml(r.comment.commentText) + '</p>' +
                                    '</div></div>'
                                );
                            } else { showToast(r.message, 'error'); }
                        }).fail(function (xhr) { showToast('Error ' + xhr.status, 'error'); });
                    }
                    else if (action === 'sendMessage') {
                        var messageText = $('#messageInput').val().trim();
                        if (!messageText) return;
                        $.post(URLS.sendMessage, { projectId: projectId, messageText: messageText }, function (r) {
                            if (r.success) {
                                $('#messageInput').val('');
                                var $feed = $('#messagesList');
                                $feed.find('[style*="No messages"]').remove();
                                $feed.append(
                                    '<div class="msg-item">' +
                                    '<div class="avatar av-purple" style="width:28px;height:28px;font-size:11px;flex-shrink:0">' +
                                        escapeHtml(r.message.senderName.charAt(0)) +
                                    '</div>' +
                                    '<div class="msg-bubble">' +
                                        '<div class="msg-name">' + escapeHtml(r.message.senderName) + '</div>' +
                                        '<div class="msg-text">'  + escapeHtml(r.message.messageText) + '</div>' +
                                        '<div class="msg-time">'  + r.message.sentAt + '</div>' +
                                    '</div></div>'
                                );
                                var el = document.getElementById('messagesList');
                                if (el) el.scrollTop = el.scrollHeight;
                            } else { showToast(r.message, 'error'); }
                        }).fail(function (xhr) { showToast('Error ' + xhr.status, 'error'); });
                    }
                });

                $('#payConfirmBtn').on('click', function () {
                    if (!_pendingPaymentMilestoneId) return;
                    var $btn = $(this);
                    $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Processing…');
                    $.post(URLS.simulatePayment, { milestoneId: _pendingPaymentMilestoneId }, function (r) {
                        $('#paymentModal').modal('hide');
                        showToast(r.success ? '✅ ' + r.message : r.message, r.success ? 'success' : 'error');
                        if (r.success) {
                            if (r.progress !== undefined) {
                                $('#progressBar').css('width', r.progress + '%');
                                $('#progressValue').html(r.progress + '<span style="font-size:16px;font-weight:500">%</span>');
                            }
                            setTimeout(function () { location.reload(); }, 1200);
                        } else {
                            $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Confirm & Release');
                        }
                    }).fail(function (xhr) {
                        showToast('Server error: ' + xhr.status, 'error');
                        $btn.prop('disabled', false).html('<i class="bi bi-check-lg"></i> Confirm & Release');
                    });
                });

                $('#paymentModal').on('hidden.bs.modal', function () {
                    _pendingPaymentMilestoneId = null;
                    $('#payConfirmBtn').prop('disabled', false).html('<i class="bi bi-check-lg"></i> Confirm & Release');
                });

                $(document).on('keydown', '#commentInput', function (e) {
                    if (e.key === 'Enter') $('[data-action="addComment"]').trigger('click');
                });
                $(document).on('keydown', '#messageInput', function (e) {
                    if (e.key === 'Enter') $('[data-action="sendMessage"]').trigger('click');
                });

                $(document).on('submit', '#uploadForm', function (e) {
                    e.preventDefault();
                    var file = document.getElementById('fileInput').files[0];
                    if (!file) { showToast('Please select a file', 'error'); return; }
                    var $submitBtn = $(this).find('button[type=submit]');
                    $submitBtn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Uploading...');
                    var fd = new FormData();
                    fd.append('projectId', projectId);
                    fd.append('file', file);
                    fd.append('category', $('#categoryInput').val());
                    fd.append('__RequestVerificationToken', __token);
                    $.ajax({
                        url: URLS.uploadDocument, type: 'POST',
                        data: fd, processData: false, contentType: false, headers: {},
                        success: function (r) {
                            if (r.success) {
                                showToast('Uploaded successfully!', 'success');
                                setTimeout(function () { location.reload(); }, 800);
                            } else {
                                showToast(r.message || 'Upload failed', 'error');
                                $submitBtn.prop('disabled', false).html('<i class="bi bi-upload"></i> Upload');
                            }
                        },
                        error: function (xhr) {
                            showToast('Upload failed (' + xhr.status + ')', 'error');
                            $submitBtn.prop('disabled', false).html('<i class="bi bi-upload"></i> Upload');
                        }
                    });
                });

                $(document).on('click', '.star-btn', function () {
                    var r = parseInt($(this).data('rating'));
                    $('#overallRating').val(r);
                    $('.star-btn').each(function (i) { $(this).toggleClass('active', i < r); });
                }).on('mouseenter', '.star-btn', function () {
                    var r = parseInt($(this).data('rating'));
                    $('.star-btn').each(function (i) {
                        $(this).css('color', i < r ? '#e3a008' : 'var(--border)');
                    });
                }).on('mouseleave', '.star-btn', function () {
                    var s = parseInt($('#overallRating').val()) || 0;
                    $('.star-btn').each(function (i) {
                        $(this).css('color', i < s ? '#e3a008' : 'var(--border)');
                    });
                });

                $(document).on('submit', '#reviewForm', function (e) {
                    e.preventDefault();
                    var rating = parseInt($('#overallRating').val());
                    if (!rating) { showToast('Please select a rating', 'error'); return; }
                    doPost(URLS.submitReview, {
                        projectId:             projectId,
                        rating:                rating,
                        comment:               $('#reviewComment').val(),
                        communicationRating:   $('#communicationRating').val()   || null,
                        qualityRating:         $('#qualityRating').val()         || null,
                        timelinessRating:      $('#timelinessRating').val()      || null,
                        professionalismRating: $('#professionalismRating').val() || null
                    }, function () { $('#reviewModal').modal('hide'); });
                });

                var chat = document.getElementById('messagesList');
                if (chat) chat.scrollTop = chat.scrollHeight;
            });
        })();
    </script>

    <style>
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }
    </style>
}
