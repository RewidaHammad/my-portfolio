@model ScalaVerse.ViewModel.Admin_VM.RejectCompanyViewModel
@{
    ViewData["Title"] = "Reject Company";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-x-circle"></i> Reject Company Registration
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Important:</strong> You are about to reject this company registration. They will be notified and can reapply after the waiting period.
                    </div>

                    <!-- Company Details -->
                    <div class="card mb-3 bg-light">
                        <div class="card-body">
                            <h6 class="fw-bold mb-2">Company</h6>
                            <p class="mb-0">
                                <i class="bi bi-building"></i> <strong>@Model.CompanyName</strong>
                            </p>
                        </div>
                    </div>

                    <!-- Rejection Form -->
                    <form method="post" asp-area="Admin" asp-controller="Admin" asp-action="RejectCompany">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="hidden" asp-for="CompanyName" />

                        <div class="mb-3">
                            <label asp-for="RejectionReason" class="form-label fw-bold">
                                <i class="bi bi-chat-left-text"></i> Rejection Reason *
                            </label>
                            <textarea asp-for="RejectionReason" class="form-control" rows="5"
                                      placeholder="Provide a clear reason for rejection (e.g., Invalid registration documents, Missing business license, Incomplete information, etc.)"
                                      required></textarea>
                            <span asp-validation-for="RejectionReason" class="text-danger"></span>
                            <div class="form-text">
                                This will help the company understand what documents or information they need to provide
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <small>
                                <i class="bi bi-info-circle"></i>
                                After rejection, the company will need to wait 30 days before they can reapply.
                            </small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("PendingCompanies", "Admin", new { area = "Admin" })" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle"></i> Reject Company
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}