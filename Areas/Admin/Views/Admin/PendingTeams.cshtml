@model ScalaVerse.ViewModel.Admin_VM.PendingTeamsViewModel
@{
    ViewData["Title"] = "Pending Team Verifications";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-soft: rgba(124,58,237,0.10);
        --purple-glow: rgba(124,58,237,0.22);
        --off: #F9FAFB;
        --white: #FFFFFF;
        --border: #E5E7EB;
        --border-soft: #F3F4F6;
        --text: #111827;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --green-text: #065F46;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --amber-text: #92400E;
        --red: #DC2626;
        --red-bg: #FEF2F2;
        --red-text: #991B1B;
        --blue: #2563EB;
        --blue-bg: #EFF6FF;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 14px;
        --radius-sm: 9px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 12px rgba(0,0,0,0.05);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.13);
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
        color: var(--text);
        font-size: 15px;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--f-display);
    }

    .page-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ══ BACK LINK ══ */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        transition: color .15s;
    }

        .back-link:hover {
            color: var(--purple);
        }

    /* ══ PAGE HEADER ══ */
    .page-header {
        background: linear-gradient(135deg, var(--navy) 0%, #1a1040 55%, #0f1a35 100%);
        border-radius: var(--radius);
        padding: 32px 36px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 36px rgba(0,0,0,0.22);
        animation: fadeUp .4s var(--ease) .05s both;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -40px;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124,58,237,0.22) 0%, transparent 65%);
            pointer-events: none;
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -50px;
            left: 30%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, transparent 65%);
            pointer-events: none;
        }

    .header-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .header-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .header-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(124,58,237,0.15);
        border: 1px solid rgba(124,58,237,0.3);
        border-radius: 100px;
        padding: 4px 14px 4px 8px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--purple-4);
        margin-bottom: 12px;
    }

    .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--purple-3);
        animation: blink 2s infinite;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .3
        }
    }

    .header-title {
        font-family: var(--f-display);
        font-size: clamp(1.7rem, 3vw, 2.2rem);
        font-weight: 800;
        letter-spacing: -.04em;
        color: #fff;
        margin: 0 0 6px;
        line-height: 1.15;
    }

        .header-title .grad {
            background: linear-gradient(120deg, #DDD6FE, var(--purple-4));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .header-sub {
        font-size: 0.85rem;
        color: rgba(255,255,255,.35);
    }

    .header-stat {
        background: rgba(124,58,237,.18);
        border: 1px solid rgba(124,58,237,.25);
        border-radius: 12px;
        padding: 14px 24px;
        text-align: center;
        flex-shrink: 0;
        backdrop-filter: blur(8px);
    }

    .hs-val {
        font-family: var(--f-display);
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
    }

        .hs-val span {
            color: var(--purple-4);
        }

    .hs-lbl {
        font-size: .65rem;
        color: rgba(255,255,255,.32);
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-top: 3px;
    }

    /* ══ EMPTY STATE ══ */
    .empty-state {
        text-align: center;
        padding: 72px 40px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        animation: fadeUp .5s var(--ease) .1s both;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: var(--green-bg);
        border: 1px solid rgba(5,150,105,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        font-size: 26px;
        color: var(--green);
    }

    .empty-title {
        font-family: var(--f-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 7px;
    }

    .empty-sub {
        font-size: .88rem;
        color: var(--muted);
    }

    /* ══ TABLE CARD ══ */
    .table-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
        animation: fadeUp .5s var(--ease) .12s both;
    }

    .table-card-head {
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .tc-title {
        font-family: var(--f-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0;
    }

        .tc-title i {
            color: var(--purple);
            font-size: 16px;
        }

    .tc-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 22px;
        padding: 0 7px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
        background: var(--purple-soft);
        color: var(--purple);
    }

    /* ══ TABLE ══ */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead tr {
            background: var(--off);
            border-bottom: 1px solid var(--border);
        }

        .data-table th {
            padding: 11px 18px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--muted);
            text-align: left;
            white-space: nowrap;
        }

        .data-table tbody tr {
            border-bottom: 1px solid var(--border-soft);
            transition: background .13s;
        }

            .data-table tbody tr:last-child {
                border-bottom: none;
            }

            .data-table tbody tr:hover {
                background: var(--off);
            }

        .data-table td {
            padding: 14px 18px;
            font-size: .88rem;
            color: var(--text-2);
            vertical-align: middle;
        }

    /* team leader cell */
    .leader-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .leader-av {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--f-display);
        font-size: .9rem;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, var(--purple), var(--purple-3));
    }

    .leader-name {
        font-family: var(--f-display);
        font-size: .92rem;
        font-weight: 700;
        color: var(--text);
    }

    .leader-email {
        font-size: .74rem;
        color: var(--muted);
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 3px;
    }

        .leader-email i {
            font-size: 11px;
        }

    /* experience badge */
    .exp-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
        background: var(--blue-bg);
        color: var(--blue);
        border: 1px solid rgba(37,99,235,.15);
    }

    /* expertise tags */
    .expertise-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .expertise-tag {
        display: inline-flex;
        align-items: center;
        padding: 2px 9px;
        border-radius: 100px;
        font-size: .7rem;
        font-weight: 600;
        background: var(--purple-soft);
        color: var(--purple);
        border: 1px solid rgba(124,58,237,.15);
    }

    /* wait badge */
    .wait-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
        background: var(--amber-bg);
        color: var(--amber-text);
        font-family: var(--f-display);
    }

    /* actions */
    .actions-cell {
        display: flex;
        gap: 7px;
        align-items: center;
    }

    .btn-approve {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 8px;
        font-family: var(--f-display);
        font-size: .76rem;
        font-weight: 700;
        background: var(--green);
        color: #fff;
        border: none;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(5,150,105,.25);
        transition: all .18s var(--ease);
    }

        .btn-approve:hover {
            background: #047857;
            transform: translateY(-1px);
        }

    .btn-reject {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 14px;
        border-radius: 8px;
        font-family: var(--f-display);
        font-size: .76rem;
        font-weight: 700;
        background: var(--red-bg);
        color: var(--red-text);
        border: 1px solid rgba(220,38,38,.2);
        text-decoration: none;
        transition: all .18s var(--ease);
    }

        .btn-reject:hover {
            background: var(--red);
            color: #fff;
            transform: translateY(-1px);
        }

    /* ══ ANIMATIONS ══ */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    /* ══ RESPONSIVE ══ */
    @@media (max-width: 900px) {
        .data-table th:nth-child(3),
        .data-table td:nth-child(3) {
            display: none;
        }
        /* hide experience */
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 26px 22px;
        }

        .header-title {
            font-size: 1.5rem;
        }

        .header-stat {
            display: none;
        }

        .data-table th:nth-child(4),
        .data-table td:nth-child(4) {
            display: none;
        }
        /* hide expertise */
    }

    @@media (max-width: 540px) {
        .page-wrap {
            padding: 16px 14px 40px;
            gap: 14px;
        }

        .data-table th:nth-child(5),
        .data-table td:nth-child(5) {
            display: none;
        }
        /* hide waiting */
        .actions-cell {
            flex-direction: column;
            gap: 5px;
        }
    }
</style>

<div class="page-wrap">

    <!-- Back -->
    <div style="animation: fadeUp .3s var(--ease) both;">
        <a href="@Url.Action("Index")" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <!-- ══ PAGE HEADER ══ -->
    <div class="page-header">
        <div class="header-grid"></div>
        <div class="header-inner">
            <div>
                <div class="header-eyebrow"><span class="pill-dot"></span> Admin · Verifications</div>
                <div class="header-title">Pending <span class="grad">Teams</span></div>
                <div class="header-sub">Review and verify team leader applications</div>
            </div>
            <div class="header-stat">
                <div class="hs-val">@Model.TotalPending<span>+</span></div>
                <div class="hs-lbl">Awaiting Review</div>
            </div>
        </div>
    </div>

    <!-- ══ CONTENT ══ -->
    @if (!Model.PendingTeams.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-people-fill"></i></div>
            <div class="empty-title">All teams verified!</div>
            <div class="empty-sub">No pending team verifications at the moment.</div>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-card-head">
                <h2 class="tc-title"><i class="bi bi-people-fill"></i> Pending Team Verifications</h2>
                <span class="tc-count">@Model.TotalPending</span>
            </div>
            <div style="overflow-x:auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Team Leader</th>
                            <th>Experience</th>
                            <th>Expertise</th>
                            <th>Waiting</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in Model.PendingTeams)
                        {
                            <tr>
                                <td>
                                    <div class="leader-cell">
                                        <div class="leader-av">@team.FullName.Substring(0, 1).ToUpper()</div>
                                        <div>
                                            <div class="leader-name">@team.FullName</div>
                                            <div class="leader-email"><i class="bi bi-envelope"></i> @team.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="exp-badge">
                                        <i class="bi bi-briefcase"></i> @team.YearsOfExperience yrs
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(team.ExpertiseAreas))
                                    {
                                        <div class="expertise-wrap">
                                            @foreach (var area in team.ExpertiseAreas.Split(',').Take(3))
                                            {
                                                <span class="expertise-tag">@area.Trim()</span>
                                            }
                                            @if (team.ExpertiseAreas.Split(',').Length > 3)
                                            {
                                                <span class="expertise-tag" style="background:var(--border-soft);color:var(--muted);border-color:transparent;">
                                                    +@(team.ExpertiseAreas.Split(',').Length - 3)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color:var(--muted);font-size:.8rem;">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="wait-badge"><i class="bi bi-clock"></i> @team.TimeAgo</span>
                                </td>
                                <td>
                                    <div class="actions-cell">
                                        <form method="post" action="@Url.Action("ApproveTeam")" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@team.TeamLeaderId" />
                                            <button type="submit" class="btn-approve">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                        </form>
                                        <a href="@Url.Action("RejectTeam", new { id = team.TeamLeaderId })" class="btn-reject">
                                            <i class="bi bi-x-lg"></i> Reject
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
