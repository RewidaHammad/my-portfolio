@model ScalaVerse.ViewModel.Admin_VM.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-4: #A78BFA;
        --purple-soft: rgba(124,58,237,0.10);
        --purple-glow: rgba(124,58,237,0.22);
        --off: #F9FAFB;
        --white: #FFFFFF;
        --border: #E5E7EB;
        --border-soft: #F3F4F6;
        --text: #111827;
        --text-2: #374151;
        --muted: #6B7280;
        --green: #059669;
        --green-bg: #ECFDF5;
        --green-text: #065F46;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --amber-text: #92400E;
        --blue: #2563EB;
        --blue-bg: #EFF6FF;
        --red: #DC2626;
        --red-bg: #FEF2F2;
        --red-text: #991B1B;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 14px;
        --radius-sm: 9px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 12px rgba(0,0,0,0.05);
        --shadow-md: 0 8px 32px rgba(0,0,0,0.13);
    }

    body {
        font-family: var(--f-body);
        background: var(--off);
        color: var(--text);
        font-size: 15px;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--f-display);
    }

    .adm-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ══ PAGE HEADER ══ */
    .page-header {
        background: linear-gradient(135deg, var(--navy) 0%, #1a1040 55%, #0f1a35 100%);
        border-radius: var(--radius);
        padding: 32px 36px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 36px rgba(0,0,0,0.22);
        animation: fadeUp .4s var(--ease) .05s both;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -40px;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124,58,237,0.2) 0%, transparent 65%);
            pointer-events: none;
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -50px;
            left: 30%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, transparent 65%);
            pointer-events: none;
        }

    .header-grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    .header-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }

    .header-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(124,58,237,0.15);
        border: 1px solid rgba(124,58,237,0.3);
        border-radius: 100px;
        padding: 4px 14px 4px 8px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--purple-4);
        margin-bottom: 12px;
    }

    .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--purple-3);
        animation: blink 2s infinite;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .3
        }
    }

    .header-title {
        font-family: var(--f-display);
        font-size: clamp(1.7rem, 3vw, 2.2rem);
        font-weight: 800;
        letter-spacing: -.04em;
        color: #fff;
        margin: 0 0 6px;
        line-height: 1.15;
    }

        .header-title .grad {
            background: linear-gradient(120deg, #DDD6FE, var(--purple-4));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .header-date {
        font-size: 0.85rem;
        color: rgba(255,255,255,.35);
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .header-date i {
            color: var(--purple-4);
        }

    .btn-refresh {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 22px;
        border-radius: 10px;
        font-family: var(--f-body);
        font-size: 0.85rem;
        font-weight: 600;
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.85);
        border: 1px solid rgba(255,255,255,.15);
        backdrop-filter: blur(4px);
        cursor: pointer;
        transition: all .2s var(--ease);
    }

        .btn-refresh:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    /* ══ STATS GRID ══ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px;
    }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        text-decoration: none;
        display: block;
        transition: all .25s var(--ease);
        box-shadow: var(--shadow);
        animation: fadeUp .5s var(--ease) both;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--purple-4);
        }

    .stat-stripe {
        height: 4px;
    }

    .ss-blue {
        background: linear-gradient(90deg, var(--blue), #60A5FA);
    }

    .ss-amber {
        background: linear-gradient(90deg, var(--amber), #FCD34D);
    }

    .ss-green {
        background: linear-gradient(90deg, var(--green), #34D399);
    }

    .ss-purple {
        background: linear-gradient(90deg, var(--purple), var(--purple-3));
    }

    .stat-body {
        padding: 20px 22px 18px;
    }

    .stat-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .si-blue {
        background: var(--blue-bg);
        color: var(--blue);
    }

    .si-amber {
        background: var(--amber-bg);
        color: var(--amber);
    }

    .si-green {
        background: var(--green-bg);
        color: var(--green);
    }

    .si-purple {
        background: var(--purple-soft);
        color: var(--purple);
    }

    .stat-value {
        font-family: var(--f-display);
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -.04em;
        color: var(--text);
        line-height: 1;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: .8rem;
        color: var(--muted);
        font-weight: 500;
        margin-bottom: 11px;
    }

    .stat-meta {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .stat-meta-item {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: .76rem;
        font-weight: 600;
    }

        .stat-meta-item i {
            font-size: 11px;
        }

    .smi-green {
        color: var(--green);
    }

    .smi-red {
        color: var(--red);
    }

    .smi-muted {
        color: var(--muted);
    }

    .smi-amber {
        color: var(--amber);
    }

    .stat-card:nth-child(1) {
        animation-delay: .08s
    }

    .stat-card:nth-child(2) {
        animation-delay: .13s
    }

    .stat-card:nth-child(3) {
        animation-delay: .18s
    }

    .stat-card:nth-child(4) {
        animation-delay: .23s
    }

    /* ══ SECTION HEADER ══ */
    .sec-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .sec-title {
        font-family: var(--f-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0;
    }

        .sec-title i {
            color: var(--purple);
            font-size: 16px;
        }

    /* ══ QUICK ACTIONS ══ */
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 12px;
    }

    .action-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px 18px;
        text-align: center;
        text-decoration: none;
        transition: all .22s var(--ease);
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        animation: fadeUp .5s var(--ease) both;
    }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--purple-4);
        }

    .action-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .ai-blue {
        background: var(--blue-bg);
        color: var(--blue);
    }

    .ai-green {
        background: var(--green-bg);
        color: var(--green);
    }

    .ai-purple {
        background: var(--purple-soft);
        color: var(--purple);
    }

    .ai-amber {
        background: var(--amber-bg);
        color: var(--amber);
    }

    .action-label {
        font-family: var(--f-display);
        font-size: .92rem;
        font-weight: 700;
        color: var(--text);
    }

    .action-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 11px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
    }

    .ab-amber {
        background: var(--amber-bg);
        color: var(--amber-text);
    }

    .ab-muted {
        background: var(--border-soft);
        color: var(--muted);
        font-weight: 500;
    }

    .action-card:nth-child(1) {
        animation-delay: .1s
    }

    .action-card:nth-child(2) {
        animation-delay: .15s
    }

    .action-card:nth-child(3) {
        animation-delay: .2s
    }

    .action-card:nth-child(4) {
        animation-delay: .25s
    }

    /* ══ ACTIVITY GRID ══ */
    .activity-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .list-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
        animation: fadeUp .5s var(--ease) .22s both;
    }

    .list-card-head {
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
    }

    .lch-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 22px;
        padding: 0 7px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
        background: var(--purple-soft);
        color: var(--purple);
    }

        .lch-count.amber {
            background: var(--amber-bg);
            color: var(--amber-text);
        }

    .list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        border-bottom: 1px solid var(--border-soft);
        transition: background .13s;
    }

        .list-item:last-child {
            border-bottom: none;
        }

        .list-item:hover {
            background: var(--off);
        }

    .item-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .item-av {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--f-display);
        font-size: .9rem;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, var(--purple), var(--purple-3));
    }

        .item-av.amber {
            background: linear-gradient(135deg, var(--amber), #FCD34D);
        }

    .item-name {
        font-family: var(--f-display);
        font-size: .9rem;
        font-weight: 700;
        color: var(--text);
    }

    .item-email {
        font-size: .76rem;
        color: var(--muted);
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .item-email i {
            font-size: 11px;
        }

    .item-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 7px;
    }

    .wait-badge {
        font-size: .7rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 100px;
        background: var(--amber-bg);
        color: var(--amber-text);
        font-family: var(--f-display);
    }

    .btn-review {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 13px;
        border-radius: 7px;
        font-size: .76rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--purple);
        background: var(--purple-soft);
        border: 1px solid rgba(124,58,237,.2);
        transition: all .15s;
    }

        .btn-review:hover {
            background: var(--purple);
            color: #fff;
        }

    .list-card-foot {
        padding: 13px 22px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: center;
        background: var(--off);
    }

    .btn-view-all {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 22px;
        border-radius: 9px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .18s var(--ease);
        font-family: var(--f-display);
    }

    .bva-purple {
        background: var(--purple);
        color: #fff;
        box-shadow: 0 4px 12px var(--purple-glow);
    }

        .bva-purple:hover {
            background: var(--purple-2);
            transform: translateY(-1px);
            color: #fff;
        }

    .bva-amber {
        background: var(--amber);
        color: #fff;
        box-shadow: 0 4px 12px rgba(217,119,6,.3);
    }

        .bva-amber:hover {
            background: #B45309;
            transform: translateY(-1px);
            color: #fff;
        }

    /* ══ STUCK PROJECTS ══ */
    .table-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
        animation: fadeUp .5s var(--ease) .28s both;
    }

    .table-card-head {
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, rgba(220,38,38,.06), rgba(220,38,38,.02));
    }

    .alert-title {
        font-family: var(--f-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--red);
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 0;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table thead tr {
            background: var(--off);
            border-bottom: 1px solid var(--border);
        }

        .data-table th {
            padding: 11px 18px;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--muted);
            text-align: left;
        }

        .data-table tbody tr {
            border-bottom: 1px solid var(--border-soft);
            transition: background .13s;
        }

            .data-table tbody tr:last-child {
                border-bottom: none;
            }

            .data-table tbody tr:hover {
                background: var(--off);
            }

        .data-table td {
            padding: 13px 18px;
            font-size: .88rem;
            color: var(--text-2);
            vertical-align: middle;
        }

    .td-name {
        font-weight: 700;
        color: var(--text);
        font-family: var(--f-display);
    }

    .days-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
        background: var(--red-bg);
        color: var(--red-text);
    }

    .status-chip {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 700;
        background: var(--border-soft);
        color: var(--muted);
    }

    .btn-investigate {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 13px;
        border-radius: 7px;
        font-size: .76rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--red);
        background: var(--red-bg);
        border: 1px solid rgba(220,38,38,.2);
        transition: all .15s;
    }

        .btn-investigate:hover {
            background: var(--red);
            color: #fff;
        }

    .table-foot {
        padding: 13px 22px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: center;
        background: var(--off);
    }

    .btn-danger-full {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 22px;
        border-radius: 9px;
        font-size: .82rem;
        font-weight: 700;
        text-decoration: none;
        background: var(--red);
        color: #fff;
        box-shadow: 0 4px 12px rgba(220,38,38,.25);
        transition: all .18s var(--ease);
        font-family: var(--f-display);
    }

        .btn-danger-full:hover {
            background: #B91C1C;
            transform: translateY(-1px);
            color: #fff;
        }

    /* ══ ANIMATIONS ══ */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    /* ══ RESPONSIVE ══ */
    @@media (max-width:1024px) {
        .stats-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .actions-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media (max-width:768px) {
        .page-header {
            padding: 26px 22px;
        }

        .activity-grid {
            grid-template-columns: 1fr;
        }

        .data-table th:nth-child(2), .data-table td:nth-child(2) {
            display: none;
        }
    }

    @@media (max-width:540px) {
        .stats-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .actions-grid {
            grid-template-columns: 1fr 1fr;
        }

        .adm-wrap {
            padding: 16px 14px 40px;
            gap: 14px;
        }
    }
</style>

<div class="adm-wrap">

    <!-- ══ PAGE HEADER ══ -->
    <div class="page-header">
        <div class="header-grid"></div>
        <div class="header-inner">
            <div>
                <div class="header-eyebrow"><span class="pill-dot"></span> Platform Management</div>
                <div class="header-title">Admin <span class="grad">Dashboard</span></div>
                <div class="header-date"></div>
            </div>
            <button class="btn-refresh" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- ══ STATS ══ -->
    <div class="stats-grid">
        <a href="@Url.Action("Users")" class="stat-card">
            <div class="stat-stripe ss-blue"></div>
            <div class="stat-body">
                <div class="stat-top">
                    <div><div class="stat-value">@Model.TotalUsers</div><div class="stat-label">Total Users</div></div>
                    <div class="stat-icon si-blue"><i class="bi bi-people-fill"></i></div>
                </div>
                <div class="stat-meta">
                    <div class="stat-meta-item smi-green"><i class="bi bi-check-circle-fill"></i> @Model.ActiveUsers Active</div>
                    <div class="stat-meta-item smi-red"><i class="bi bi-x-circle-fill"></i> @Model.SuspendedUsers Suspended</div>
                </div>
            </div>
        </a>
        <a href="@Url.Action("PendingTeams")" class="stat-card">
            <div class="stat-stripe ss-amber"></div>
            <div class="stat-body">
                <div class="stat-top">
                    <div><div class="stat-value">@Model.TotalVerifications</div><div class="stat-label">Pending Verifications</div></div>
                    <div class="stat-icon si-amber"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <div class="stat-meta">
                    <div class="stat-meta-item smi-muted"><i class="bi bi-people"></i> @Model.PendingTeams Teams</div>
                    <div class="stat-meta-item smi-muted"><i class="bi bi-building"></i> @Model.PendingCompanies Companies</div>
                </div>
            </div>
        </a>
        <a href="@Url.Action("Projects")" class="stat-card">
            <div class="stat-stripe ss-green"></div>
            <div class="stat-body">
                <div class="stat-top">
                    <div><div class="stat-value">@Model.ActiveProjects</div><div class="stat-label">Active Projects</div></div>
                    <div class="stat-icon si-green"><i class="bi bi-briefcase-fill"></i></div>
                </div>
                <div class="stat-meta">
                    <div class="stat-meta-item smi-green"><i class="bi bi-check-circle"></i> @Model.CompletedProjects Completed</div>
                    @if (Model.StuckProjects > 0)
                    {
                        <div class="stat-meta-item smi-red"><i class="bi bi-exclamation-triangle"></i> @Model.StuckProjects Stuck</div>
                    }
                </div>
            </div>
        </a>
        <a href="@Url.Action("FinancialOverview")" class="stat-card">
            <div class="stat-stripe ss-purple"></div>
            <div class="stat-body">
                <div class="stat-top">
                    <div><div class="stat-value" style="font-size:1.6rem">$@Model.PlatformEarnings.ToString("N0")</div><div class="stat-label">Platform Earnings</div></div>
                    <div class="stat-icon si-purple"><i class="bi bi-currency-dollar"></i></div>
                </div>
                <div class="stat-meta">
                    <div class="stat-meta-item smi-green"><i class="bi bi-arrow-up"></i> $@Model.MonthlyRevenue.ToString("N0") this month</div>
                </div>
            </div>
        </a>
    </div>

    <!-- ══ QUICK ACTIONS ══ -->
    <div>
        <div class="sec-head">
            <h2 class="sec-title"><i class="bi bi-lightning-charge-fill"></i> Quick Actions</h2>
        </div>
        <div class="actions-grid">
            <a href="@Url.Action("PendingTeams")" class="action-card">
                <div class="action-icon ai-blue"><i class="bi bi-people-fill"></i></div>
                <div class="action-label">Review Teams</div>
                @if (Model.PendingTeams > 0)
                {
                    <span class="action-badge ab-amber"><i class="bi bi-clock"></i> @Model.PendingTeams Pending</span>
                }
                else
                {

                    <span class="action-badge ab-muted">All caught up</span>
                }
            </a>
            <a href="@Url.Action("PendingCompanies")" class="action-card">
                <div class="action-icon ai-green"><i class="bi bi-building"></i></div>
                <div class="action-label">Review Companies</div>
                @if (Model.PendingCompanies > 0)
                {
                    <span class="action-badge ab-amber"><i class="bi bi-clock"></i> @Model.PendingCompanies Pending</span>
                }
                else
                {

                    <span class="action-badge ab-muted">All caught up</span>
                }
            </a>
            <a href="@Url.Action("Users")" class="action-card">
                <div class="action-icon ai-purple"><i class="bi bi-person-gear"></i></div>
                <div class="action-label">Manage Users</div>
                <span class="action-badge ab-muted">@Model.TotalUsers Total</span>
            </a>
            <a href="@Url.Action("FinancialOverview")" class="action-card">
                <div class="action-icon ai-amber"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="action-label">View Finances</div>
                <span class="action-badge ab-muted">$@Model.PlatformEarnings.ToString("N0")</span>
            </a>
        </div>
    </div>

    <!-- ══ PENDING LISTS ══ -->
    @if (Model.RecentPendingTeams.Any() || Model.RecentPendingCompanies.Any())
    {
        <div class="activity-grid">
            @if (Model.RecentPendingTeams.Any())
            {
                <div class="list-card">
                    <div class="list-card-head">
                        <h2 class="sec-title" style="margin:0"><i class="bi bi-people"></i> Pending Teams</h2>
                        <span class="lch-count amber">@Model.PendingTeams</span>
                    </div>
                    @foreach (var t in Model.RecentPendingTeams)
                    {
                        <div class="list-item">
                            <div class="item-left">
                                <div class="item-av amber">@t.Name.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <div class="item-name">@t.Name</div>
                                    <div class="item-email"><i class="bi bi-envelope"></i> @t.Email</div>
                                </div>
                            </div>
                            <div class="item-right">
                                <span class="wait-badge">@t.DaysWaiting days</span>
                                <a href="@Url.Action("PendingTeams")" class="btn-review"><i class="bi bi-eye"></i> Review</a>
                            </div>
                        </div>
                    }
                    <div class="list-card-foot">
                        <a href="@Url.Action("PendingTeams")" class="btn-view-all bva-amber">View All Teams <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            }
            @if (Model.RecentPendingCompanies.Any())
            {
                <div class="list-card">
                    <div class="list-card-head">
                        <h2 class="sec-title" style="margin:0"><i class="bi bi-building"></i> Pending Companies</h2>
                        <span class="lch-count">@Model.PendingCompanies</span>
                    </div>
                    @foreach (var c in Model.RecentPendingCompanies)
                    {
                        <div class="list-item">
                            <div class="item-left">
                                <div class="item-av">@c.Name.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <div class="item-name">@c.Name</div>
                                    <div class="item-email"><i class="bi bi-envelope"></i> @c.Email</div>
                                </div>
                            </div>
                            <div class="item-right">
                                <span class="wait-badge">@c.DaysWaiting days</span>
                                <a href="@Url.Action("PendingCompanies")" class="btn-review"><i class="bi bi-eye"></i> Review</a>
                            </div>
                        </div>
                    }
                    <div class="list-card-foot">
                        <a href="@Url.Action("PendingCompanies")" class="btn-view-all bva-purple">View All Companies <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ══ STUCK PROJECTS ══ -->
    @if (Model.RecentStuckProjects.Any())
    {
        <div class="table-card">
            <div class="table-card-head">
                <h2 class="alert-title"><i class="bi bi-exclamation-triangle-fill"></i> Projects Requiring Attention</h2>
                <span class="lch-count" style="background:var(--red-bg);color:var(--red-text)">@Model.StuckProjects</span>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Client</th>
                        <th>Days Stuck</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentStuckProjects)
                    {
                        <tr>
                            <td><span class="td-name">@p.ProjectName</span></td>
                            <td>@p.ClientName</td>
                            <td><span class="days-badge">@p.DaysStuck days</span></td>
                            <td><span class="status-chip">@p.Status</span></td>
                            <td><a href="@Url.Action("StuckProjects")" class="btn-investigate"><i class="bi bi-tools"></i> Investigate</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-foot">
                <a href="@Url.Action("StuckProjects")" class="btn-danger-full">
                    <i class="bi bi-exclamation-triangle"></i> View All Stuck Projects
                </a>
            </div>
        </div>
    }

</div>
