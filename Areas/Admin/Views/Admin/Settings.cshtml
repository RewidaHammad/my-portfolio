

@model ScalaVerse.ViewModel.Admin_VM.PlatformSettingsViewModel
@{
    ViewData["Title"] = "Platform Settings";
}

<style>
    :root {
        --navy: #0A0E1A;
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-5: #EDE9FE;
        --white: #FFFFFF;
        --off: #F9FAFB;
        --border: #E5E7EB;
        --text: #0F172A;
        --text-2: #374151;
        --muted: #6B7280;
        --blue: #2563EB;
        --blue-bg: #EFF6FF;
        --amber: #D97706;
        --amber-bg: #FFFBEB;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --radius: 14px;
        --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 4px 12px rgba(0,0,0,0.04);
    }

    .page-wrap {
        max-width: 760px;
        margin: 0 auto;
    }

    /* Header */
    .page-head {
        margin-bottom: 20px;
        animation: fadeUp 0.4s var(--ease) both;
    }

    .page-eyebrow {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--purple);
        margin-bottom: 4px;
    }

    .page-title {
        font-family: var(--f-display);
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
    }

    /* Info banner */
    .info-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--blue-bg);
        border: 1px solid rgba(37,99,235,0.2);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 22px;
        font-size: 0.82rem;
        color: var(--text-2);
        animation: fadeUp 0.4s var(--ease) 0.05s both;
    }

        .info-banner i {
            color: var(--blue);
            font-size: 16px;
        }

        .info-banner strong {
            color: var(--text);
        }

    /* Section cards */
    .settings-section {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 16px;
        animation: fadeUp 0.5s var(--ease) both;
    }

        .settings-section:nth-of-type(1) {
            animation-delay: 0.1s;
        }

        .settings-section:nth-of-type(2) {
            animation-delay: 0.15s;
        }

    .section-head {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
    }

        .section-head.financial {
            background: linear-gradient(135deg, rgba(124,58,237,0.06), rgba(124,58,237,0.02));
        }

        .section-head.projects {
            background: linear-gradient(135deg, rgba(217,119,6,0.06), rgba(217,119,6,0.02));
        }

    .section-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .section-icon.financial {
            background: var(--purple-5);
            color: var(--purple);
        }

        .section-icon.projects {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .section-icon i {
            font-size: 15px;
        }

    .section-title {
        font-family: var(--f-display);
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--text);
    }

    .section-body {
        padding: 22px;
    }

    /* Fields */
    .field {
        margin-bottom: 20px;
    }

        .field:last-child {
            margin-bottom: 0;
        }

    .field-label {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-2);
        margin-bottom: 8px;
    }

        .field-label i {
            color: var(--purple);
            font-size: 14px;
        }

    .input-group {
        display: flex;
        align-items: stretch;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.18s;
        background: var(--off);
    }

        .input-group:focus-within {
            border-color: var(--purple);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(124,58,237,0.1);
        }

    .input-current {
        display: flex;
        align-items: center;
        padding: 0 14px;
        background: var(--off);
        border-right: 1px solid var(--border);
        font-size: 0.78rem;
        color: var(--muted);
        white-space: nowrap;
        flex-shrink: 0;
    }

        .input-current strong {
            color: var(--purple);
            font-weight: 700;
            margin-left: 4px;
        }

    .input-affix {
        display: flex;
        align-items: center;
        padding: 0 14px;
        background: var(--off);
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .field-input {
        flex: 1;
        min-width: 0;
        padding: 11px 14px;
        border: none;
        background: transparent;
        font-family: var(--f-body);
        font-size: 0.9rem;
        color: var(--text);
        outline: none;
    }

    .field-hint {
        font-size: 0.74rem;
        color: var(--muted);
        margin-top: 6px;
    }

    .field-error {
        font-size: 0.74rem;
        color: #DC2626;
        margin-top: 4px;
        display: block;
    }

    /* Actions */
    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 4px;
        animation: fadeUp 0.5s var(--ease) 0.2s both;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--f-body);
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text-2);
        background: var(--white);
        border: 1.5px solid var(--border);
        padding: 12px 22px;
        border-radius: 11px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            border-color: var(--purple);
            color: var(--purple);
            background: var(--purple-5);
        }

    .btn-save {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-family: var(--f-body);
        font-size: 0.9rem;
        font-weight: 700;
        color: #fff;
        background: var(--navy);
        border: none;
        padding: 12px 22px;
        border-radius: 11px;
        cursor: pointer;
        transition: all 0.25s var(--ease);
        position: relative;
        overflow: hidden;
    }

        .btn-save::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, var(--purple), var(--purple-2));
            opacity: 0;
            transition: opacity 0.25s;
        }

        .btn-save:hover::before {
            opacity: 1;
        }

        .btn-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(124,58,237,0.35);
        }

        .btn-save span {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 7px;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {
        .section-body {
            padding: 18px;
        }

        .form-actions {
            flex-direction: column;
        }

        .input-current {
            display: none;
        }
    }
</style>

<div class="page-wrap">

    <!-- Header -->
    <div class="page-head">
        <div class="page-eyebrow">Admin Panel</div>
        <div class="page-title">Platform Settings</div>
    </div>

    <!-- Info Banner -->
    <div class="info-banner">
        <i class="bi bi-info-circle-fill"></i>
        Last updated by <strong>@Model.UpdatedByAdmin</strong> on @Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
    </div>

    <form method="post" asp-action="Settings">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SettingsId" />

        <!-- Financial Settings -->
        <div class="settings-section">
            <div class="section-head financial">
                <div class="section-icon financial"><i class="bi bi-cash-coin"></i></div>
                <div class="section-title">Financial Settings</div>
            </div>
            <div class="section-body">

                <div class="field">
                    <label for="CommissionPercentage" class="field-label"><i class="bi bi-percent"></i> Commission Percentage</label>
                    <div class="input-group">
                        <span class="input-current">Current: <strong>@Model.CommissionPercentage%</strong></span>
                        <input type="number" asp-for="CommissionPercentage" class="field-input" step="0.01" required />
                        <span class="input-affix">%</span>
                    </div>
                    <div class="field-hint">Percentage of each project that the platform earns</div>
                    <span asp-validation-for="CommissionPercentage" class="field-error"></span>
                </div>

                <div class="field">
                    <label for="MinProjectBudget" class="field-label"><i class="bi bi-cash"></i> Minimum Project Budget</label>
                    <div class="input-group">
                        <span class="input-current">Current: <strong>$@Model.MinProjectBudget.ToString("N0")</strong></span>
                        <span class="input-affix">$</span>
                        <input type="number" asp-for="MinProjectBudget" class="field-input" step="0.01" required />
                    </div>
                    <div class="field-hint">Minimum allowed budget for any project</div>
                    <span asp-validation-for="MinProjectBudget" class="field-error"></span>
                </div>

                <div class="field">
                    <label for="MaxProjectBudget" class="field-label"><i class="bi bi-cash-stack"></i> Maximum Project Budget</label>
                    <div class="input-group">
                        <span class="input-current">Current: <strong>$@Model.MaxProjectBudget.ToString("N0")</strong></span>
                        <span class="input-affix">$</span>
                        <input type="number" asp-for="MaxProjectBudget" class="field-input" step="0.01" required />
                    </div>
                    <div class="field-hint">Maximum allowed budget for any project</div>
                    <span asp-validation-for="MaxProjectBudget" class="field-error"></span>
                </div>

            </div>
        </div>

        <!-- Project Management Settings -->
        <div class="settings-section">
            <div class="section-head projects">
                <div class="section-icon projects"><i class="bi bi-kanban-fill"></i></div>
                <div class="section-title">Project Management Settings</div>
            </div>
            <div class="section-body">

                <div class="field">
                    <label for="ProjectStuckDays" class="field-label"><i class="bi bi-calendar-x-fill"></i> Project Stuck Detection</label>
                    <div class="input-group">
                        <span class="input-current">Current: <strong>@Model.ProjectStuckDays days</strong></span>
                        <input type="number" asp-for="ProjectStuckDays" class="field-input" required />
                        <span class="input-affix">days</span>
                    </div>
                    <div class="field-hint">Number of days without activity before a project is flagged as "stuck"</div>
                    <span asp-validation-for="ProjectStuckDays" class="field-error"></span>
                </div>

                <div class="field">
                    <label for="ReapplicationWaitDays" class="field-label"><i class="bi bi-clock-history"></i> Reapplication Wait Period</label>
                    <div class="input-group">
                        <input type="number" asp-for="ReapplicationWaitDays" class="field-input" required />
                        <span class="input-affix">days</span>
                    </div>
                    <div class="field-hint">How many days rejected teams/companies must wait before reapplying</div>
                    <span asp-validation-for="ReapplicationWaitDays" class="field-error"></span>
                </div>

            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <a href="@Url.Action("Index")" class="btn-cancel">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
            <button type="submit" class="btn-save">
                <span><i class="bi bi-check-lg"></i> Save Settings</span>
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
