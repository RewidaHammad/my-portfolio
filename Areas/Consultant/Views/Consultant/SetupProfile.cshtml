@using ScalaVerse.ViewModel.Consultant_VM
@model ConsultantSetupViewModel
@{
    ViewData["Title"] = "Setup Your Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap');

    :root {
        --purple: #7C3AED;
        --purple-2: #6D28D9;
        --purple-3: #8B5CF6;
        --purple-soft: rgba(124,58,237,0.08);
        --purple-glow: rgba(124,58,237,0.18);
        --purple-ring: rgba(124,58,237,0.12);
        --white: #FFFFFF;
        --off: #F8F9FC;
        --border: rgba(0,0,0,0.07);
        --border-2: rgba(0,0,0,0.11);
        --text: #0D1117;
        --text-2: #374151;
        --muted: #6B7280;
        --red: #DC2626;
        --red-bg: #FFF5F5;
        --red-bdr: #FECACA;
        --f-display: 'Plus Jakarta Sans', sans-serif;
        --f-body: 'Inter', sans-serif;
        --ease: cubic-bezier(0.22,1,0.36,1);
        --shadow-xs: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md: 0 8px 28px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04);
        --shadow-btn: 0 4px 16px rgba(124,58,237,0.28);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--off);
        font-family: var(--f-body);
        -webkit-font-smoothing: antialiased;
        color: var(--text);
    }

    /* ── WRAPPER ── */
    .setup-wrapper {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.75rem 1.5rem 5rem;
    }

    /* ── HERO ── */
    .setup-hero {
        text-align: center;
        margin-bottom: 2.75rem;
        animation: fadeUp 0.45s var(--ease) both;
    }

    .hero-icon {
        width: 60px;
        height: 60px;
        background: var(--purple);
        color: #fff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
        box-shadow: var(--shadow-btn);
    }

    .setup-hero h1 {
        font-family: var(--f-display);
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
        color: var(--text);
        margin-bottom: 0.45rem;
        letter-spacing: -0.025em;
    }

    .setup-hero p {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* ── FORM CARD ── */
    .form-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 2rem;
        margin-bottom: 1.25rem;
        box-shadow: var(--shadow-xs);
        position: relative;
        overflow: hidden;
        animation: fadeUp 0.45s var(--ease) both;
        transition: box-shadow 0.25s var(--ease);
    }

        .form-card:hover {
            box-shadow: var(--shadow-md);
        }

        /* left accent stripe */
        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(to bottom, var(--purple), var(--purple-3));
            border-radius: 0;
        }

        .form-card:nth-child(1) {
            animation-delay: 0.04s;
        }

        .form-card:nth-child(2) {
            animation-delay: 0.10s;
        }

        .form-card:nth-child(3) {
            animation-delay: 0.16s;
        }

        .form-card:nth-child(4) {
            animation-delay: 0.22s;
        }

        .form-card:nth-child(5) {
            animation-delay: 0.28s;
        }

    /* ── CARD HEADER ── */
    .card-label {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
    }

    .step-num {
        font-family: var(--f-display);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        color: var(--purple);
        background: var(--purple-soft);
        border: 1px solid var(--purple-ring);
        padding: 0.28rem 0.65rem;
        border-radius: 8px;
        white-space: nowrap;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .card-label h3 {
        font-family: var(--f-display);
        font-size: 1rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 0.2rem;
        letter-spacing: -0.01em;
    }

    .card-label p {
        font-size: 0.84rem;
        color: var(--muted);
        line-height: 1.5;
    }

    /* ── PHOTO UPLOAD ── */
    .photo-upload-area {
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .photo-preview {
        width: 96px;
        height: 96px;
        border-radius: 20px;
        border: 2px dashed var(--border-2);
        background: var(--off);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        transition: border-color 0.2s, box-shadow 0.2s;
        position: relative;
    }

        .photo-preview.has-image {
            border-style: solid;
            border-color: var(--purple);
            box-shadow: 0 0 0 3px var(--purple-ring);
        }

            /* purple gradient ring like profile page */
            .photo-preview.has-image::after {
                content: '';
                position: absolute;
                inset: -3px;
                border-radius: 22px;
                background: linear-gradient(145deg, var(--purple), var(--purple-3));
                z-index: -1;
                opacity: 0.7;
            }

        .photo-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 18px;
            display: block;
        }

    .photo-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        color: var(--muted);
        font-size: 0.72rem;
        font-weight: 500;
    }

    .photo-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .btn-upload {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.58rem 1.15rem;
        border: 1.5px solid var(--border-2);
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        font-family: var(--f-body);
        color: var(--text-2);
        background: var(--off);
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, color 0.2s;
    }

        .btn-upload:hover {
            border-color: var(--purple);
            background: var(--purple-soft);
            color: var(--purple);
        }

    .btn-remove {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.58rem 1rem;
        border: 1.5px solid var(--red-bdr);
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        font-family: var(--f-body);
        color: var(--red);
        background: var(--red-bg);
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-remove:hover {
            background: #FEE2E2;
        }

    .photo-hint {
        font-size: 0.76rem;
        color: var(--muted);
        width: 100%;
    }

    /* ── FIELDS ── */
    .fields-grid {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

        .fields-grid + .fields-grid {
            margin-top: 1.2rem;
        }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

        .field-group label {
            font-size: 0.83rem;
            font-weight: 600;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 0.4rem;
            letter-spacing: 0.01em;
        }

    .link-icon {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
    }

        .link-icon.li {
            color: #0077B5;
        }

        .link-icon.gh {
            color: #333;
        }

        .link-icon.po {
            color: var(--purple);
        }

        .link-icon.ce {
            color: var(--purple);
        }

    .field-input {
        width: 100%;
        padding: 0.68rem 0.95rem;
        border: 1.5px solid var(--border-2);
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: var(--f-body);
        background: var(--off);
        color: var(--text);
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

        .field-input::placeholder {
            color: var(--muted);
        }

        .field-input:focus {
            outline: none;
            border-color: var(--purple);
            background: var(--white);
            box-shadow: 0 0 0 3px var(--purple-ring);
        }

    .field-textarea {
        resize: vertical;
        min-height: 110px;
        line-height: 1.65;
    }

    .input-prefix-wrap {
        position: relative;
    }

    .input-prefix {
        position: absolute;
        left: 0.95rem;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 700;
        color: var(--muted);
        font-size: 0.92rem;
        pointer-events: none;
    }

    .has-prefix {
        padding-left: 1.9rem;
    }

    .field-hint {
        font-size: 0.76rem;
        color: var(--muted);
    }

    .field-error {
        font-size: 0.78rem;
        color: var(--red);
        font-weight: 500;
    }

    /* ── SUBMIT ROW ── */
    .submit-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.5rem;
        animation: fadeUp 0.45s 0.32s var(--ease) both;
    }

    .submit-note {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        font-size: 0.81rem;
        color: var(--muted);
        max-width: 360px;
        line-height: 1.5;
    }

        .submit-note svg {
            flex-shrink: 0;
            margin-top: 1px;
        }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--purple);
        color: #fff;
        border: none;
        padding: 0.85rem 1.85rem;
        border-radius: 12px;
        font-family: var(--f-display);
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: 0.01em;
        transition: background 0.2s var(--ease), transform 0.2s var(--ease), box-shadow 0.2s;
        box-shadow: var(--shadow-btn);
    }

        .btn-submit:hover {
            background: var(--purple-2);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(124,58,237,0.38);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

    /* ── ANIMATION ── */
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 600px) {
        .two-col {
            grid-template-columns: 1fr;
        }

        .submit-row {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-submit {
            justify-content: center;
        }

        .form-card {
            padding: 1.5rem 1.25rem;
        }
    }
</style>

<div class="setup-wrapper">

    <!-- Hero -->
    <div class="setup-hero">
        <div class="hero-icon">
            <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
        </div>
        <h1>Build Your Consultant Profile</h1>
        <p>Let the world know who you are, what you do, and how you can help.</p>
    </div>

    <form asp-action="SetupProfile" method="post" class="setup-form" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- 00 · Profile Photo -->
        <div class="form-card" id="photo-card">
            <div class="card-label">
                <span class="step-num">00</span>
                <div>
                    <h3>Profile Photo</h3>
                    <p>Upload a clear professional photo. JPG, PNG or WEBP — max 5 MB.</p>
                </div>
            </div>

            <div class="photo-upload-area">
                <div class="photo-preview" id="photoPreview">
                    <img id="previewImg" src="" alt="" style="display:none;" />
                    <div class="photo-placeholder" id="photoPlaceholder">
                        <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span>No photo</span>
                    </div>
                </div>

                <div class="photo-controls">
                    <label for="profileImageInput" class="btn-upload">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <polyline points="16,16 12,12 8,16" />
                            <line x1="12" y1="12" x2="12" y2="21" />
                            <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3" />
                        </svg>
                        Choose Photo
                    </label>
                    <input type="file" id="profileImageInput" name="ProfileImage"
                           accept=".jpg,.jpeg,.png,.webp" style="display:none;" />

                    <button type="button" class="btn-remove" id="removePhoto" style="display:none;"
                            onclick="removePhoto()">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                        Remove
                    </button>

                    <p class="photo-hint" id="photoFileName">No file selected</p>
                </div>
            </div>

            <span asp-validation-for="ProfileImage" class="field-error"></span>
        </div>

        <!-- 01 · Professional Identity -->
        <div class="form-card">
            <div class="card-label">
                <span class="step-num">01</span>
                <div>
                    <h3>Professional Identity</h3>
                    <p>Your specialty and the industry you operate in.</p>
                </div>
            </div>
            <div class="fields-grid two-col">
                <div class="field-group">
                    <label asp-for="Specialty">Specialty</label>
                    <input asp-for="Specialty" class="field-input" placeholder="e.g. Software Architecture" />
                    <span asp-validation-for="Specialty" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Industry">Industry</label>
                    <input asp-for="Industry" class="field-input" placeholder="e.g. Technology, Finance, Healthcare" />
                    <span asp-validation-for="Industry" class="field-error"></span>
                </div>
            </div>
            <div class="fields-grid" style="margin-top:1.2rem;">
                <div class="field-group">
                    <label asp-for="Bio">Bio</label>
                    <textarea asp-for="Bio" class="field-input field-textarea" rows="4"
                              placeholder="Write a compelling summary of your professional background and what makes you unique..."></textarea>
                    <span asp-validation-for="Bio" class="field-error"></span>
                </div>
            </div>
        </div>

        <!-- 02 · Experience & Rate -->
        <div class="form-card">
            <div class="card-label">
                <span class="step-num">02</span>
                <div>
                    <h3>Experience & Rate</h3>
                    <p>Your years of expertise and your hourly pricing.</p>
                </div>
            </div>
            <div class="fields-grid two-col">
                <div class="field-group">
                    <label asp-for="YearsOfExperience">Years of Experience</label>
                    <input asp-for="YearsOfExperience" type="number" class="field-input" min="0" max="60" placeholder="e.g. 8" />
                    <span asp-validation-for="YearsOfExperience" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="HourlyRate">Hourly Rate</label>
                    <div class="input-prefix-wrap">
                        <span class="input-prefix">$</span>
                        <input asp-for="HourlyRate" type="number" class="field-input has-prefix" step="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="HourlyRate" class="field-error"></span>
                </div>
            </div>
            <div class="fields-grid" style="margin-top:1.2rem;">
                <div class="field-group">
                    <label asp-for="ExpertiseAreas">Skills & Expertise Areas</label>
                    <input asp-for="ExpertiseAreas" class="field-input"
                           placeholder="e.g. C#, Azure, Docker, Microservices, REST APIs" />
                    <span class="field-hint">Separate each skill with a comma</span>
                    <span asp-validation-for="ExpertiseAreas" class="field-error"></span>
                </div>
            </div>
        </div>

        <!-- 03 · External Links -->
        <div class="form-card">
            <div class="card-label">
                <span class="step-num">03</span>
                <div>
                    <h3>External Links</h3>
                    <p>Help clients find your work across the web.</p>
                </div>
            </div>
            <div class="fields-grid two-col">
                <div class="field-group">
                    <label asp-for="LinkedInUrl">
                        <svg class="link-icon li" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7H10V9h4v1.76A6 6 0 0 1 16 8zM2 9h4v12H2z" />
                            <circle cx="4" cy="4" r="2" />
                        </svg>
                        LinkedIn Profile
                    </label>
                    <input asp-for="LinkedInUrl" class="field-input" placeholder="https://linkedin.com/in/your-name" />
                    <span asp-validation-for="LinkedInUrl" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="GitHubUrl">
                        <svg class="link-icon gh" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                        </svg>
                        GitHub
                    </label>
                    <input asp-for="GitHubUrl" class="field-input" placeholder="https://github.com/your-username" />
                    <span asp-validation-for="GitHubUrl" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="PortfolioUrl">
                        <svg class="link-icon po" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="2" y1="12" x2="22" y2="12" />
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                        Portfolio Website
                    </label>
                    <input asp-for="PortfolioUrl" class="field-input" placeholder="https://yourportfolio.com" />
                    <span asp-validation-for="PortfolioUrl" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label asp-for="CertificationsUrl">
                        <svg class="link-icon ce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <path d="M8 21h8M12 17v4" />
                        </svg>
                        Your Workspace
                    </label>
                    <input asp-for="CertificationsUrl" class="field-input" placeholder="Link to your workspace or collaboration platform" />
                    <span asp-validation-for="CertificationsUrl" class="field-error"></span>
                </div>
            </div>
        </div>

        <!-- Submit -->
        <div class="submit-row">
            <div class="submit-note">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                Your profile will be visible to all users on the platform after submission.
            </div>
            <button type="submit" class="btn-submit">
                <span>Launch My Profile</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12,5 19,12 12,19" />
                </svg>
            </button>
        </div>

    </form>
</div>

<script>
    const input       = document.getElementById('profileImageInput');
    const previewImg  = document.getElementById('previewImg');
    const placeholder = document.getElementById('photoPlaceholder');
    const preview     = document.getElementById('photoPreview');
    const removeBtn   = document.getElementById('removePhoto');
    const hint        = document.getElementById('photoFileName');

    input.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
            alert('Image must be smaller than 5 MB.');
            this.value = '';
            return;
        }

        hint.textContent = file.name;

        const reader = new FileReader();
        reader.onload = e => {
            previewImg.src = e.target.result;
            previewImg.style.display = 'block';
            placeholder.style.display = 'none';
            preview.classList.add('has-image');
            removeBtn.style.display = 'inline-flex';
        };
        reader.readAsDataURL(file);
    });

    function removePhoto() {
        input.value = '';
        previewImg.src = '';
        previewImg.style.display  = 'none';
        placeholder.style.display = 'flex';
        preview.classList.remove('has-image');
        removeBtn.style.display   = 'none';
        hint.textContent = 'No file selected';
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
